[user]
	name = volcmen
	email = volcmen@gmail.com

[init]
	defaultBranch = main

[core]
	editor = nvim
	autocrlf = input
	pager = delta
	untrackedCache = true
	fsmonitor = false

[pull]
	rebase = true

[push]
	autoSetupRemote = true
	default = simple

[merge]
	conflictStyle = zdiff3

[help]
	autocorrect = prompt

[interactive]
	diffFilter = delta --color-only

[delta]
	hyperlinks = true
	side-by-side = true
	navigate = true
	dark = true
	line-numbers = true

[url "git@gitlab.com:"]
	insteadOf = https://gitlab.com/

[url "git@github.com:"]
	insteadOf = https://github.com/

[branch]
	autoSetupRebase = always
	sort = -committerdate

[rebase]
	autoStash = true

[rerere]
	enabled = true

[fetch]
	prune = true
