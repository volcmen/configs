#!/usr/bin/env bash
set -u

PROGRAM=${0##*/}

startup_die() {
    printf '%s: %s\n' "$PROGRAM" "$*" >&2
    exit 65
}

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd -P)" || startup_die 'script directory is unavailable'
REPO_ROOT="$(cd "$SCRIPT_DIR/.." 2>/dev/null && pwd -P)" || startup_die 'repository root is unavailable'
SOURCE_ROOT="$(cd "$REPO_ROOT/home" 2>/dev/null && pwd -P)" || startup_die 'canonical source root is unavailable'
MANIFEST="$REPO_ROOT/dotfiles.manifest"

MF_APP=(); MF_PLATFORMS=(); MF_KIND=(); MF_PATH=()
MF_VALIDATOR=(); MF_REQUIRED=(); MF_TESTED=()
PLAN_ACTION=(); PLAN_APP=(); PLAN_PATH=(); PLAN_SOURCE=(); PLAN_TARGET=()
PLAN_NEEDS_BACKUP=0

STATE_ROOT=''; STATE_ROOT_PHYSICAL=''; STATE_ROOT_IDENTITY=''; TRANSACTION_START_DIR=''
LOCK_PATH='install.lock'; LOCK_HELD=0
TRANSACTION_ROOT=''; QUARANTINE_ROOT=''; BACKUP_ROOT=''; BACKUP_FILES=''; REPORT_PATH=''
JOURNAL_TYPE=(); JOURNAL_RELATIVE=(); JOURNAL_FIRST=(); JOURNAL_SECOND=(); JOURNAL_IDENTITY=(); JOURNAL_AUX=()
JOURNAL_COUNT=0; MUTATION_COUNT=0; TEST_FAIL_AFTER=''
TRANSACTION_ACTIVE=0; CLEANUP_ACTIVE=0; PENDING_SIGNAL=0

usage() {
    cat <<'USAGE'
Usage: dotfiles <command> [options]

Commands:
  detect                  print the physical host platform
  check [--target NAME]   validate canonical configuration
  diff [--target NAME] [--staging-home DIR]
                          compare canonical and live state
  install [--apply] [--backup]
                          preview or apply the installation plan
  help                    show this help
USAGE
}

die() {
    local status=$1
    shift
    printf '%s: %s\n' "$PROGRAM" "$*" >&2
    exit "$status"
}

manifest_error() { die 65 "manifest line $1: $2"; }

valid_platforms() {
    case "$1" in macos|arch|macos,arch|arch,macos) return 0 ;; *) return 1 ;; esac
}

valid_validator() {
    case "$1" in
        plain|shell|fish|fontconfig|git|hyprconf|hyprland-lua|ini|jsonc|kitty|lua|mako|mpv|python|starship|toml|uwsm-shell|xml|zellij|css) return 0 ;;
        *) return 1 ;;
    esac
}

safe_relative_path() {
    [[ -n "$1" && "$1" != /* && "$1" != *'|'* ]] || return 1
    case "/$1/" in *'/../'*|*'/./'*|*'//'*) return 1 ;; esac
    return 0
}

parse_manifest() {
    local file=$1 line line_no=0 app platforms kind path validator required tested extra separators i
    MF_APP=(); MF_PLATFORMS=(); MF_KIND=(); MF_PATH=()
    MF_VALIDATOR=(); MF_REQUIRED=(); MF_TESTED=()
    [[ -r "$file" ]] || die 65 "manifest is not readable: $file"
    while IFS= read -r line || [[ -n "$line" ]]; do
        line_no=$((line_no + 1))
        [[ -z "$line" || "$line" == \#* ]] && continue
        separators=${line//[!|]/}
        [[ "$separators" == '||||||' ]] || manifest_error "$line_no" 'expected seven fields'
        IFS='|' read -r app platforms kind path validator required tested extra <<<"$line"
        [[ -n "$app" && "$app" =~ ^[a-z0-9][a-z0-9-]*$ ]] || manifest_error "$line_no" 'invalid app'
        valid_platforms "$platforms" || manifest_error "$line_no" 'invalid platforms'
        [[ "$kind" == file ]] || manifest_error "$line_no" 'schema v1 kind must be file'
        safe_relative_path "$path" || manifest_error "$line_no" 'unsafe path'
        valid_validator "$validator" || manifest_error "$line_no" 'unknown validator'
        [[ "$required" == yes || "$required" == no ]] || manifest_error "$line_no" 'required must be yes or no'
        [[ -n "$tested" ]] || manifest_error "$line_no" 'tested_version is empty'
        for ((i=0; i<${#MF_PATH[@]}; i++)); do
            [[ "${MF_PATH[$i]}" != "$path" ]] || manifest_error "$line_no" "duplicate path: $path"
        done
        i=${#MF_APP[@]}
        MF_APP[$i]=$app; MF_PLATFORMS[$i]=$platforms; MF_KIND[$i]=$kind
        MF_PATH[$i]=$path; MF_VALIDATOR[$i]=$validator
        MF_REQUIRED[$i]=$required; MF_TESTED[$i]=$tested
    done <"$file"
}

platform_selected() {
    case ",$1," in *,"$2",*) return 0 ;; *) return 1 ;; esac
}

test_value() {
    [[ ${DOTFILES_TESTING:-0} == 1 ]] || return 1
    case "$1" in
        DOTFILES_TEST_UNAME) printf '%s' "${DOTFILES_TEST_UNAME:-}" ;;
        DOTFILES_TEST_OS_RELEASE) printf '%s' "${DOTFILES_TEST_OS_RELEASE:-}" ;;
        *) return 1 ;;
    esac
}

install_test_hook() {
    [[ ${DOTFILES_TESTING:-0} == 1 && -n ${DOTFILES_TEST_INSTALL_HOOK:-} ]] || return 0
    [[ -x "$DOTFILES_TEST_INSTALL_HOOK" ]] || return 1
    "$DOTFILES_TEST_INSTALL_HOOK" "$@"
}

kernel_name() {
    local value
    value=$(test_value DOTFILES_TEST_UNAME) || true
    if [[ -n "$value" ]]; then printf '%s\n' "$value"; else uname -s; fi
}

os_release_path() {
    local value
    value=$(test_value DOTFILES_TEST_OS_RELEASE) || true
    if [[ -n "$value" ]]; then printf '%s\n' "$value"; else printf '/etc/os-release\n'; fi
}

os_release_id() {
    local file key value
    file=$(os_release_path)
    [[ -r "$file" ]] || return 1
    while IFS='=' read -r key value; do
        [[ "$key" == ID ]] || continue
        value=${value#\"}; value=${value%\"}
        value=${value#\'}; value=${value%\'}
        printf '%s\n' "$value"
        return 0
    done <"$file"
    return 1
}

detect_host() {
    local kernel id
    kernel=$(kernel_name)
    case "$kernel" in
        Darwin) HOST_PLATFORM=macos ;;
        Linux)
            id=$(os_release_id) || die 69 'unsupported host: Linux without readable ID'
            [[ "$id" == arch ]] || die 69 "unsupported host: Linux ID=$id"
            HOST_PLATFORM=arch
            ;;
        *) die 69 "unsupported host kernel: $kernel" ;;
    esac
    printf '%s\n' "$HOST_PLATFORM"
}

effective_home() {
    if [[ ${DOTFILES_TESTING:-0} == 1 && -n ${DOTFILES_TEST_HOME:-} ]]; then
        printf '%s\n' "$DOTFILES_TEST_HOME"
    elif [[ -n ${HOME:-} ]]; then
        printf '%s\n' "$HOME"
    else
        die 65 'HOME is not set'
    fi
}

validation_target() {
    local requested=${DOTFILES_TARGET:-} option_seen=0
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --target)
                [[ $# -ge 2 && -n "$2" ]] || die 64 '--target requires a platform'
                [[ $option_seen -eq 0 ]] || die 64 '--target may only be specified once'
                requested=$2
                option_seen=1
                shift 2
                ;;
            *) die 64 "unknown option: $1" ;;
        esac
    done
    if [[ -z "$requested" ]]; then
        detect_host >/dev/null
        requested=$HOST_PLATFORM
    fi
    case "$requested" in macos|arch) ;; *) die 64 "unknown target platform: $requested" ;; esac
    VALIDATION_TARGET=$requested
}

physical_dir() {
    (cd "$1" 2>/dev/null && pwd -P)
}

path_within() {
    local path=$1 root=$2
    if [[ "$root" == / ]]; then
        [[ "$path" == /* ]]
    else
        [[ "$path" == "$root" || "$path" == "$root"/* ]]
    fi
}

safe_source() {
    local source=$1 parent
    [[ -f "$source" && ! -L "$source" ]] || return 1
    parent=$(physical_dir "$(dirname "$source")") || return 1
    path_within "$parent" "$SOURCE_ROOT"
}

safe_target() {
    local target=$1 current physical component i
    local components=()
    [[ -n ${EFFECTIVE_HOME:-} && -n ${TARGET_RELATIVE_PATH:-} ]] || return 1
    current=$EFFECTIVE_HOME
    [[ ! -L "$current" ]] || return 1
    if [[ -e "$current" || -L "$current" ]]; then
        [[ -d "$current" ]] || return 1
        TARGET_ROOT_PHYSICAL=$(physical_dir "$current") || return 1
    else
        return 0
    fi
    IFS=/ read -r -a components <<<"$TARGET_RELATIVE_PATH"
    for ((i=0; i<${#components[@]}-1; i++)); do
        component=${components[$i]}
        current="$current/$component"
        [[ -L "$current" ]] && return 1
        if [[ -e "$current" && ! -d "$current" ]]; then
            return 1
        fi
        if [[ -d "$current" ]]; then
            physical=$(physical_dir "$current") || return 1
            path_within "$physical" "$TARGET_ROOT_PHYSICAL" || return 1
        fi
    done
    [[ "$target" == "$current" || "$target" == "$current"/* || "$target" == "$EFFECTIVE_HOME/$TARGET_RELATIVE_PATH" ]] || return 1
}

artifact_status() {
    local source=$1 target=$2 link
    safe_source "$source" && safe_target "$target" || { printf 'BLOCKED\n'; return; }
    if [[ -L "$target" ]]; then
        link=$(readlink "$target")
        [[ "$link" == "$source" ]] && printf 'LINKED\n' || printf 'FOREIGN_LINK\n'
    elif [[ -d "$target" ]]; then
        printf 'TYPE_CONFLICT\n'
    elif [[ -f "$target" ]]; then
        cmp -s "$source" "$target" && printf 'MATCH\n' || printf 'DRIFT\n'
    elif [[ -e "$target" ]]; then
        printf 'TYPE_CONFLICT\n'
    else
        printf 'MISSING\n'
    fi
}

text_artifact() {
    command -v iconv >/dev/null 2>&1 || return 1
    command -v od >/dev/null 2>&1 || return 1
    command -v awk >/dev/null 2>&1 || return 1
    [[ -r "$1" ]] || return 1
    iconv -f UTF-8 -t UTF-8 "$1" >/dev/null 2>&1 || return 1
    (
        set -o pipefail
        LC_ALL=C od -An -tu1 "$1" | awk '
            {
                for (i = 1; i <= NF; i++) {
                    if (($i < 32 && $i != 9 && $i != 10 && $i != 13) || $i == 127) {
                        bad = 1
                        exit
                    }
                }
            }
            END { exit bad }
        '
    )
}

command_diff() {
    local staging_home='' staging_seen=0 target_option='' target_seen=0 host target target_home live_home live_home_physical staging_physical source target_path status
    local i drift=0 blocked=0
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --target)
                [[ $# -ge 2 && -n "$2" ]] || die 64 '--target requires a platform'
                [[ $target_seen -eq 0 ]] || die 64 '--target may only be specified once'
                target_option=$2
                target_seen=1
                shift 2
                ;;
            --staging-home)
                [[ $# -ge 2 && -n "$2" ]] || die 64 '--staging-home requires a directory'
                [[ $staging_seen -eq 0 ]] || die 64 '--staging-home may only be specified once'
                staging_home=$2
                staging_seen=1
                shift 2
                ;;
            *) die 64 "unknown option: $1" ;;
        esac
    done
    if [[ -n "$target_option" ]]; then
        validation_target --target "$target_option"
    else
        validation_target
    fi
    target=$VALIDATION_TARGET
    detect_host >/dev/null
    host=$HOST_PLATFORM
    if [[ "$target" != "$host" && -z "$staging_home" ]]; then
        die 64 "target $target requires --staging-home"
    fi
    if [[ -n "$staging_home" ]]; then
        live_home=$(effective_home)
        live_home_physical=$(physical_dir "$live_home") || die 65 'live home cannot be resolved'
        staging_physical=$(physical_dir "$staging_home") || staging_physical=''
        if [[ -n "$staging_physical" && "$staging_physical" == "$live_home_physical" ]]; then
            die 64 'staging home must not resolve to live home'
        fi
        target_home=$staging_home
    else
        target_home=$(effective_home)
    fi
    [[ "$target_home" == / ]] || target_home=${target_home%/}
    [[ -n "$target_home" ]] || die 65 'effective home is empty'
    EFFECTIVE_HOME=$target_home
    parse_manifest "$MANIFEST"
    for ((i=0; i<${#MF_PATH[@]}; i++)); do
        platform_selected "${MF_PLATFORMS[$i]}" "$target" || continue
        TARGET_RELATIVE_PATH=${MF_PATH[$i]}
        source="$SOURCE_ROOT/${MF_PATH[$i]}"
        if [[ "$EFFECTIVE_HOME" == / ]]; then
            target_path="/${MF_PATH[$i]}"
        else
            target_path="$EFFECTIVE_HOME/${MF_PATH[$i]}"
        fi
        status=$(artifact_status "$source" "$target_path")
        printf '%s %s %s\n' "$status" "${MF_APP[$i]}" "${MF_PATH[$i]}"
        case "$status" in
            LINKED|MATCH) ;;
            BLOCKED) blocked=1 ;;
            *) drift=1 ;;
        esac
        if [[ "$status" == DRIFT ]] && text_artifact "$source" && text_artifact "$target_path"; then
            diff -u "$source" "$target_path" || true
        fi
    done
    [[ $blocked -eq 0 ]] || return 65
    [[ $drift -eq 0 ]] || return 1
    return 0
}

build_install_plan() {
    local allow_backup=${1:-0} host source target_path status action i
    local conflict=0 blocked=0

    detect_host >/dev/null
    host=$HOST_PLATFORM
    EFFECTIVE_HOME=$(effective_home)
    [[ "$EFFECTIVE_HOME" == / ]] || EFFECTIVE_HOME=${EFFECTIVE_HOME%/}
    [[ -n "$EFFECTIVE_HOME" ]] || die 65 'effective home is empty'
    parse_manifest "$MANIFEST"
    PLAN_ACTION=(); PLAN_APP=(); PLAN_PATH=(); PLAN_SOURCE=(); PLAN_TARGET=()
    PLAN_NEEDS_BACKUP=0

    for ((i=0; i<${#MF_PATH[@]}; i++)); do
        platform_selected "${MF_PLATFORMS[$i]}" "$host" || continue
        TARGET_RELATIVE_PATH=${MF_PATH[$i]}
        source="$SOURCE_ROOT/${MF_PATH[$i]}"
        if [[ "$EFFECTIVE_HOME" == / ]]; then
            target_path="/${MF_PATH[$i]}"
        else
            target_path="$EFFECTIVE_HOME/${MF_PATH[$i]}"
        fi
        status=$(artifact_status "$source" "$target_path")
        case "$status" in
            MISSING) action=CREATE ;;
            LINKED) action=NOOP ;;
            BLOCKED) action=BLOCKED; blocked=1 ;;
            TYPE_CONFLICT)
                if [[ "$allow_backup" == 1 ]]; then
                    action=BLOCKED
                    blocked=1
                else
                    action=CONFLICT
                    conflict=1
                fi
                ;;
            DRIFT|MATCH|FOREIGN_LINK)
                if [[ "$allow_backup" == 1 ]]; then
                    action=BACKUP
                    PLAN_NEEDS_BACKUP=1
                else
                    action=CONFLICT
                    conflict=1
                fi
                ;;
            *) action=BLOCKED; blocked=1 ;;
        esac
        PLAN_ACTION[${#PLAN_ACTION[@]}]=$action
        PLAN_APP[${#PLAN_APP[@]}]=${MF_APP[$i]}
        PLAN_PATH[${#PLAN_PATH[@]}]=${MF_PATH[$i]}
        PLAN_SOURCE[${#PLAN_SOURCE[@]}]=$source
        PLAN_TARGET[${#PLAN_TARGET[@]}]=$target_path
    done

    for ((i=0; i<${#PLAN_ACTION[@]}; i++)); do
        printf '%s %s %s\n' "${PLAN_ACTION[$i]}" "${PLAN_APP[$i]}" "${PLAN_PATH[$i]}"
    done
    if [[ $blocked -ne 0 ]]; then
        return 65
    elif [[ $conflict -ne 0 ]]; then
        return 1
    fi
}

state_root() {
    if [[ ${DOTFILES_TESTING:-0} == 1 && -n ${DOTFILES_TEST_STATE:-} ]]; then
        printf '%s\n' "$DOTFILES_TEST_STATE"
        return
    fi
    [[ -n ${HOME:-} ]] || return 65
    printf '%s/dotfiles\n' "${XDG_STATE_HOME:-$HOME/.local/state}"
}

reset_transaction_journal() {
    JOURNAL_TYPE=(); JOURNAL_RELATIVE=(); JOURNAL_FIRST=(); JOURNAL_SECOND=(); JOURNAL_IDENTITY=(); JOURNAL_AUX=()
    JOURNAL_COUNT=0
    MUTATION_COUNT=0
    PENDING_SIGNAL=0
    TEST_FAIL_AFTER=''
    if [[ ${DOTFILES_TESTING:-0} == 1 ]]; then
        TEST_FAIL_AFTER=${DOTFILES_TEST_FAIL_AFTER:-}
        case "$TEST_FAIL_AFTER" in
            '') ;;
            0|*[!0-9]*) return 64 ;;
        esac
    fi
}

path_identity() {
    local identity ignored
    IFS=' ' read -r identity ignored <<<"$(LC_ALL=C ls -di -- "$1")" || return 1
    [[ -n "$identity" ]] || return 1
    printf '%s\n' "$identity"
}

path_fingerprint() {
    local checksum link
    if [[ -L "$1" ]]; then
        link=$(readlink "$1") || return 1
        printf 'L:%s\n' "$link"
    elif [[ -f "$1" ]]; then
        checksum=$(cksum <"$1") || return 1
        printf 'F:%s\n' "$checksum"
    else
        return 1
    fi
}

pin_state_root() {
    STATE_ROOT=$(state_root) || return $?
    mkdir -p -- "$STATE_ROOT" || return 74
    [[ -d "$STATE_ROOT" && ! -L "$STATE_ROOT" ]] || return 74
    cd -P -- "$STATE_ROOT" || return 74
    STATE_ROOT_PHYSICAL=$(pwd -P) || return 74
    STATE_ROOT_IDENTITY=$(path_identity .) || return 74
}

state_name_matches_pin() {
    local identity
    [[ -d "$STATE_ROOT" && ! -L "$STATE_ROOT" ]] || return 1
    identity=$(path_identity "$STATE_ROOT") || return 1
    [[ "$identity" == "$STATE_ROOT_IDENTITY" ]]
}

state_cwd_matches_pin() {
    local identity
    identity=$(path_identity .) || return 1
    [[ "$identity" == "$STATE_ROOT_IDENTITY" ]]
}

record_transaction_signal() {
    [[ "$PENDING_SIGNAL" == 0 ]] && PENDING_SIGNAL=$1
}

honor_pending_signal() {
    [[ "$PENDING_SIGNAL" == 0 ]] && return 0
    return "$PENDING_SIGNAL"
}

acquire_lock() {
    state_cwd_matches_pin || return 74
    install_test_hook before_lock_acquire "$STATE_ROOT" || return $?
    honor_pending_signal || return $?
    state_cwd_matches_pin || return 74
    if mkdir -- "$LOCK_PATH" 2>/dev/null; then
        LOCK_HELD=1
    else
        printf '%s: another install is active: %s/install.lock\n' "$PROGRAM" "$STATE_ROOT" >&2
        return 75
    fi
    honor_pending_signal || return $?
    install_test_hook after_lock_acquire "$STATE_ROOT" "$STATE_ROOT_PHYSICAL" || return $?
    honor_pending_signal || return $?
    state_cwd_matches_pin && state_name_matches_pin || return 74
}

release_lock() {
    [[ "$LOCK_HELD" == 1 ]] || return 0
    state_cwd_matches_pin || return 74
    if rmdir -- "$LOCK_PATH"; then
        LOCK_HELD=0
        return 0
    fi
    printf '%s: failed to release install lock in pinned state root\n' "$PROGRAM" >&2
    return 74
}

begin_transaction_storage() {
    local timestamp
    state_cwd_matches_pin && state_name_matches_pin || return 74
    timestamp=$(date -u +%Y%m%dT%H%M%SZ) || return 74
    mkdir -p -- transactions || return 74
    TRANSACTION_ROOT="transactions/$timestamp-$$"
    mkdir -- "$TRANSACTION_ROOT" || return 74
    QUARANTINE_ROOT="$TRANSACTION_ROOT/quarantine"
    mkdir -- "$QUARANTINE_ROOT" || return 74
    honor_pending_signal || return $?
}

begin_backup() {
    local timestamp
    state_cwd_matches_pin && state_name_matches_pin || return 74
    timestamp=$(date -u +%Y%m%dT%H%M%SZ) || return 74
    mkdir -p -- backups || return 74
    BACKUP_ROOT="backups/$timestamp-$$"
    mkdir -- "$BACKUP_ROOT" || return 74
    BACKUP_FILES="$BACKUP_ROOT/files"
    mkdir -- "$BACKUP_FILES" || return 74
    REPORT_PATH="$BACKUP_ROOT/report.tsv"
    : >"$REPORT_PATH" || return 74
    honor_pending_signal || return $?
}

append_report() {
    [[ -n "$REPORT_PATH" ]] || return 0
    state_cwd_matches_pin || return 74
    printf '%s\t%s\t%s\t%s\n' "$1" "$2" "$3" "$4" >>"$REPORT_PATH"
}

journal_move() {
    local relative_path=$1 target_path=$2 backup_path=$3 fingerprint=$4 i=$JOURNAL_COUNT
    JOURNAL_TYPE[$i]=MOVE
    JOURNAL_RELATIVE[$i]=$relative_path
    JOURNAL_FIRST[$i]=$target_path
    JOURNAL_SECOND[$i]=$backup_path
    JOURNAL_IDENTITY[$i]=$fingerprint
    JOURNAL_AUX[$i]=''
    JOURNAL_COUNT=$((JOURNAL_COUNT + 1))
    append_report MOVE "$relative_path" "$target_path" "$STATE_ROOT_PHYSICAL/$backup_path"
}

journal_link() {
    local relative_path=$1 source=$2 target_path=$3 temp_path=$4 i=$JOURNAL_COUNT
    JOURNAL_TYPE[$i]=LINK
    JOURNAL_RELATIVE[$i]=$relative_path
    JOURNAL_FIRST[$i]=$source
    JOURNAL_SECOND[$i]=$target_path
    JOURNAL_IDENTITY[$i]=''
    JOURNAL_AUX[$i]=$temp_path
    JOURNAL_COUNT=$((JOURNAL_COUNT + 1))
    append_report LINK "$relative_path" "$source" "$target_path"
}

set_journal_link_identity() {
    JOURNAL_IDENTITY[$1]=$2
}

after_transaction_mutation() {
    MUTATION_COUNT=$((MUTATION_COUNT + 1))
    if [[ ${DOTFILES_TESTING:-0} == 1 && -n "$TEST_FAIL_AFTER" && "$MUTATION_COUNT" -eq "$TEST_FAIL_AFTER" ]]; then
        printf '%s: injected transaction failure after mutation %s\n' "$PROGRAM" "$MUTATION_COUNT" >&2
        return 70
    fi
}

prepare_install_parent() {
    local relative_path=$1 expected_root=$2 component physical parent_physical i
    local components=()

    [[ ! -L "$EFFECTIVE_HOME" && -d "$EFFECTIVE_HOME" ]] || return 1
    install_test_hook before_prepare_parent "$EFFECTIVE_HOME" || return 1
    cd -P -- "$EFFECTIVE_HOME" || return 1
    physical=$(pwd -P) || return 1
    [[ "$physical" == "$expected_root" ]] || return 1
    TARGET_ROOT_PHYSICAL=$expected_root

    IFS=/ read -r -a components <<<"$relative_path"
    for ((i=0; i<${#components[@]}-1; i++)); do
        component=${components[$i]}
        [[ ! -L "$component" ]] || return 1
        if [[ -e "$component" ]]; then
            [[ -d "$component" ]] || return 1
        else
            mkdir -- "$component" || return 1
        fi
        [[ -d "$component" && ! -L "$component" ]] || return 1
        parent_physical=$(pwd -P) || return 1
        cd -P -- "$component" || return 1
        physical=$(pwd -P) || return 1
        [[ "$physical" == "$parent_physical/$component" ]] || return 1
        path_within "$physical" "$TARGET_ROOT_PHYSICAL" || return 1
    done
}

pin_existing_install_parent() {
    local relative_path=$1 expected_root=$2 component physical parent_physical i
    local components=()

    [[ ! -L "$EFFECTIVE_HOME" && -d "$EFFECTIVE_HOME" ]] || return 1
    cd -P -- "$EFFECTIVE_HOME" || return 1
    physical=$(pwd -P) || return 1
    [[ "$physical" == "$expected_root" ]] || return 1
    TARGET_ROOT_PHYSICAL=$expected_root

    IFS=/ read -r -a components <<<"$relative_path"
    for ((i=0; i<${#components[@]}-1; i++)); do
        component=${components[$i]}
        [[ -d "$component" && ! -L "$component" ]] || return 1
        parent_physical=$(pwd -P) || return 1
        cd -P -- "$component" || return 1
        physical=$(pwd -P) || return 1
        [[ "$physical" == "$parent_physical/$component" ]] || return 1
        path_within "$physical" "$TARGET_ROOT_PHYSICAL" || return 1
    done
}

pin_apply_target_parent() {
    local source=$1 target_path=$2 relative_path=$3 prepare=$4 expected_root
    TARGET_RELATIVE_PATH=$relative_path
    safe_source "$source" || return 65
    TARGET_ROOT_PHYSICAL=''
    safe_target "$target_path" || return 65
    expected_root=$TARGET_ROOT_PHYSICAL
    [[ -n "$expected_root" ]] || return 65
    if [[ "$prepare" == 1 ]]; then
        prepare_install_parent "$relative_path" "$expected_root" || return 65
    else
        pin_existing_install_parent "$relative_path" "$expected_root" || return 65
    fi
    safe_target "$target_path" || return 65
    safe_source "$source" || return 65
}

inspect_install_entry() (
    local action=$1 source=$2 target_path=$3 relative_path=$4 observed target_name
    pin_apply_target_parent "$source" "$target_path" "$relative_path" 1 || return $?
    observed=$(artifact_status "$source" "$target_path")
    case "$action:$observed" in
        CREATE:MISSING) printf '%s\n' '-' ;;
        BACKUP:DRIFT|BACKUP:MATCH|BACKUP:FOREIGN_LINK)
            target_name=${relative_path##*/}
            path_fingerprint "$target_name" || return 65
            ;;
        *) return 65 ;;
    esac
)

backup_install_target() (
    local source=$1 target_path=$2 relative_path=$3 backup_path=$4 expected_fingerprint=$5
    local target_name observed backup_absolute
    pin_apply_target_parent "$source" "$target_path" "$relative_path" 0 || return $?
    observed=$(artifact_status "$source" "$target_path")
    case "$observed" in DRIFT|MATCH|FOREIGN_LINK) ;; *) return 65 ;; esac
    target_name=${relative_path##*/}
    [[ "$(path_fingerprint "$target_name")" == "$expected_fingerprint" ]] || return 65
    backup_absolute="$STATE_ROOT_PHYSICAL/$backup_path"
    state_name_matches_pin || return 74
    install_test_hook before_backup_move "$target_path" "$backup_absolute" || return $?
    honor_pending_signal || return $?
    state_name_matches_pin || return 74
    [[ "$(path_fingerprint "$target_name")" == "$expected_fingerprint" ]] || return 65
    mv -n -- "$target_name" "$backup_absolute" || return 74
    honor_pending_signal || return $?
    [[ ! -e "$target_name" && ! -L "$target_name" ]] || return 74
    [[ "$(path_fingerprint "$backup_absolute")" == "$expected_fingerprint" ]] || return 74
    install_test_hook after_backup_move "$target_path" "$backup_absolute" || return $?
    honor_pending_signal || return $?
)

create_link_temp() (
    local source=$1 target_path=$2 relative_path=$3 temp_path=$4 target_name temp_name
    pin_apply_target_parent "$source" "$target_path" "$relative_path" 0 || return $?
    target_name=${relative_path##*/}
    temp_name=${temp_path##*/}
    [[ ! -e "$target_name" && ! -L "$target_name" && ! -e "$temp_name" && ! -L "$temp_name" ]] || return 65
    install_test_hook before_link_temp "$target_path" "$temp_path" || return $?
    honor_pending_signal || return $?
    [[ ! -e "$target_name" && ! -L "$target_name" && ! -e "$temp_name" && ! -L "$temp_name" ]] || return 65
    safe_source "$source" || return 65
    ln -s -- "$source" "$temp_name" || return 74
    honor_pending_signal || return $?
    install_test_hook after_link_temp "$target_path" "$temp_path" || return $?
    honor_pending_signal || return $?
)

inspect_link_temp() (
    local source=$1 target_path=$2 relative_path=$3 temp_path=$4 temp_name identity
    pin_apply_target_parent "$source" "$target_path" "$relative_path" 0 || return $?
    temp_name=${temp_path##*/}
    [[ -L "$temp_name" && "$(readlink "$temp_name")" == "$source" ]] || return 65
    identity=$(path_identity "$temp_name") || return 65
    printf '%s\n' "$identity"
)

publish_link_temp() (
    local source=$1 target_path=$2 relative_path=$3 temp_path=$4 expected_identity=$5
    local target_name temp_name
    pin_apply_target_parent "$source" "$target_path" "$relative_path" 0 || return $?
    target_name=${relative_path##*/}
    temp_name=${temp_path##*/}
    [[ -L "$temp_name" && "$(readlink "$temp_name")" == "$source" ]] || return 65
    [[ "$(path_identity "$temp_name")" == "$expected_identity" ]] || return 65
    [[ ! -e "$target_name" && ! -L "$target_name" ]] || return 65
    install_test_hook before_link_publish "$target_path" "$temp_path" || return $?
    honor_pending_signal || return $?
    [[ -L "$temp_name" && "$(path_identity "$temp_name")" == "$expected_identity" ]] || return 65
    [[ ! -e "$target_name" && ! -L "$target_name" ]] || return 65
    safe_source "$source" || return 65
    ln -P -- "$temp_name" "$target_name" || return 74
    honor_pending_signal || return $?
    [[ -L "$target_name" && "$(path_identity "$target_name")" == "$expected_identity" ]] || return 74
    install_test_hook after_link_publish "$target_path" "$temp_path" || return $?
    honor_pending_signal || return $?
)

cleanup_link_temp() (
    local source=$1 target_path=$2 relative_path=$3 temp_path=$4 expected_identity=$5 quarantine_path=$6
    local temp_name quarantine_absolute
    pin_apply_target_parent "$source" "$target_path" "$relative_path" 0 || return $?
    temp_name=${temp_path##*/}
    [[ -L "$temp_name" && "$(readlink "$temp_name")" == "$source" ]] || return 2
    [[ "$(path_identity "$temp_name")" == "$expected_identity" ]] || return 2
    quarantine_absolute="$STATE_ROOT_PHYSICAL/$quarantine_path"
    state_name_matches_pin || return 74
    install_test_hook before_link_temp_quarantine "$temp_path" "$quarantine_absolute" || return $?
    honor_pending_signal || return $?
    [[ -L "$temp_name" && "$(path_identity "$temp_name")" == "$expected_identity" ]] || return 2
    mv -n -- "$temp_name" "$quarantine_absolute" || return 74
    honor_pending_signal
    [[ ! -e "$temp_name" && ! -L "$temp_name" ]] || return 74
    [[ -L "$quarantine_absolute" && "$(readlink "$quarantine_absolute")" == "$source" ]] || return 74
    install_test_hook after_link_temp_quarantine "$temp_path" "$quarantine_absolute" || return $?
    honor_pending_signal
)

apply_install_entry() {
    local action=$1 source=$2 target_path=$3 relative_path=$4
    local fingerprint backup_path='' temp_path identity journal_index temp_quarantine

    state_cwd_matches_pin && state_name_matches_pin || return 74
    fingerprint=$(inspect_install_entry "$action" "$source" "$target_path" "$relative_path") || return $?
    if [[ "$action" == BACKUP ]]; then
        backup_path="$BACKUP_FILES/$relative_path"
        mkdir -p -- "$(dirname "$backup_path")" || return 74
        [[ ! -e "$backup_path" && ! -L "$backup_path" ]] || return 74
        journal_move "$relative_path" "$target_path" "$backup_path" "$fingerprint" || return $?
        backup_install_target "$source" "$target_path" "$relative_path" "$backup_path" "$fingerprint" || return $?
        after_transaction_mutation || return $?
    fi

    journal_index=$JOURNAL_COUNT
    temp_path="${target_path%/*}/.dotfiles-link-$$-$journal_index"
    journal_link "$relative_path" "$source" "$target_path" "$temp_path" || return $?
    create_link_temp "$source" "$target_path" "$relative_path" "$temp_path" || return $?
    identity=$(inspect_link_temp "$source" "$target_path" "$relative_path" "$temp_path") || return $?
    [[ -n "$identity" ]] || return 65
    set_journal_link_identity "$journal_index" "$identity"
    publish_link_temp "$source" "$target_path" "$relative_path" "$temp_path" "$identity" || return $?
    after_transaction_mutation || return $?
    temp_quarantine="$QUARANTINE_ROOT/link-$journal_index/success-temp"
    mkdir -p -- "$(dirname "$temp_quarantine")" || return 74
    cleanup_link_temp "$source" "$target_path" "$relative_path" "$temp_path" "$identity" "$temp_quarantine" || return $?
}

pin_rollback_target_parent() {
    local target_path=$1 relative_path=$2 expected_root
    TARGET_RELATIVE_PATH=$relative_path
    TARGET_ROOT_PHYSICAL=''
    safe_target "$target_path" || return 2
    expected_root=$TARGET_ROOT_PHYSICAL
    [[ -n "$expected_root" ]] || return 2
    pin_existing_install_parent "$relative_path" "$expected_root" || return 2
}

rollback_quarantine_link_path() (
    local source=$1 target_path=$2 relative_path=$3 path=$4 quarantine_path=$5 hook_event=$6
    local name quarantine_absolute parent_before
    pin_rollback_target_parent "$target_path" "$relative_path" || return 2
    name=${path##*/}
    [[ -e "$name" || -L "$name" ]] || return 0
    parent_before=$(pwd -P) || return 2
    quarantine_absolute="$STATE_ROOT_PHYSICAL/$quarantine_path"
    state_name_matches_pin || return 2
    if [[ -n "$hook_event" ]]; then
        install_test_hook "$hook_event" "$path" "$quarantine_absolute" || return 2
    fi
    [[ "$(pwd -P)" == "$parent_before" ]] || return 2
    state_name_matches_pin || return 2
    [[ -e "$name" || -L "$name" ]] || return 0
    mv -n -- "$name" "$quarantine_absolute" || return 2
    [[ ! -e "$name" && ! -L "$name" ]] || return 2
    [[ -e "$quarantine_absolute" || -L "$quarantine_absolute" ]] || return 2
    if [[ -L "$quarantine_absolute" && "$(readlink "$quarantine_absolute")" == "$source" ]]; then
        return 0
    fi
    install_test_hook rollback_link_before_restore "$path" "$quarantine_absolute" || return 2
    mv -n -- "$quarantine_absolute" "$name" || return 2
    [[ -e "$name" || -L "$name" ]] || return 2
    [[ ! -e "$quarantine_absolute" && ! -L "$quarantine_absolute" ]] || return 2
)

rollback_link_entry() {
    local journal_index=$1 relative_path=$2 source=$3 target_path=$4 temp_path=$5
    local quarantine_dir entry_status status=0
    quarantine_dir="$QUARANTINE_ROOT/link-$journal_index"
    mkdir -p -- "$quarantine_dir" || return 1
    rollback_quarantine_link_path "$source" "$target_path" "$relative_path" "$target_path" "$quarantine_dir/final" rollback_link_before_quarantine
    entry_status=$?
    [[ $entry_status -eq 0 ]] || status=$entry_status
    rollback_quarantine_link_path "$source" "$target_path" "$relative_path" "$temp_path" "$quarantine_dir/temp" ''
    entry_status=$?
    [[ $entry_status -eq 0 ]] || status=$entry_status
    return "$status"
}

rollback_move_entry() (
    local journal_index=$1 relative_path=$2 target_path=$3 backup_path=$4 expected_fingerprint=$5
    local expected_root target_name backup_absolute stage_name
    backup_absolute="$STATE_ROOT_PHYSICAL/$backup_path"
    if [[ ! -e "$backup_absolute" && ! -L "$backup_absolute" ]]; then
        [[ -e "$target_path" || -L "$target_path" ]] && return 0
        return 2
    fi
    [[ "$(path_fingerprint "$backup_absolute")" == "$expected_fingerprint" ]] || return 2
    TARGET_RELATIVE_PATH=$relative_path
    TARGET_ROOT_PHYSICAL=''
    safe_target "$target_path" || return 2
    expected_root=$TARGET_ROOT_PHYSICAL
    [[ -n "$expected_root" ]] || return 2
    pin_existing_install_parent "$relative_path" "$expected_root" || return 2
    target_name=${relative_path##*/}
    stage_name=".dotfiles-restore-$$-$journal_index"
    [[ ! -e "$stage_name" && ! -L "$stage_name" ]] || return 2
    state_name_matches_pin || return 2
    install_test_hook rollback_move_before_stage "$target_path" "$backup_absolute" || return 2
    state_name_matches_pin || return 2
    [[ "$(path_fingerprint "$backup_absolute")" == "$expected_fingerprint" ]] || return 2
    mv -n -- "$backup_absolute" "$stage_name" || return 2
    if [[ ! -e "$stage_name" && ! -L "$stage_name" ]]; then
        return 2
    fi
    if [[ "$(path_fingerprint "$stage_name")" != "$expected_fingerprint" ]]; then
        mv -n -- "$stage_name" "$backup_absolute" || true
        return 2
    fi
    install_test_hook rollback_move_before_restore "$target_path" "$backup_absolute" || return 2
    mv -n -- "$stage_name" "$target_name" || return 2
    if [[ -e "$stage_name" || -L "$stage_name" ]]; then
        mv -n -- "$stage_name" "$backup_absolute" || true
        return 2
    fi
    [[ "$(path_fingerprint "$target_name")" == "$expected_fingerprint" ]] || return 2
)

rollback_transaction() {
    local i status=0 entry_status relative_path
    state_cwd_matches_pin || return 1
    for ((i=JOURNAL_COUNT-1; i>=0; i--)); do
        relative_path=${JOURNAL_RELATIVE[$i]}
        case "${JOURNAL_TYPE[$i]}" in
            LINK)
                rollback_link_entry "$i" "$relative_path" "${JOURNAL_FIRST[$i]}" "${JOURNAL_SECOND[$i]}" "${JOURNAL_AUX[$i]}"
                entry_status=$?
                ;;
            MOVE)
                rollback_move_entry "$i" "$relative_path" "${JOURNAL_FIRST[$i]}" "${JOURNAL_SECOND[$i]}" "${JOURNAL_IDENTITY[$i]}"
                entry_status=$?
                ;;
            *) entry_status=2 ;;
        esac
        if [[ $entry_status -eq 2 ]]; then
            printf '%s: ROLLBACK_REFUSED %s; entries remain recoverable in the backup or quarantine\n' "$PROGRAM" "$relative_path" >&2
            status=1
        elif [[ $entry_status -ne 0 ]]; then
            printf '%s: rollback failed for %s\n' "$PROGRAM" "$relative_path" >&2
            status=1
        fi
    done
    return "$status"
}

cleanup_transaction_storage() {
    [[ -n "$QUARANTINE_ROOT" ]] && rmdir -- "$QUARANTINE_ROOT" 2>/dev/null || true
    [[ -n "$TRANSACTION_ROOT" ]] && rmdir -- "$TRANSACTION_ROOT" 2>/dev/null || true
    rmdir -- transactions 2>/dev/null || true
}

transaction_trap() {
    local status=$?
    trap '' INT TERM
    trap - EXIT
    CLEANUP_ACTIVE=1
    install_test_hook during_cleanup "$STATE_ROOT" || true
    if [[ "$TRANSACTION_ACTIVE" == 1 && "$status" -ne 0 ]]; then
        rollback_transaction || true
    fi
    TRANSACTION_ACTIVE=0
    cleanup_transaction_storage
    release_lock || true
    [[ -n "$TRANSACTION_START_DIR" ]] && cd -P -- "$TRANSACTION_START_DIR" 2>/dev/null || true
    exit "$status"
}

start_transaction() {
    reset_transaction_journal || return $?
    TRANSACTION_START_DIR=$(pwd -P) || return 65
    TRANSACTION_ACTIVE=1
    trap transaction_trap EXIT
    trap 'record_transaction_signal 130' INT
    trap 'record_transaction_signal 143' TERM
    pin_state_root || return $?
    honor_pending_signal || return $?
    acquire_lock || return $?
    begin_transaction_storage || return $?
    honor_pending_signal || return $?
}

finish_transaction() {
    local status=0
    trap '' INT TERM
    CLEANUP_ACTIVE=1
    install_test_hook during_cleanup "$STATE_ROOT" || true
    TRANSACTION_ACTIVE=0
    cleanup_transaction_storage
    release_lock || status=$?
    cd -P -- "$TRANSACTION_START_DIR" || { [[ $status -ne 0 ]] || status=65; }
    trap - EXIT INT TERM
    return "$status"
}

apply_install_plan() {
    local action source target_path relative_path i

    for ((i=0; i<${#PLAN_ACTION[@]}; i++)); do
        action=${PLAN_ACTION[$i]}
        [[ "$action" == CREATE || "$action" == BACKUP ]] || continue
        source=${PLAN_SOURCE[$i]}
        target_path=${PLAN_TARGET[$i]}
        relative_path=${PLAN_PATH[$i]}
        apply_install_entry "$action" "$source" "$target_path" "$relative_path" || return $?
    done
}

command_install() {
    local apply=0 backup=0
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --apply)
                [[ $apply -eq 0 ]] || die 64 'install accepts --apply only once'
                apply=1
                ;;
            --backup)
                [[ $apply -eq 1 && $backup -eq 0 ]] || die 64 'install --backup requires --apply'
                backup=1
                ;;
            --target) die 64 'install does not accept --target' ;;
            --staging-home) die 64 'install does not accept --staging-home' ;;
            *) die 64 "unknown option: $1" ;;
        esac
        shift
    done
    build_install_plan "$backup" || return $?
    [[ $apply -eq 1 ]] || return 0
    start_transaction || return $?
    if [[ "$PLAN_NEEDS_BACKUP" == 1 ]]; then
        begin_backup || return $?
    fi
    apply_install_plan || return $?
    finish_transaction
}

check() {
    validation_target "$@"
    parse_manifest "$MANIFEST"
}

main() {
    local command=${1:-help}
    [[ $# -eq 0 ]] || shift
    case "$command" in
        help|-h|--help) usage ;;
        detect) detect_host ;;
        check) check "$@" ;;
        diff) command_diff "$@" ;;
        install) command_install "$@" ;;
        *) die 64 "unknown command: $command" ;;
    esac
}

main "$@"
