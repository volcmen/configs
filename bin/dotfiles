#!/usr/bin/env bash
set -u

PROGRAM=${0##*/}

startup_die() {
    printf '%s: %s\n' "$PROGRAM" "$*" >&2
    exit 65
}

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd -P)" || startup_die 'script directory is unavailable'
REPO_ROOT="$(cd "$SCRIPT_DIR/.." 2>/dev/null && pwd -P)" || startup_die 'repository root is unavailable'
SOURCE_ROOT="$(cd "$REPO_ROOT/home" 2>/dev/null && pwd -P)" || startup_die 'canonical source root is unavailable'
MANIFEST="$REPO_ROOT/dotfiles.manifest"

MF_APP=(); MF_PLATFORMS=(); MF_KIND=(); MF_PATH=()
MF_VALIDATOR=(); MF_REQUIRED=(); MF_TESTED=()
PLAN_ACTION=(); PLAN_APP=(); PLAN_PATH=(); PLAN_SOURCE=(); PLAN_TARGET=()

usage() {
    cat <<'USAGE'
Usage: dotfiles <command> [options]

Commands:
  detect                  print the physical host platform
  check [--target NAME]   validate canonical configuration
  diff [--target NAME] [--staging-home DIR]
                          compare canonical and live state
  install [--apply] [--backup]
                          preview or apply the installation plan
  help                    show this help
USAGE
}

die() {
    local status=$1
    shift
    printf '%s: %s\n' "$PROGRAM" "$*" >&2
    exit "$status"
}

manifest_error() { die 65 "manifest line $1: $2"; }

valid_platforms() {
    case "$1" in macos|arch|macos,arch|arch,macos) return 0 ;; *) return 1 ;; esac
}

valid_validator() {
    case "$1" in
        plain|shell|fish|fontconfig|git|hyprconf|hyprland-lua|ini|jsonc|kitty|lua|mako|mpv|python|starship|toml|uwsm-shell|xml|zellij|css) return 0 ;;
        *) return 1 ;;
    esac
}

safe_relative_path() {
    [[ -n "$1" && "$1" != /* && "$1" != *'|'* ]] || return 1
    case "/$1/" in *'/../'*|*'/./'*|*'//'*) return 1 ;; esac
    return 0
}

parse_manifest() {
    local file=$1 line line_no=0 app platforms kind path validator required tested extra separators i
    MF_APP=(); MF_PLATFORMS=(); MF_KIND=(); MF_PATH=()
    MF_VALIDATOR=(); MF_REQUIRED=(); MF_TESTED=()
    [[ -r "$file" ]] || die 65 "manifest is not readable: $file"
    while IFS= read -r line || [[ -n "$line" ]]; do
        line_no=$((line_no + 1))
        [[ -z "$line" || "$line" == \#* ]] && continue
        separators=${line//[!|]/}
        [[ "$separators" == '||||||' ]] || manifest_error "$line_no" 'expected seven fields'
        IFS='|' read -r app platforms kind path validator required tested extra <<<"$line"
        [[ -n "$app" && "$app" =~ ^[a-z0-9][a-z0-9-]*$ ]] || manifest_error "$line_no" 'invalid app'
        valid_platforms "$platforms" || manifest_error "$line_no" 'invalid platforms'
        [[ "$kind" == file ]] || manifest_error "$line_no" 'schema v1 kind must be file'
        safe_relative_path "$path" || manifest_error "$line_no" 'unsafe path'
        valid_validator "$validator" || manifest_error "$line_no" 'unknown validator'
        [[ "$required" == yes || "$required" == no ]] || manifest_error "$line_no" 'required must be yes or no'
        [[ -n "$tested" ]] || manifest_error "$line_no" 'tested_version is empty'
        for ((i=0; i<${#MF_PATH[@]}; i++)); do
            [[ "${MF_PATH[$i]}" != "$path" ]] || manifest_error "$line_no" "duplicate path: $path"
        done
        i=${#MF_APP[@]}
        MF_APP[$i]=$app; MF_PLATFORMS[$i]=$platforms; MF_KIND[$i]=$kind
        MF_PATH[$i]=$path; MF_VALIDATOR[$i]=$validator
        MF_REQUIRED[$i]=$required; MF_TESTED[$i]=$tested
    done <"$file"
}

platform_selected() {
    case ",$1," in *,"$2",*) return 0 ;; *) return 1 ;; esac
}

test_value() {
    [[ ${DOTFILES_TESTING:-0} == 1 ]] || return 1
    case "$1" in
        DOTFILES_TEST_UNAME) printf '%s' "${DOTFILES_TEST_UNAME:-}" ;;
        DOTFILES_TEST_OS_RELEASE) printf '%s' "${DOTFILES_TEST_OS_RELEASE:-}" ;;
        *) return 1 ;;
    esac
}

kernel_name() {
    local value
    value=$(test_value DOTFILES_TEST_UNAME) || true
    if [[ -n "$value" ]]; then printf '%s\n' "$value"; else uname -s; fi
}

os_release_path() {
    local value
    value=$(test_value DOTFILES_TEST_OS_RELEASE) || true
    if [[ -n "$value" ]]; then printf '%s\n' "$value"; else printf '/etc/os-release\n'; fi
}

os_release_id() {
    local file key value
    file=$(os_release_path)
    [[ -r "$file" ]] || return 1
    while IFS='=' read -r key value; do
        [[ "$key" == ID ]] || continue
        value=${value#\"}; value=${value%\"}
        value=${value#\'}; value=${value%\'}
        printf '%s\n' "$value"
        return 0
    done <"$file"
    return 1
}

detect_host() {
    local kernel id
    kernel=$(kernel_name)
    case "$kernel" in
        Darwin) HOST_PLATFORM=macos ;;
        Linux)
            id=$(os_release_id) || die 69 'unsupported host: Linux without readable ID'
            [[ "$id" == arch ]] || die 69 "unsupported host: Linux ID=$id"
            HOST_PLATFORM=arch
            ;;
        *) die 69 "unsupported host kernel: $kernel" ;;
    esac
    printf '%s\n' "$HOST_PLATFORM"
}

effective_home() {
    if [[ ${DOTFILES_TESTING:-0} == 1 && -n ${DOTFILES_TEST_HOME:-} ]]; then
        printf '%s\n' "$DOTFILES_TEST_HOME"
    elif [[ -n ${HOME:-} ]]; then
        printf '%s\n' "$HOME"
    else
        die 65 'HOME is not set'
    fi
}

validation_target() {
    local requested=${DOTFILES_TARGET:-} option_seen=0
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --target)
                [[ $# -ge 2 && -n "$2" ]] || die 64 '--target requires a platform'
                [[ $option_seen -eq 0 ]] || die 64 '--target may only be specified once'
                requested=$2
                option_seen=1
                shift 2
                ;;
            *) die 64 "unknown option: $1" ;;
        esac
    done
    if [[ -z "$requested" ]]; then
        detect_host >/dev/null
        requested=$HOST_PLATFORM
    fi
    case "$requested" in macos|arch) ;; *) die 64 "unknown target platform: $requested" ;; esac
    VALIDATION_TARGET=$requested
}

physical_dir() {
    (cd "$1" 2>/dev/null && pwd -P)
}

path_within() {
    local path=$1 root=$2
    if [[ "$root" == / ]]; then
        [[ "$path" == /* ]]
    else
        [[ "$path" == "$root" || "$path" == "$root"/* ]]
    fi
}

safe_source() {
    local source=$1 parent
    [[ -f "$source" && ! -L "$source" ]] || return 1
    parent=$(physical_dir "$(dirname "$source")") || return 1
    path_within "$parent" "$SOURCE_ROOT"
}

safe_target() {
    local target=$1 current physical component i
    local components=()
    [[ -n ${EFFECTIVE_HOME:-} && -n ${TARGET_RELATIVE_PATH:-} ]] || return 1
    current=$EFFECTIVE_HOME
    [[ ! -L "$current" ]] || return 1
    if [[ -e "$current" || -L "$current" ]]; then
        [[ -d "$current" ]] || return 1
        TARGET_ROOT_PHYSICAL=$(physical_dir "$current") || return 1
    else
        return 0
    fi
    IFS=/ read -r -a components <<<"$TARGET_RELATIVE_PATH"
    for ((i=0; i<${#components[@]}-1; i++)); do
        component=${components[$i]}
        current="$current/$component"
        [[ -L "$current" ]] && return 1
        if [[ -e "$current" && ! -d "$current" ]]; then
            return 1
        fi
        if [[ -d "$current" ]]; then
            physical=$(physical_dir "$current") || return 1
            path_within "$physical" "$TARGET_ROOT_PHYSICAL" || return 1
        fi
    done
    [[ "$target" == "$current" || "$target" == "$current"/* || "$target" == "$EFFECTIVE_HOME/$TARGET_RELATIVE_PATH" ]] || return 1
}

artifact_status() {
    local source=$1 target=$2 link
    safe_source "$source" && safe_target "$target" || { printf 'BLOCKED\n'; return; }
    if [[ -L "$target" ]]; then
        link=$(readlink "$target")
        [[ "$link" == "$source" ]] && printf 'LINKED\n' || printf 'FOREIGN_LINK\n'
    elif [[ -d "$target" ]]; then
        printf 'TYPE_CONFLICT\n'
    elif [[ -f "$target" ]]; then
        cmp -s "$source" "$target" && printf 'MATCH\n' || printf 'DRIFT\n'
    elif [[ -e "$target" ]]; then
        printf 'TYPE_CONFLICT\n'
    else
        printf 'MISSING\n'
    fi
}

text_artifact() {
    command -v iconv >/dev/null 2>&1 || return 1
    command -v od >/dev/null 2>&1 || return 1
    command -v awk >/dev/null 2>&1 || return 1
    [[ -r "$1" ]] || return 1
    iconv -f UTF-8 -t UTF-8 "$1" >/dev/null 2>&1 || return 1
    (
        set -o pipefail
        LC_ALL=C od -An -tu1 "$1" | awk '
            {
                for (i = 1; i <= NF; i++) {
                    if (($i < 32 && $i != 9 && $i != 10 && $i != 13) || $i == 127) {
                        bad = 1
                        exit
                    }
                }
            }
            END { exit bad }
        '
    )
}

command_diff() {
    local staging_home='' staging_seen=0 target_option='' target_seen=0 host target target_home live_home live_home_physical staging_physical source target_path status
    local i drift=0 blocked=0
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --target)
                [[ $# -ge 2 && -n "$2" ]] || die 64 '--target requires a platform'
                [[ $target_seen -eq 0 ]] || die 64 '--target may only be specified once'
                target_option=$2
                target_seen=1
                shift 2
                ;;
            --staging-home)
                [[ $# -ge 2 && -n "$2" ]] || die 64 '--staging-home requires a directory'
                [[ $staging_seen -eq 0 ]] || die 64 '--staging-home may only be specified once'
                staging_home=$2
                staging_seen=1
                shift 2
                ;;
            *) die 64 "unknown option: $1" ;;
        esac
    done
    if [[ -n "$target_option" ]]; then
        validation_target --target "$target_option"
    else
        validation_target
    fi
    target=$VALIDATION_TARGET
    detect_host >/dev/null
    host=$HOST_PLATFORM
    if [[ "$target" != "$host" && -z "$staging_home" ]]; then
        die 64 "target $target requires --staging-home"
    fi
    if [[ -n "$staging_home" ]]; then
        live_home=$(effective_home)
        live_home_physical=$(physical_dir "$live_home") || die 65 'live home cannot be resolved'
        staging_physical=$(physical_dir "$staging_home") || staging_physical=''
        if [[ -n "$staging_physical" && "$staging_physical" == "$live_home_physical" ]]; then
            die 64 'staging home must not resolve to live home'
        fi
        target_home=$staging_home
    else
        target_home=$(effective_home)
    fi
    [[ "$target_home" == / ]] || target_home=${target_home%/}
    [[ -n "$target_home" ]] || die 65 'effective home is empty'
    EFFECTIVE_HOME=$target_home
    parse_manifest "$MANIFEST"
    for ((i=0; i<${#MF_PATH[@]}; i++)); do
        platform_selected "${MF_PLATFORMS[$i]}" "$target" || continue
        TARGET_RELATIVE_PATH=${MF_PATH[$i]}
        source="$SOURCE_ROOT/${MF_PATH[$i]}"
        if [[ "$EFFECTIVE_HOME" == / ]]; then
            target_path="/${MF_PATH[$i]}"
        else
            target_path="$EFFECTIVE_HOME/${MF_PATH[$i]}"
        fi
        status=$(artifact_status "$source" "$target_path")
        printf '%s %s %s\n' "$status" "${MF_APP[$i]}" "${MF_PATH[$i]}"
        case "$status" in
            LINKED|MATCH) ;;
            BLOCKED) blocked=1 ;;
            *) drift=1 ;;
        esac
        if [[ "$status" == DRIFT ]] && text_artifact "$source" && text_artifact "$target_path"; then
            diff -u "$source" "$target_path" || true
        fi
    done
    [[ $blocked -eq 0 ]] || return 65
    [[ $drift -eq 0 ]] || return 1
    return 0
}

build_install_plan() {
    local host source target_path status action i
    local conflict=0 blocked=0

    detect_host >/dev/null
    host=$HOST_PLATFORM
    EFFECTIVE_HOME=$(effective_home)
    [[ "$EFFECTIVE_HOME" == / ]] || EFFECTIVE_HOME=${EFFECTIVE_HOME%/}
    [[ -n "$EFFECTIVE_HOME" ]] || die 65 'effective home is empty'
    parse_manifest "$MANIFEST"
    PLAN_ACTION=(); PLAN_APP=(); PLAN_PATH=(); PLAN_SOURCE=(); PLAN_TARGET=()

    for ((i=0; i<${#MF_PATH[@]}; i++)); do
        platform_selected "${MF_PLATFORMS[$i]}" "$host" || continue
        TARGET_RELATIVE_PATH=${MF_PATH[$i]}
        source="$SOURCE_ROOT/${MF_PATH[$i]}"
        if [[ "$EFFECTIVE_HOME" == / ]]; then
            target_path="/${MF_PATH[$i]}"
        else
            target_path="$EFFECTIVE_HOME/${MF_PATH[$i]}"
        fi
        status=$(artifact_status "$source" "$target_path")
        case "$status" in
            MISSING) action=CREATE ;;
            LINKED) action=NOOP ;;
            BLOCKED) action=BLOCKED; blocked=1 ;;
            *) action=CONFLICT; conflict=1 ;;
        esac
        PLAN_ACTION[${#PLAN_ACTION[@]}]=$action
        PLAN_APP[${#PLAN_APP[@]}]=${MF_APP[$i]}
        PLAN_PATH[${#PLAN_PATH[@]}]=${MF_PATH[$i]}
        PLAN_SOURCE[${#PLAN_SOURCE[@]}]=$source
        PLAN_TARGET[${#PLAN_TARGET[@]}]=$target_path
    done

    for ((i=0; i<${#PLAN_ACTION[@]}; i++)); do
        printf '%s %s %s\n' "${PLAN_ACTION[$i]}" "${PLAN_APP[$i]}" "${PLAN_PATH[$i]}"
    done
    if [[ $blocked -ne 0 ]]; then
        return 65
    elif [[ $conflict -ne 0 ]]; then
        return 1
    fi
}

prepare_install_parent() {
    local relative_path=$1 component physical parent_physical i
    local components=()

    [[ ! -L "$EFFECTIVE_HOME" && -d "$EFFECTIVE_HOME" ]] || return 1
    cd -P -- "$EFFECTIVE_HOME" || return 1
    TARGET_ROOT_PHYSICAL=$(pwd -P) || return 1

    IFS=/ read -r -a components <<<"$relative_path"
    for ((i=0; i<${#components[@]}-1; i++)); do
        component=${components[$i]}
        [[ ! -L "$component" ]] || return 1
        if [[ -e "$component" ]]; then
            [[ -d "$component" ]] || return 1
        else
            mkdir -- "$component" || return 1
        fi
        [[ -d "$component" && ! -L "$component" ]] || return 1
        parent_physical=$(pwd -P) || return 1
        cd -P -- "$component" || return 1
        physical=$(pwd -P) || return 1
        [[ "$physical" == "$parent_physical/$component" ]] || return 1
        path_within "$physical" "$TARGET_ROOT_PHYSICAL" || return 1
    done
}

apply_install_entry() (
    local source=$1 target_path=$2 relative_path=$3 target_name

    TARGET_RELATIVE_PATH=$relative_path
    safe_source "$source" || return 65
    safe_target "$target_path" || return 65
    prepare_install_parent "$relative_path" || return 65
    safe_target "$target_path" || return 65
    target_name=${relative_path##*/}
    [[ ! -e "$target_name" && ! -L "$target_name" ]] || return 65
    safe_source "$source" || return 65
    ln -s -- "$source" "$target_name"
)

apply_install_plan() {
    local source target_path relative_path i

    for ((i=0; i<${#PLAN_ACTION[@]}; i++)); do
        [[ "${PLAN_ACTION[$i]}" == CREATE ]] || continue
        source=${PLAN_SOURCE[$i]}
        target_path=${PLAN_TARGET[$i]}
        relative_path=${PLAN_PATH[$i]}
        apply_install_entry "$source" "$target_path" "$relative_path" || return 65
    done
}

command_install() {
    local apply=0 backup=0
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --apply)
                [[ $apply -eq 0 ]] || die 64 'install accepts --apply only once'
                apply=1
                ;;
            --backup)
                [[ $apply -eq 1 && $backup -eq 0 ]] || die 64 'install --backup requires --apply'
                backup=1
                ;;
            --target) die 64 'install does not accept --target' ;;
            --staging-home) die 64 'install does not accept --staging-home' ;;
            *) die 64 "unknown option: $1" ;;
        esac
        shift
    done
    build_install_plan || return $?
    [[ $apply -eq 1 ]] || return 0
    apply_install_plan
}

check() {
    validation_target "$@"
    parse_manifest "$MANIFEST"
}

main() {
    local command=${1:-help}
    [[ $# -eq 0 ]] || shift
    case "$command" in
        help|-h|--help) usage ;;
        detect) detect_host ;;
        check) check "$@" ;;
        diff) command_diff "$@" ;;
        install) command_install "$@" ;;
        *) die 64 "unknown command: $command" ;;
    esac
}

main "$@"
