#!/usr/bin/env bash
set -u

PROGRAM=${0##*/}

startup_die() {
    printf '%s: %s\n' "$PROGRAM" "$*" >&2
    exit 65
}

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd -P)" || startup_die 'script directory is unavailable'
REPO_ROOT="$(cd "$SCRIPT_DIR/.." 2>/dev/null && pwd -P)" || startup_die 'repository root is unavailable'
SOURCE_ROOT="$(cd "$REPO_ROOT/home" 2>/dev/null && pwd -P)" || startup_die 'canonical source root is unavailable'
MANIFEST="$REPO_ROOT/dotfiles.manifest"

MF_APP=(); MF_PLATFORMS=(); MF_KIND=(); MF_PATH=()
MF_VALIDATOR=(); MF_REQUIRED=(); MF_TESTED=()
PLAN_ACTION=(); PLAN_APP=(); PLAN_PATH=(); PLAN_SOURCE=(); PLAN_TARGET=()
PLAN_DETAIL=()
PLAN_SOURCE_IDENTITY=(); PLAN_SOURCE_FINGERPRINT=(); PLAN_TARGET_IDENTITY=()
PLAN_PARENT_PHYSICAL=(); PLAN_PARENT_IDENTITY=(); PLAN_PUBLISHED_IDENTITY=()
PLAN_BACKUP_PATH=(); PLAN_BACKUP_FINGERPRINT=(); PLAN_BACKUP_IDENTITY=()
PLAN_BACKUP_PARENT_PHYSICAL=(); PLAN_BACKUP_PARENT_IDENTITY=()
PLAN_VALIDATION_LEVEL=(); PLAN_VALIDATION_APP=(); PLAN_VALIDATION_PATH=(); PLAN_VALIDATION_DETAIL=()
PLAN_NEEDS_BACKUP=0

STATE_ROOT=''; STATE_ROOT_PHYSICAL=''; STATE_ROOT_IDENTITY=''; TRANSACTION_START_DIR=''
INSTALL_ROOT_PHYSICAL=''; INSTALL_ROOT_IDENTITY=''
PINNED_INSTALL_PATH=(); PINNED_INSTALL_PHYSICAL=(); PINNED_INSTALL_IDENTITY=(); PINNED_INSTALL_COUNT=0
LOCK_PATH='install.lock'; LOCK_HELD=0
TRANSACTIONS_ROOT_PHYSICAL=''; TRANSACTIONS_ROOT_IDENTITY=''
BACKUPS_ROOT_PHYSICAL=''; BACKUPS_ROOT_IDENTITY=''
TRANSACTION_ROOT_PHYSICAL=''; TRANSACTION_ROOT_IDENTITY=''
BACKUP_ROOT_PHYSICAL=''; BACKUP_ROOT_IDENTITY=''
TRANSACTION_ROOT=''; QUARANTINE_ROOT=''; BACKUP_ROOT=''; BACKUP_FILES=''; REPORT_PATH=''
REPORT_IDENTITY=''; REPORT_RECOVERY_PATH=''; REPORT_RECOVERY_IDENTITY=''
REPORT_RECOVERY_PARENT_PHYSICAL=''; REPORT_RECOVERY_PARENT_IDENTITY=''
REPORT_FD_OPEN=0; REPORT_WRITE_FAILED=0
REPORT_EXPECTED_ROW=(); REPORT_EXPECTED_COUNT=0
JOURNAL_TYPE=(); JOURNAL_RELATIVE=(); JOURNAL_FIRST=(); JOURNAL_SECOND=(); JOURNAL_IDENTITY=()
JOURNAL_ORIGINAL_IDENTITY=()
JOURNAL_AUX=(); JOURNAL_AUX_RELATIVE=()
JOURNAL_PARENT_PHYSICAL=(); JOURNAL_PARENT_IDENTITY=()
JOURNAL_AUX_PARENT_PHYSICAL=(); JOURNAL_AUX_PARENT_IDENTITY=()
JOURNAL_AUX_IDENTITY=(); JOURNAL_AUX_FINGERPRINT=()
JOURNAL_PUBLICATION=(); JOURNAL_PUBLICATION_RELATIVE=()
JOURNAL_PUBLICATION_PARENT_PHYSICAL=(); JOURNAL_PUBLICATION_PARENT_IDENTITY=()
JOURNAL_PUBLICATION_IDENTITY=(); JOURNAL_PUBLICATION_FINGERPRINT=()
JOURNAL_UNOWNED=(); JOURNAL_UNOWNED_PARENT_PHYSICAL=(); JOURNAL_UNOWNED_PARENT_IDENTITY=()
JOURNAL_UNOWNED_IDENTITY=(); JOURNAL_UNOWNED_FINGERPRINT=(); JOURNAL_UNOWNED_REPORTED=()
JOURNAL_REPORT_SOURCE=(); JOURNAL_REPORT_LOCATION=(); JOURNAL_PLAN_INDEX=()
JOURNAL_COUNT=0; MUTATION_COUNT=0; TEST_FAIL_AFTER=''; PRECOMMIT_CLEANUP_HOOK_RAN=0
TRANSACTION_ACTIVE=0; CLEANUP_ACTIVE=0; PENDING_SIGNAL=0; TRANSACTION_OWNER_PID=$$
TRANSACTION_STAT_STYLE=''; TRANSACTION_STAT_COMMAND=''
TRANSACTION_MOVE_STYLE=''; TRANSACTION_MOVE_COMMAND=''
TRANSACTION_LINK_COMMAND=''
MOVE_RESULT_PATH=''; MOVE_RESULT_PARENT_PHYSICAL=''; MOVE_RESULT_PARENT_IDENTITY=''
MOVE_RESULT_IDENTITY=''; MOVE_RESULT_FINGERPRINT=''
MOVE_RESULT_NOOP=0; MOVE_RESULT_AMBIGUOUS=0
HYPRLAND_RUNTIME_PROBED=0; HYPRLAND_RUNTIME_STATUS=125; HYPRLAND_RUNTIME_DETAIL=''
VERSION_APP=(); VERSION_VALUE=(); OBSERVED_VERSION=''

usage() {
    cat <<'USAGE'
Usage: dotfiles <command> [options]

Commands:
  detect                  print the physical host platform
  check [--target NAME]   validate canonical configuration
  diff [--target NAME] [--staging-home DIR]
                          compare canonical and live state
  install [--apply] [--backup]
                          preview or apply the installation plan
  help                    show this help
USAGE
}

die() {
    local status=$1
    shift
    printf '%s: %s\n' "$PROGRAM" "$*" >&2
    exit "$status"
}

manifest_error() { die 65 "manifest line $1: $2"; }

valid_platforms() {
    case "$1" in macos|arch|macos,arch|arch,macos) return 0 ;; *) return 1 ;; esac
}

valid_validator() {
    case "$1" in
        plain|shell|fish|fontconfig|git|hyprconf|hyprland-lua|ini|jsonc|kitty|lua|mako|mpv|python|starship|toml|uwsm-shell|xml|zellij|css) return 0 ;;
        *) return 1 ;;
    esac
}

safe_relative_path() {
    [[ -n "$1" && "$1" != /* && "$1" != *'|'* ]] || return 1
    case "$1" in *[[:space:]]*) return 1 ;; esac
    case "/$1/" in *'/../'*|*'/./'*|*'//'*) return 1 ;; esac
    return 0
}

valid_tested_version() {
    [[ "$1" == unverified ]] ||
        [[ "$1" =~ ^[vV]?[0-9]+([.][0-9A-Za-z]+)*(-[0-9A-Za-z-]+([.][0-9A-Za-z-]+)*)?([+][0-9A-Za-z-]+([.][0-9A-Za-z-]+)*)?$ ]]
}

manifest_control_line() (
    set -o pipefail
    LC_ALL=C od -An -tu1 "$1" | LC_ALL=C awk '
        BEGIN { line = 1 }
        {
            for (i = 1; i <= NF; i++) {
                byte = $i
                if (byte == 10) {
                    line++
                } else if (!bad_line && (byte < 32 || byte == 127)) {
                    bad_line = line
                }
            }
        }
        END { if (bad_line) print bad_line }
    '
)

parse_manifest() {
    local file=$1 line line_no=0 app platforms kind path validator required tested extra separators control_line i
    MF_APP=(); MF_PLATFORMS=(); MF_KIND=(); MF_PATH=()
    MF_VALIDATOR=(); MF_REQUIRED=(); MF_TESTED=()
    [[ -r "$file" ]] || die 65 "manifest is not readable: $file"
    control_line=$(manifest_control_line "$file") || manifest_error 1 'unable to inspect manifest control bytes'
    [[ -z "$control_line" ]] || manifest_error "$control_line" 'ASCII control byte is forbidden; manifest must use LF line endings'
    while IFS= read -r line || [[ -n "$line" ]]; do
        line_no=$((line_no + 1))
        [[ -z "$line" || "$line" == \#* ]] && continue
        separators=${line//[!|]/}
        [[ "$separators" == '||||||' ]] || manifest_error "$line_no" 'expected seven fields'
        IFS='|' read -r app platforms kind path validator required tested extra <<<"$line"
        [[ -n "$app" && "$app" =~ ^[a-z0-9][a-z0-9-]*$ ]] || manifest_error "$line_no" 'invalid app'
        valid_platforms "$platforms" || manifest_error "$line_no" 'invalid platforms'
        [[ "$kind" == file ]] || manifest_error "$line_no" 'schema v1 kind must be file'
        safe_relative_path "$path" || manifest_error "$line_no" 'unsafe path'
        valid_validator "$validator" || manifest_error "$line_no" 'unknown validator'
        [[ "$required" == yes || "$required" == no ]] || manifest_error "$line_no" 'required must be yes or no'
        [[ -n "$tested" ]] || manifest_error "$line_no" 'tested_version is empty'
        valid_tested_version "$tested" || manifest_error "$line_no" 'invalid tested_version'
        for ((i=0; i<${#MF_PATH[@]}; i++)); do
            [[ "${MF_PATH[$i]}" != "$path" ]] || manifest_error "$line_no" "duplicate path: $path"
        done
        i=${#MF_APP[@]}
        MF_APP[$i]=$app; MF_PLATFORMS[$i]=$platforms; MF_KIND[$i]=$kind
        MF_PATH[$i]=$path; MF_VALIDATOR[$i]=$validator
        MF_REQUIRED[$i]=$required; MF_TESTED[$i]=$tested
    done <"$file"
}

platform_selected() {
    case ",$1," in *,"$2",*) return 0 ;; *) return 1 ;; esac
}

test_value() {
    [[ ${DOTFILES_TESTING:-0} == 1 ]] || return 1
    case "$1" in
        DOTFILES_TEST_UNAME) printf '%s' "${DOTFILES_TEST_UNAME:-}" ;;
        DOTFILES_TEST_OS_RELEASE) printf '%s' "${DOTFILES_TEST_OS_RELEASE:-}" ;;
        *) return 1 ;;
    esac
}

install_test_hook() {
    [[ ${DOTFILES_TESTING:-0} == 1 && -n ${DOTFILES_TEST_INSTALL_HOOK:-} ]] || return 0
    [[ -x "$DOTFILES_TEST_INSTALL_HOOK" ]] || return 1
    "$DOTFILES_TEST_INSTALL_HOOK" "$@" 9>&-
}

run_without_report_fd() { "$@" 9>&-; }

kernel_name() {
    local value
    value=$(test_value DOTFILES_TEST_UNAME) || true
    if [[ -n "$value" ]]; then printf '%s\n' "$value"; else uname -s; fi
}

os_release_path() {
    local value
    value=$(test_value DOTFILES_TEST_OS_RELEASE) || true
    if [[ -n "$value" ]]; then printf '%s\n' "$value"; else printf '/etc/os-release\n'; fi
}

os_release_id() {
    local file key value
    file=$(os_release_path)
    [[ -r "$file" ]] || return 1
    while IFS='=' read -r key value; do
        [[ "$key" == ID ]] || continue
        value=${value#\"}; value=${value%\"}
        value=${value#\'}; value=${value%\'}
        printf '%s\n' "$value"
        return 0
    done <"$file"
    return 1
}

detect_host() {
    local kernel id
    kernel=$(kernel_name)
    case "$kernel" in
        Darwin) HOST_PLATFORM=macos ;;
        Linux)
            id=$(os_release_id) || die 69 'unsupported host: Linux without readable ID'
            [[ "$id" == arch ]] || die 69 "unsupported host: Linux ID=$id"
            HOST_PLATFORM=arch
            ;;
        *) die 69 "unsupported host kernel: $kernel" ;;
    esac
    printf '%s\n' "$HOST_PLATFORM"
}

effective_home() {
    if [[ ${DOTFILES_TESTING:-0} == 1 && -n ${DOTFILES_TEST_HOME:-} ]]; then
        printf '%s\n' "$DOTFILES_TEST_HOME"
    elif [[ -n ${HOME:-} ]]; then
        printf '%s\n' "$HOME"
    else
        die 65 'HOME is not set'
    fi
}

validation_target() {
    local requested=${DOTFILES_TARGET:-} option_seen=0
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --target)
                [[ $# -ge 2 && -n "$2" ]] || die 64 '--target requires a platform'
                [[ $option_seen -eq 0 ]] || die 64 '--target may only be specified once'
                requested=$2
                option_seen=1
                shift 2
                ;;
            *) die 64 "unknown option: $1" ;;
        esac
    done
    if [[ -z "$requested" ]]; then
        detect_host >/dev/null
        requested=$HOST_PLATFORM
    fi
    case "$requested" in macos|arch) ;; *) die 64 "unknown target platform: $requested" ;; esac
    VALIDATION_TARGET=$requested
}

physical_dir() {
    (cd "$1" 2>/dev/null && pwd -P)
}

path_within() {
    local path=$1 root=$2
    if [[ "$root" == / ]]; then
        [[ "$path" == /* ]]
    else
        [[ "$path" == "$root" || "$path" == "$root"/* ]]
    fi
}

safe_source() {
    local source=$1 parent
    [[ -f "$source" && ! -L "$source" ]] || return 1
    parent=$(physical_dir "$(run_without_report_fd dirname "$source")") || return 1
    path_within "$parent" "$SOURCE_ROOT"
}

safe_absent_source() {
    local source=$1 parent physical
    [[ ! -e "$source" && ! -L "$source" ]] || return 1
    parent=${source%/*}
    while :; do
        path_within "$parent" "$SOURCE_ROOT" || return 1
        [[ ! -L "$parent" ]] || return 1
        if [[ -e "$parent" ]]; then
            [[ -d "$parent" ]] || return 1
            physical=$(physical_dir "$parent") || return 1
            path_within "$physical" "$SOURCE_ROOT"
            return
        fi
        [[ "$parent" != "$SOURCE_ROOT" ]] || return 0
        parent=${parent%/*}
        [[ -n "$parent" ]] || parent=/
    done
}

canonical_source_state() {
    if safe_source "$1"; then
        printf 'PRESENT\n'
    elif safe_absent_source "$1"; then
        printf 'ABSENT\n'
    else
        printf 'UNSAFE\n'
    fi
}

safe_target() {
    local target=$1 current physical component i
    local components=()
    [[ -n ${EFFECTIVE_HOME:-} && -n ${TARGET_RELATIVE_PATH:-} ]] || return 1
    current=$EFFECTIVE_HOME
    [[ ! -L "$current" ]] || return 1
    if [[ -e "$current" || -L "$current" ]]; then
        [[ -d "$current" ]] || return 1
        TARGET_ROOT_PHYSICAL=$(physical_dir "$current") || return 1
    else
        return 0
    fi
    IFS=/ read -r -a components <<<"$TARGET_RELATIVE_PATH"
    for ((i=0; i<${#components[@]}-1; i++)); do
        component=${components[$i]}
        current="$current/$component"
        [[ -L "$current" ]] && return 1
        if [[ -e "$current" && ! -d "$current" ]]; then
            return 1
        fi
        if [[ -d "$current" ]]; then
            physical=$(physical_dir "$current") || return 1
            path_within "$physical" "$TARGET_ROOT_PHYSICAL" || return 1
        fi
    done
    [[ "$target" == "$current" || "$target" == "$current"/* || "$target" == "$EFFECTIVE_HOME/$TARGET_RELATIVE_PATH" ]] || return 1
}

artifact_status() {
    local source=$1 target=$2 link
    safe_source "$source" && safe_target "$target" || { printf 'BLOCKED\n'; return; }
    if [[ -L "$target" ]]; then
        link=$(run_without_report_fd readlink "$target")
        [[ "$link" == "$source" ]] && printf 'LINKED\n' || printf 'FOREIGN_LINK\n'
    elif [[ -d "$target" ]]; then
        printf 'TYPE_CONFLICT\n'
    elif [[ -f "$target" ]]; then
        run_without_report_fd cmp -s "$source" "$target" && printf 'MATCH\n' || printf 'DRIFT\n'
    elif [[ -e "$target" ]]; then
        printf 'TYPE_CONFLICT\n'
    else
        printf 'MISSING\n'
    fi
}

text_artifact() {
    command -v iconv >/dev/null 2>&1 || return 1
    command -v od >/dev/null 2>&1 || return 1
    command -v awk >/dev/null 2>&1 || return 1
    [[ -r "$1" ]] || return 1
    iconv -f UTF-8 -t UTF-8 "$1" >/dev/null 2>&1 || return 1
    (
        set -o pipefail
        LC_ALL=C od -An -tu1 "$1" | awk '
            {
                for (i = 1; i <= NF; i++) {
                    if (($i < 32 && $i != 9 && $i != 10 && $i != 13) || $i == 127) {
                        bad = 1
                        exit
                    }
                }
            }
            END { exit bad }
        '
    )
}

validate_jsonc() {
    local file=$1
    command -v bun >/dev/null 2>&1 || return 125
    bun -e 'const file = process.argv[1]; Bun.JSONC.parse(await Bun.file(file).text());' "$file"
}

validate_toml() {
    local file=$1
    command -v python3 >/dev/null 2>&1 || return 125
    python3 -c 'import tomllib' >/dev/null 2>&1 || return 125
    python3 -c 'import sys,tomllib; f=open(sys.argv[1], "rb"); tomllib.load(f); f.close()' "$file"
}

run_validator() {
    local id=$1 file=$2 target=$3
    case "$id" in
        plain) return 0 ;;
        shell) bash -n "$file" ;;
        fish) command -v fish >/dev/null 2>&1 || return 125; fish -n "$file" ;;
        git) command -v git >/dev/null 2>&1 || return 125; git config --file "$file" --list >/dev/null ;;
        lua|hyprland-lua) command -v luac >/dev/null 2>&1 || return 125; luac -p "$file" ;;
        python)
            command -v python3 >/dev/null 2>&1 || return 125
            python3 -c 'import pathlib,sys; p=pathlib.Path(sys.argv[1]); compile(p.read_bytes(), str(p), "exec")' "$file"
            ;;
        xml|fontconfig) command -v xmllint >/dev/null 2>&1 || return 125; xmllint --noout "$file" ;;
        uwsm-shell) sh -n "$file" ;;
        zellij)
            command -v zellij >/dev/null 2>&1 || return 125
            zellij --config "$file" setup --check >/dev/null
            ;;
        starship)
            command -v starship >/dev/null 2>&1 || return 125
            STARSHIP_CONFIG="$file" STARSHIP_LOG=error starship print-config >/dev/null
            ;;
        jsonc) validate_jsonc "$file" ;;
        toml) validate_toml "$file" ;;
        kitty|mpv|hyprconf|ini|mako|css) return 125 ;;
        *) return 64 ;;
    esac
}

validation_detail() {
    local detail=$1 status=$2 had_detail=${3:-0}
    [[ -n "$detail" ]] && had_detail=1
    detail=${detail//$'\r'/ }
    detail=${detail//$'\n'/ }
    detail=$(LC_ALL=C printf '%s' "$detail" | LC_ALL=C tr -d '\000-\037\177-\237')
    detail=${detail#"${detail%%[![:space:]]*}"}
    detail=${detail%"${detail##*[![:space:]]}"}
    if [[ -z "$detail" ]]; then
        if [[ $had_detail -eq 1 && $status -eq 0 ]]; then
            printf 'validator reported diagnostic output'
            return
        fi
        printf 'validator exited %s' "$status"
    else
        printf '%s' "${detail:0:240}"
    fi
}

version_token() {
    LC_ALL=C awk '
        {
            for (i = 1; i <= NF; i++) {
                token = $i
                if (!found && token ~ /^[vV]?[0-9][0-9A-Za-z._+-]*$/ && token ~ /\./) {
                    sub(/^[vV]/, "", token)
                    found = token
                }
            }
        }
        END { if (found) print found }
    '
}

observe_installed_version() {
    local app=$1 target=$2 host=$3 status value i cache_index
    for ((i=0; i<${#VERSION_APP[@]}; i++)); do
        if [[ "${VERSION_APP[$i]}" == "$app" ]]; then
            OBSERVED_VERSION=${VERSION_VALUE[$i]}
            return 0
        fi
    done

    if [[ "$target" != "$host" ]]; then
        value=not-applicable
    else
        case "$app" in
            chromium) set -- chromium --version ;;
            electron) set -- electron --version ;;
            fish) set -- fish --version ;;
            fontconfig) set -- fc-list --version ;;
            fuzzel) set -- fuzzel --version ;;
            git) set -- git --version ;;
            hypridle) set -- hypridle --version ;;
            hyprland) set -- Hyprland --version ;;
            hyprlock) set -- hyprlock --version ;;
            hyprpaper) set -- hyprpaper --version ;;
            hyprsunset) set -- hyprsunset --version ;;
            kitty) set -- kitty --version ;;
            mako) set -- mako --version ;;
            mpv) set -- mpv --version ;;
            starship) set -- starship --version ;;
            uwsm) set -- uwsm --version ;;
            waybar) set -- waybar --version ;;
            xdg-portal) set -- xdg-desktop-portal-hyprland --version ;;
            yazi) set -- yazi --version ;;
            zellij) set -- zellij --version ;;
            *) value=not-applicable; set -- ;;
        esac
        if [[ $# -gt 0 ]]; then
            if command -v "$1" >/dev/null 2>&1; then
                value=$(
                    set -o pipefail
                    command "$@" 2>&1 | version_token
                )
                status=$?
                if [[ $status -eq 0 ]]; then
                    [[ -n "$value" ]] || value=unavailable
                else
                    value=unavailable
                fi
            else
                value=unavailable
            fi
        fi
    fi

    cache_index=${#VERSION_APP[@]}
    VERSION_APP[$cache_index]=$app
    VERSION_VALUE[$cache_index]=$value
    OBSERVED_VERSION=$value
}

probe_hyprland_runtime_validation() {
    local capture_file detail output_present=0 status
    [[ $HYPRLAND_RUNTIME_PROBED -eq 0 ]] || return 0
    HYPRLAND_RUNTIME_PROBED=1
    if [[ -z ${HYPRLAND_INSTANCE_SIGNATURE:-} ]]; then
        HYPRLAND_RUNTIME_STATUS=125
        HYPRLAND_RUNTIME_DETAIL='requires an Arch Hyprland session'
        return
    fi
    if ! command -v hyprctl >/dev/null 2>&1; then
        HYPRLAND_RUNTIME_STATUS=125
        HYPRLAND_RUNTIME_DETAIL='hyprctl is unavailable'
        return
    fi
    capture_file=$(mktemp "${TMPDIR:-/tmp}/dotfiles-hyprctl.XXXXXX") || {
        HYPRLAND_RUNTIME_STATUS=1
        HYPRLAND_RUNTIME_DETAIL='unable to create secure Hyprland validation capture'
        return
    }
    trap 'rm -f -- "$capture_file"' EXIT
    trap 'exit 129' HUP
    trap 'exit 130' INT
    trap 'exit 143' TERM
    hyprctl configerrors >"$capture_file" 2>&1
    status=$?
    if [[ -s "$capture_file" ]]; then
        output_present=1
        detail=$(LC_ALL=C tr -d '\000-\037\177-\237' <"$capture_file")
    else
        detail=''
    fi
    if ! rm -f -- "$capture_file"; then
        trap - EXIT HUP INT TERM
        HYPRLAND_RUNTIME_STATUS=1
        HYPRLAND_RUNTIME_DETAIL='unable to remove Hyprland validation capture'
        return
    fi
    trap - EXIT HUP INT TERM
    if [[ $status -eq 0 && $output_present -eq 0 ]]; then
        HYPRLAND_RUNTIME_STATUS=0
        HYPRLAND_RUNTIME_DETAIL='hyprctl configerrors reported no diagnostics'
    else
        HYPRLAND_RUNTIME_STATUS=1
        HYPRLAND_RUNTIME_DETAIL=$(validation_detail "$detail" "$status" "$output_present")
    fi
}

run_hyprland_runtime_validation() {
    probe_hyprland_runtime_validation
    case "$HYPRLAND_RUNTIME_STATUS" in
        0)
            printf 'PASS hyprland live-session: %s\n' "$HYPRLAND_RUNTIME_DETAIL"
            return 0
            ;;
        125)
            printf 'RUNTIME UNVERIFIED hyprland live-session: %s\n' "$HYPRLAND_RUNTIME_DETAIL"
            return 0
            ;;
        *)
            printf 'BLOCKED hyprland live-session: %s\n' "$HYPRLAND_RUNTIME_DETAIL"
            return 1
            ;;
    esac
}

command_diff() {
    local staging_home='' staging_seen=0 target_option='' target_seen=0 host target target_home live_home live_home_physical staging_physical source target_path status source_status
    local i drift=0 blocked=0
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --target)
                [[ $# -ge 2 && -n "$2" ]] || die 64 '--target requires a platform'
                [[ $target_seen -eq 0 ]] || die 64 '--target may only be specified once'
                target_option=$2
                target_seen=1
                shift 2
                ;;
            --staging-home)
                [[ $# -ge 2 && -n "$2" ]] || die 64 '--staging-home requires a directory'
                [[ $staging_seen -eq 0 ]] || die 64 '--staging-home may only be specified once'
                staging_home=$2
                staging_seen=1
                shift 2
                ;;
            *) die 64 "unknown option: $1" ;;
        esac
    done
    if [[ -n "$target_option" ]]; then
        validation_target --target "$target_option"
    else
        validation_target
    fi
    target=$VALIDATION_TARGET
    detect_host >/dev/null
    host=$HOST_PLATFORM
    if [[ "$target" != "$host" && -z "$staging_home" ]]; then
        die 64 "target $target requires --staging-home"
    fi
    if [[ -n "$staging_home" ]]; then
        live_home=$(effective_home)
        live_home_physical=$(physical_dir "$live_home") || die 65 'live home cannot be resolved'
        staging_physical=$(physical_dir "$staging_home") || staging_physical=''
        if [[ -n "$staging_physical" && "$staging_physical" == "$live_home_physical" ]]; then
            die 64 'staging home must not resolve to live home'
        fi
        target_home=$staging_home
    else
        target_home=$(effective_home)
    fi
    [[ "$target_home" == / ]] || target_home=${target_home%/}
    [[ -n "$target_home" ]] || die 65 'effective home is empty'
    EFFECTIVE_HOME=$target_home
    parse_manifest "$MANIFEST"
    for ((i=0; i<${#MF_PATH[@]}; i++)); do
        platform_selected "${MF_PLATFORMS[$i]}" "$target" || continue
        TARGET_RELATIVE_PATH=${MF_PATH[$i]}
        source="$SOURCE_ROOT/${MF_PATH[$i]}"
        if [[ "$EFFECTIVE_HOME" == / ]]; then
            target_path="/${MF_PATH[$i]}"
        else
            target_path="$EFFECTIVE_HOME/${MF_PATH[$i]}"
        fi
        source_status=$(canonical_source_state "$source")
        case "$source_status:${MF_REQUIRED[$i]}" in
            ABSENT:no)
                printf 'SKIPPED %s %s: optional canonical source is absent; validation unverified\n' "${MF_APP[$i]}" "${MF_PATH[$i]}"
                continue
                ;;
            ABSENT:yes)
                printf 'BLOCKED %s %s: required canonical source is absent\n' "${MF_APP[$i]}" "${MF_PATH[$i]}"
                blocked=1
                continue
                ;;
            UNSAFE:*)
                printf 'BLOCKED %s %s: canonical source is unsafe\n' "${MF_APP[$i]}" "${MF_PATH[$i]}"
                blocked=1
                continue
                ;;
        esac
        status=$(artifact_status "$source" "$target_path")
        printf '%s %s %s\n' "$status" "${MF_APP[$i]}" "${MF_PATH[$i]}"
        case "$status" in
            LINKED|MATCH) ;;
            BLOCKED) blocked=1 ;;
            *) drift=1 ;;
        esac
        if [[ "$status" == DRIFT ]] && text_artifact "$source" && text_artifact "$target_path"; then
            diff -u "$source" "$target_path" || true
        fi
    done
    [[ $blocked -eq 0 ]] || return 65
    [[ $drift -eq 0 ]] || return 1
    return 0
}

build_install_plan() {
    local allow_backup=${1:-0} host source target_path status source_status action detail validator_output validator_status i result_index
    local source_identity source_fingerprint target_identity
    local conflict=0 blocked=0

    detect_host >/dev/null
    host=$HOST_PLATFORM
    EFFECTIVE_HOME=$(effective_home)
    [[ "$EFFECTIVE_HOME" == / ]] || EFFECTIVE_HOME=${EFFECTIVE_HOME%/}
    [[ -n "$EFFECTIVE_HOME" ]] || die 65 'effective home is empty'
    parse_manifest "$MANIFEST"
    PLAN_ACTION=(); PLAN_APP=(); PLAN_PATH=(); PLAN_SOURCE=(); PLAN_TARGET=()
    PLAN_DETAIL=()
    PLAN_SOURCE_IDENTITY=(); PLAN_SOURCE_FINGERPRINT=(); PLAN_TARGET_IDENTITY=()
    PLAN_PARENT_PHYSICAL=(); PLAN_PARENT_IDENTITY=(); PLAN_PUBLISHED_IDENTITY=()
    PLAN_BACKUP_PATH=(); PLAN_BACKUP_FINGERPRINT=(); PLAN_BACKUP_IDENTITY=()
    PLAN_BACKUP_PARENT_PHYSICAL=(); PLAN_BACKUP_PARENT_IDENTITY=()
    PLAN_VALIDATION_LEVEL=(); PLAN_VALIDATION_APP=(); PLAN_VALIDATION_PATH=(); PLAN_VALIDATION_DETAIL=()
    PLAN_NEEDS_BACKUP=0

    for ((i=0; i<${#MF_PATH[@]}; i++)); do
        platform_selected "${MF_PLATFORMS[$i]}" "$host" || continue
        TARGET_RELATIVE_PATH=${MF_PATH[$i]}
        source="$SOURCE_ROOT/${MF_PATH[$i]}"
        if [[ "$EFFECTIVE_HOME" == / ]]; then
            target_path="/${MF_PATH[$i]}"
        else
            target_path="$EFFECTIVE_HOME/${MF_PATH[$i]}"
        fi
        source_status=$(canonical_source_state "$source")
        detail=''
        source_identity=''
        source_fingerprint=''
        target_identity=''
        case "$source_status:${MF_REQUIRED[$i]}" in
            ABSENT:no)
                action=SKIPPED
                detail='optional canonical source is absent; validation unverified'
                ;;
            ABSENT:yes)
                action=BLOCKED
                detail='required canonical source is absent'
                blocked=1
                ;;
            UNSAFE:*)
                action=BLOCKED
                detail='canonical source is unsafe'
                blocked=1
                ;;
            PRESENT:*)
                source_identity=$(path_identity "$source") || source_identity=''
                source_fingerprint=$(path_fingerprint "$source") || source_fingerprint=''
                if [[ -z "$source_identity" || -z "$source_fingerprint" ]]; then
                    action=BLOCKED
                    detail='canonical source identity is unavailable'
                    blocked=1
                else
                    status=$(artifact_status "$source" "$target_path")
                    case "$status" in
                        MISSING) action=CREATE ;;
                        LINKED)
                            target_identity=$(path_identity "$target_path") || target_identity=''
                            if [[ -n "$target_identity" ]]; then
                                action=NOOP
                            else
                                action=BLOCKED
                                detail='linked target identity is unavailable'
                                blocked=1
                            fi
                            ;;
                        BLOCKED) action=BLOCKED; blocked=1 ;;
                        TYPE_CONFLICT)
                            if [[ "$allow_backup" == 1 ]]; then
                                action=BLOCKED
                                blocked=1
                            else
                                action=CONFLICT
                                conflict=1
                            fi
                            ;;
                        DRIFT|MATCH|FOREIGN_LINK)
                            if [[ "$allow_backup" == 1 ]]; then
                                action=BACKUP
                                PLAN_NEEDS_BACKUP=1
                            else
                                action=CONFLICT
                                conflict=1
                            fi
                            ;;
                        *) action=BLOCKED; blocked=1 ;;
                    esac
                fi
                ;;
        esac
        PLAN_ACTION[${#PLAN_ACTION[@]}]=$action
        PLAN_APP[${#PLAN_APP[@]}]=${MF_APP[$i]}
        PLAN_PATH[${#PLAN_PATH[@]}]=${MF_PATH[$i]}
        PLAN_SOURCE[${#PLAN_SOURCE[@]}]=$source
        PLAN_TARGET[${#PLAN_TARGET[@]}]=$target_path
        PLAN_DETAIL[${#PLAN_DETAIL[@]}]=$detail
        PLAN_SOURCE_IDENTITY[${#PLAN_SOURCE_IDENTITY[@]}]=$source_identity
        PLAN_SOURCE_FINGERPRINT[${#PLAN_SOURCE_FINGERPRINT[@]}]=$source_fingerprint
        PLAN_TARGET_IDENTITY[${#PLAN_TARGET_IDENTITY[@]}]=$target_identity
        PLAN_PARENT_PHYSICAL[${#PLAN_PARENT_PHYSICAL[@]}]=''
        PLAN_PARENT_IDENTITY[${#PLAN_PARENT_IDENTITY[@]}]=''
        PLAN_PUBLISHED_IDENTITY[${#PLAN_PUBLISHED_IDENTITY[@]}]=''
        PLAN_BACKUP_PATH[${#PLAN_BACKUP_PATH[@]}]=''
        PLAN_BACKUP_FINGERPRINT[${#PLAN_BACKUP_FINGERPRINT[@]}]=''
        PLAN_BACKUP_IDENTITY[${#PLAN_BACKUP_IDENTITY[@]}]=''
        PLAN_BACKUP_PARENT_PHYSICAL[${#PLAN_BACKUP_PARENT_PHYSICAL[@]}]=''
        PLAN_BACKUP_PARENT_IDENTITY[${#PLAN_BACKUP_PARENT_IDENTITY[@]}]=''

        if [[ "$source_status" == PRESENT ]]; then
            validator_output=$(run_validator "${MF_VALIDATOR[$i]}" "$source" "$host" 2>&1)
            validator_status=$?
            case "$validator_status" in
                0) ;;
                125)
                    result_index=${#PLAN_VALIDATION_LEVEL[@]}
                    PLAN_VALIDATION_LEVEL[$result_index]='RUNTIME UNVERIFIED'
                    PLAN_VALIDATION_APP[$result_index]=${MF_APP[$i]}
                    PLAN_VALIDATION_PATH[$result_index]=${MF_PATH[$i]}
                    PLAN_VALIDATION_DETAIL[$result_index]="validator unavailable or intentionally unsafe on $host"
                    ;;
                *)
                    result_index=${#PLAN_VALIDATION_LEVEL[@]}
                    PLAN_VALIDATION_LEVEL[$result_index]=BLOCKED
                    PLAN_VALIDATION_APP[$result_index]=${MF_APP[$i]}
                    PLAN_VALIDATION_PATH[$result_index]=${MF_PATH[$i]}
                    PLAN_VALIDATION_DETAIL[$result_index]=$(validation_detail "$validator_output" "$validator_status")
                    blocked=1
                    ;;
            esac
        fi
    done

    for ((i=0; i<${#PLAN_ACTION[@]}; i++)); do
        if [[ -n "${PLAN_DETAIL[$i]}" ]]; then
            printf '%s %s %s: %s\n' "${PLAN_ACTION[$i]}" "${PLAN_APP[$i]}" "${PLAN_PATH[$i]}" "${PLAN_DETAIL[$i]}"
        else
            printf '%s %s %s\n' "${PLAN_ACTION[$i]}" "${PLAN_APP[$i]}" "${PLAN_PATH[$i]}"
        fi
    done
    for ((i=0; i<${#PLAN_VALIDATION_LEVEL[@]}; i++)); do
        printf '%s %s %s: %s\n' "${PLAN_VALIDATION_LEVEL[$i]}" "${PLAN_VALIDATION_APP[$i]}" \
            "${PLAN_VALIDATION_PATH[$i]}" "${PLAN_VALIDATION_DETAIL[$i]}"
    done
    if [[ $blocked -ne 0 ]]; then
        return 65
    elif [[ $conflict -ne 0 ]]; then
        return 1
    fi
}

state_root() {
    if [[ ${DOTFILES_TESTING:-0} == 1 && -n ${DOTFILES_TEST_STATE:-} ]]; then
        printf '%s\n' "$DOTFILES_TEST_STATE"
        return
    fi
    [[ -n ${HOME:-} ]] || return 65
    printf '%s/dotfiles\n' "${XDG_STATE_HOME:-$HOME/.local/state}"
}

capture_directory_pin() (
    local path=$1 physical identity
    [[ -d "$path" && ! -L "$path" ]] || return 1
    cd -P -- "$path" || return 1
    physical=$(pwd -P) || return 1
    identity=$(path_identity .) || return 1
    printf '%s\t%s\n' "$identity" "$physical"
)

remember_install_path_pin() {
    local path=$1 physical=$2 identity=$3 i
    for ((i=0; i<PINNED_INSTALL_COUNT; i++)); do
        [[ "${PINNED_INSTALL_PATH[$i]}" != "$path" ]] || return 0
    done
    PINNED_INSTALL_PATH[$PINNED_INSTALL_COUNT]=$path
    PINNED_INSTALL_PHYSICAL[$PINNED_INSTALL_COUNT]=$physical
    PINNED_INSTALL_IDENTITY[$PINNED_INSTALL_COUNT]=$identity
    PINNED_INSTALL_COUNT=$((PINNED_INSTALL_COUNT + 1))
}

pin_planned_install_root() {
    local pin identity physical i current component
    local components=()
    PINNED_INSTALL_PATH=(); PINNED_INSTALL_PHYSICAL=(); PINNED_INSTALL_IDENTITY=(); PINNED_INSTALL_COUNT=0
    pin=$(capture_directory_pin "$EFFECTIVE_HOME") || return 65
    IFS=$'\t' read -r identity physical <<<"$pin"
    [[ -n "$identity" && -n "$physical" ]] || return 65
    INSTALL_ROOT_IDENTITY=$identity
    INSTALL_ROOT_PHYSICAL=$physical
    remember_install_path_pin "$EFFECTIVE_HOME" "$physical" "$identity"

    for ((i=0; i<${#PLAN_PATH[@]}; i++)); do
        current=$EFFECTIVE_HOME
        IFS=/ read -r -a components <<<"${PLAN_PATH[$i]}"
        for ((component=0; component<${#components[@]}-1; component++)); do
            current="$current/${components[$component]}"
            [[ ! -L "$current" ]] || return 65
            if [[ -e "$current" ]]; then
                pin=$(capture_directory_pin "$current") || return 65
                IFS=$'\t' read -r identity physical <<<"$pin"
                remember_install_path_pin "$current" "$physical" "$identity"
            else
                break
            fi
        done
    done
}

pinned_install_names_match() {
    local i identity physical
    for ((i=0; i<PINNED_INSTALL_COUNT; i++)); do
        [[ -d "${PINNED_INSTALL_PATH[$i]}" && ! -L "${PINNED_INSTALL_PATH[$i]}" ]] || return 1
        identity=$(path_identity "${PINNED_INSTALL_PATH[$i]}") || return 1
        [[ "$identity" == "${PINNED_INSTALL_IDENTITY[$i]}" ]] || return 1
        physical=$(physical_dir "${PINNED_INSTALL_PATH[$i]}") || return 1
        [[ "$physical" == "${PINNED_INSTALL_PHYSICAL[$i]}" ]] || return 1
    done
}

install_root_name_matches_pin() {
    local identity physical
    [[ -d "$EFFECTIVE_HOME" && ! -L "$EFFECTIVE_HOME" ]] || return 1
    identity=$(path_identity "$EFFECTIVE_HOME") || return 1
    [[ "$identity" == "$INSTALL_ROOT_IDENTITY" ]] || return 1
    physical=$(physical_dir "$EFFECTIVE_HOME") || return 1
    [[ "$physical" == "$INSTALL_ROOT_PHYSICAL" ]]
}

reset_transaction_journal() {
    JOURNAL_TYPE=(); JOURNAL_RELATIVE=(); JOURNAL_FIRST=(); JOURNAL_SECOND=(); JOURNAL_IDENTITY=()
    JOURNAL_ORIGINAL_IDENTITY=()
    JOURNAL_AUX=(); JOURNAL_AUX_RELATIVE=()
    JOURNAL_PARENT_PHYSICAL=(); JOURNAL_PARENT_IDENTITY=()
    JOURNAL_AUX_PARENT_PHYSICAL=(); JOURNAL_AUX_PARENT_IDENTITY=()
    JOURNAL_AUX_IDENTITY=(); JOURNAL_AUX_FINGERPRINT=()
    JOURNAL_PUBLICATION=(); JOURNAL_PUBLICATION_RELATIVE=()
    JOURNAL_PUBLICATION_PARENT_PHYSICAL=(); JOURNAL_PUBLICATION_PARENT_IDENTITY=()
    JOURNAL_PUBLICATION_IDENTITY=(); JOURNAL_PUBLICATION_FINGERPRINT=()
    JOURNAL_UNOWNED=(); JOURNAL_UNOWNED_PARENT_PHYSICAL=(); JOURNAL_UNOWNED_PARENT_IDENTITY=()
    JOURNAL_UNOWNED_IDENTITY=(); JOURNAL_UNOWNED_FINGERPRINT=(); JOURNAL_UNOWNED_REPORTED=()
    JOURNAL_REPORT_SOURCE=(); JOURNAL_REPORT_LOCATION=(); JOURNAL_PLAN_INDEX=()
    JOURNAL_COUNT=0
    MUTATION_COUNT=0
    PENDING_SIGNAL=0
    PRECOMMIT_CLEANUP_HOOK_RAN=0
    REPORT_PATH=''; REPORT_IDENTITY=''; REPORT_RECOVERY_PATH=''; REPORT_RECOVERY_IDENTITY=''
    REPORT_RECOVERY_PARENT_PHYSICAL=''; REPORT_RECOVERY_PARENT_IDENTITY=''
    REPORT_FD_OPEN=0; REPORT_WRITE_FAILED=0
    REPORT_EXPECTED_ROW=(); REPORT_EXPECTED_COUNT=0
    TRANSACTIONS_ROOT_PHYSICAL=''; TRANSACTIONS_ROOT_IDENTITY=''
    BACKUPS_ROOT_PHYSICAL=''; BACKUPS_ROOT_IDENTITY=''
    TRANSACTION_ROOT_PHYSICAL=''; TRANSACTION_ROOT_IDENTITY=''
    BACKUP_ROOT_PHYSICAL=''; BACKUP_ROOT_IDENTITY=''
    MOVE_RESULT_NOOP=0; MOVE_RESULT_AMBIGUOUS=0
    TEST_FAIL_AFTER=''
    if [[ ${DOTFILES_TESTING:-0} == 1 ]]; then
        TEST_FAIL_AFTER=${DOTFILES_TEST_FAIL_AFTER:-}
        case "$TEST_FAIL_AFTER" in
            '') ;;
            0|*[!0-9]*) return 64 ;;
        esac
    fi
}

path_identity() {
    local identity
    case "$TRANSACTION_STAT_STYLE" in
        bsd) identity=$(run_without_report_fd "$TRANSACTION_STAT_COMMAND" -f '%d:%i' "$1" 2>/dev/null) || return 1 ;;
        gnu) identity=$(run_without_report_fd "$TRANSACTION_STAT_COMMAND" -c '%d:%i' -- "$1" 2>/dev/null) || return 1 ;;
        *) return 1 ;;
    esac
    [[ "$identity" =~ ^[0-9]+:[0-9]+$ ]] || return 1
    printf '%s\n' "$identity"
}

path_fingerprint() {
    local checksum link
    if [[ -L "$1" ]]; then
        link=$(run_without_report_fd readlink "$1") || return 1
        printf 'L:%s\n' "$link"
    elif [[ -f "$1" ]]; then
        checksum=$(run_without_report_fd cksum <"$1") || return 1
        printf 'F:%s\n' "$checksum"
    else
        return 1
    fi
}

move_artifact_fingerprint() {
    if [[ -f "$1" || -L "$1" ]]; then
        path_fingerprint "$1"
    elif [[ -d "$1" ]]; then
        printf 'D\n'
    else
        return 1
    fi
}

capture_move_candidate() (
    local candidate=$1 expected_identity=$2 expected_fingerprint=$3 parent name
    local parent_physical parent_identity identity fingerprint
    [[ -e "$candidate" || -L "$candidate" ]] || return 1
    identity=$(path_identity "$candidate") || return 1
    [[ "$identity" == "$expected_identity" ]] || return 1
    fingerprint=$(move_artifact_fingerprint "$candidate") || return 1
    [[ "$fingerprint" == "$expected_fingerprint" ]] || return 1
    parent=${candidate%/*}
    name=${candidate##*/}
    [[ "$parent" != "$candidate" ]] || parent=.
    cd -P -- "$parent" || return 1
    parent_physical=$(run_without_report_fd /bin/pwd -P) || return 1
    parent_identity=$(path_identity .) || return 1
    identity=$(path_identity "$name") || return 1
    fingerprint=$(move_artifact_fingerprint "$name") || return 1
    [[ "$identity" == "$expected_identity" && "$fingerprint" == "$expected_fingerprint" ]] || return 1
    printf '%s\t%s\t%s\t%s\t%s\n' "$parent_physical/$name" "$parent_physical" \
        "$parent_identity" "$identity" "$fingerprint"
)

capture_actual_move_candidate() (
    local candidate=$1 parent name parent_physical parent_identity identity fingerprint
    local current_identity current_fingerprint
    [[ -e "$candidate" || -L "$candidate" ]] || return 1
    identity=$(path_identity "$candidate") || return 1
    fingerprint=$(move_artifact_fingerprint "$candidate") || return 1
    parent=${candidate%/*}
    name=${candidate##*/}
    [[ "$parent" != "$candidate" ]] || parent=.
    cd -P -- "$parent" || return 1
    parent_physical=$(run_without_report_fd /bin/pwd -P) || return 1
    parent_identity=$(path_identity .) || return 1
    current_identity=$(path_identity "$name") || return 1
    current_fingerprint=$(move_artifact_fingerprint "$name") || return 1
    [[ "$current_identity" == "$identity" && "$current_fingerprint" == "$fingerprint" ]] || return 1
    printf '%s\t%s\t%s\t%s\t%s\n' "$parent_physical/$name" "$parent_physical" \
        "$parent_identity" "$current_identity" "$current_fingerprint"
)

capture_move_prestate() {
    local candidate=$1 identity fingerprint
    if [[ ! -e "$candidate" && ! -L "$candidate" ]]; then
        printf 'absent\t-\t-\n'
        return 0
    fi
    identity=$(path_identity "$candidate") || return 1
    fingerprint=$(move_artifact_fingerprint "$candidate") || return 1
    printf 'present\t%s\t%s\n' "$identity" "$fingerprint"
}

set_move_result_from_info() {
    IFS=$'\t' read -r MOVE_RESULT_PATH MOVE_RESULT_PARENT_PHYSICAL MOVE_RESULT_PARENT_IDENTITY \
        MOVE_RESULT_IDENTITY MOVE_RESULT_FINGERPRINT <<<"$1"
}

record_move_ambiguity() {
    local operation=$1 source=$2 destination=$3
    MOVE_RESULT_AMBIGUOUS=1
    printf '%s: MOVE_AMBIGUOUS operation=%s source=%s destination=%s; no candidate was selected\n' \
        "$PROGRAM" "$operation" "$source" "$destination" >&2
    (
        cd -P -- "$STATE_ROOT_PHYSICAL" || exit 74
        state_cwd_matches_pin || exit 74
        append_report MOVE_AMBIGUOUS "$operation" "$source" "$destination"
    )
}

select_transaction_primitives() {
    local kernel stat_command move_command link_command=/bin/link
    kernel=$(run_without_report_fd /usr/bin/uname -s 2>/dev/null) || return 74
    if [[ ${DOTFILES_TESTING:-0} == 1 && -n ${DOTFILES_TEST_TRANSACTION_KERNEL:-} ]]; then
        kernel=$DOTFILES_TEST_TRANSACTION_KERNEL
    fi
    case "$kernel" in
        Darwin)
            TRANSACTION_STAT_STYLE=bsd
            stat_command=/usr/bin/stat
            TRANSACTION_MOVE_STYLE=bsd
            move_command=/bin/mv
            ;;
        Linux)
            TRANSACTION_STAT_STYLE=gnu
            stat_command=/usr/bin/stat
            TRANSACTION_MOVE_STYLE=gnu
            move_command=/usr/bin/mv
            ;;
        *) return 74 ;;
    esac
    if [[ ${DOTFILES_TESTING:-0} == 1 ]]; then
        [[ -z ${DOTFILES_TEST_STAT_COMMAND:-} ]] || stat_command=$DOTFILES_TEST_STAT_COMMAND
        [[ -z ${DOTFILES_TEST_MOVE_COMMAND:-} ]] || move_command=$DOTFILES_TEST_MOVE_COMMAND
    fi
    [[ "$stat_command" == /* && -x "$stat_command" ]] || return 74
    [[ "$move_command" == /* && -x "$move_command" ]] || return 74
    [[ "$link_command" == /* && -x "$link_command" ]] || return 74
    TRANSACTION_STAT_COMMAND=$stat_command
    TRANSACTION_MOVE_COMMAND=$move_command
    TRANSACTION_LINK_COMMAND=$link_command
}

move_no_clobber_exact() {
    local source=$1 destination=$2 operation=${3:-generic} observed_identity observed_fingerprint
    local command_status info candidate nested candidate_count i expected_count=0 changed_count=0
    local pre_present pre_identity pre_fingerprint source_expected=0 expected_new_arrival=0
    local candidates=() pre_presence=() pre_identities=() pre_fingerprints=()
    local actual_info=() actual_identities=() actual_fingerprints=() expected_indices=() changed_indices=()
    [[ $# -eq 2 || $# -eq 3 ]] || return 74
    MOVE_RESULT_PATH=''; MOVE_RESULT_PARENT_PHYSICAL=''; MOVE_RESULT_PARENT_IDENTITY=''
    MOVE_RESULT_IDENTITY=''; MOVE_RESULT_FINGERPRINT=''
    MOVE_RESULT_NOOP=0; MOVE_RESULT_AMBIGUOUS=0
    install_test_hook move_before_syscall "$operation" "$source" "$destination" || return $?
    nested="$destination/${source##*/}"
    candidates[0]=$source
    candidates[1]=$destination
    candidates[2]=$nested
    candidate_count=${#candidates[@]}
    for ((i=0; i<candidate_count; i++)); do
        IFS=$'\t' read -r pre_present pre_identity pre_fingerprint \
            <<<"$(capture_move_prestate "${candidates[$i]}")" || return 74
        pre_presence[$i]=$pre_present
        pre_identities[$i]=$pre_identity
        pre_fingerprints[$i]=$pre_fingerprint
    done
    [[ "${pre_presence[0]}" == present ]] || return 74
    observed_identity=${pre_identities[0]}
    observed_fingerprint=${pre_fingerprints[0]}
    command_status=0
    case "$TRANSACTION_MOVE_STYLE" in
        bsd) run_without_report_fd "$TRANSACTION_MOVE_COMMAND" -h -n -- "$source" "$destination" || command_status=$? ;;
        gnu) run_without_report_fd "$TRANSACTION_MOVE_COMMAND" -n -T -- "$source" "$destination" || command_status=$? ;;
        *) return 74 ;;
    esac
    [[ $command_status -eq 0 ]] || return "$command_status"
    for ((i=0; i<candidate_count; i++)); do
        candidate=${candidates[$i]}
        info=$(capture_actual_move_candidate "$candidate") || info=''
        actual_info[$i]=$info
        [[ -n "$info" ]] || continue
        IFS=$'\t' read -r _ _ _ actual_identities[$i] actual_fingerprints[$i] <<<"$info"
        if [[ "${actual_identities[$i]}" == "$observed_identity" && \
            "${actual_fingerprints[$i]}" == "$observed_fingerprint" ]]; then
            expected_indices[$expected_count]=$i
            expected_count=$((expected_count + 1))
            [[ $i -eq 0 ]] && source_expected=1
        fi
        if [[ "${pre_presence[$i]}" != present || \
            "${pre_identities[$i]}" != "${actual_identities[$i]}" || \
            "${pre_fingerprints[$i]}" != "${actual_fingerprints[$i]}" ]]; then
            changed_indices[$changed_count]=$i
            changed_count=$((changed_count + 1))
        fi
    done

    if [[ $source_expected -eq 1 ]]; then
        for ((i=0; i<expected_count; i++)); do
            candidate=${expected_indices[$i]}
            [[ $candidate -eq 0 ]] && continue
            if [[ "${pre_presence[$candidate]}" != present || \
                "${pre_identities[$candidate]}" != "$observed_identity" || \
                "${pre_fingerprints[$candidate]}" != "$observed_fingerprint" ]]; then
                expected_new_arrival=1
            fi
        done
        if [[ $expected_new_arrival -eq 0 && $changed_count -eq 0 ]]; then
            set_move_result_from_info "${actual_info[0]}"
            MOVE_RESULT_NOOP=1
            printf '%s: MOVE_NOOP operation=%s source=%s destination=%s; source remained in place\n' \
                "$PROGRAM" "$operation" "$source" "$destination" >&2
            return 0
        fi
        record_move_ambiguity "$operation" "$source" "$destination" || return 74
        return 74
    fi

    if [[ $expected_count -eq 1 ]]; then
        set_move_result_from_info "${actual_info[${expected_indices[0]}]}"
        return 0
    fi
    if [[ $changed_count -eq 0 ]]; then
        MOVE_RESULT_IDENTITY=$observed_identity
        MOVE_RESULT_FINGERPRINT=$observed_fingerprint
        return 0
    fi
    if [[ $expected_count -gt 1 || $changed_count -gt 1 ]]; then
        record_move_ambiguity "$operation" "$source" "$destination" || return 74
        return 74
    fi
    set_move_result_from_info "${actual_info[${changed_indices[0]}]}"
    return 0
}

recover_unowned_displaced() {
    local original_path=$1 saved_path=$MOVE_RESULT_PATH saved_parent=$MOVE_RESULT_PARENT_PHYSICAL
    local saved_parent_identity=$MOVE_RESULT_PARENT_IDENTITY saved_identity=$MOVE_RESULT_IDENTITY
    local saved_fingerprint=$MOVE_RESULT_FINGERPRINT info
    [[ -n "$saved_identity" && -n "$saved_fingerprint" ]] || return 74
    if [[ -z "$saved_path" ]]; then
        printf 'UNOWNED_DISPLACED\t-\t-\t-\t%s\t%s\n' "$saved_identity" "$saved_fingerprint"
        return 0
    fi
    if [[ ! -e "$original_path" && ! -L "$original_path" ]]; then
        move_no_clobber_exact "$saved_path" "$original_path" unowned_restore || true
        if [[ "$MOVE_RESULT_IDENTITY" == "$saved_identity" && \
            "$MOVE_RESULT_FINGERPRINT" == "$saved_fingerprint" && \
            "$MOVE_RESULT_PATH" != "$saved_path" ]]; then
            printf 'UNOWNED_RESTORED\t%s\t%s\t%s\t%s\t%s\n' "$MOVE_RESULT_PATH" \
                "$MOVE_RESULT_PARENT_PHYSICAL" "$MOVE_RESULT_PARENT_IDENTITY" \
                "$saved_identity" "$saved_fingerprint"
            return 0
        fi
    fi
    info=$(capture_move_candidate "$saved_path" "$saved_identity" "$saved_fingerprint") || info=''
    if [[ -n "$info" ]]; then
        IFS=$'\t' read -r saved_path saved_parent saved_parent_identity saved_identity saved_fingerprint <<<"$info"
        printf 'UNOWNED_DISPLACED\t%s\t%s\t%s\t%s\t%s\n' "$saved_path" "$saved_parent" \
            "$saved_parent_identity" "$saved_identity" "$saved_fingerprint"
    else
        printf 'UNOWNED_DISPLACED\t-\t-\t-\t%s\t%s\n' "$saved_identity" "$saved_fingerprint"
    fi
}

pin_state_root() {
    STATE_ROOT=$(state_root) || return $?
    run_without_report_fd mkdir -p -- "$STATE_ROOT" || return 74
    [[ -d "$STATE_ROOT" && ! -L "$STATE_ROOT" ]] || return 74
    cd -P -- "$STATE_ROOT" || return 74
    STATE_ROOT_PHYSICAL=$(run_without_report_fd /bin/pwd -P) || return 74
    STATE_ROOT_IDENTITY=$(path_identity .) || return 74
}

state_name_matches_pin() {
    local identity
    [[ -d "$STATE_ROOT" && ! -L "$STATE_ROOT" ]] || return 1
    identity=$(path_identity "$STATE_ROOT") || return 1
    [[ "$identity" == "$STATE_ROOT_IDENTITY" ]]
}

state_cwd_matches_pin() {
    local identity
    identity=$(path_identity .) || return 1
    [[ "$identity" == "$STATE_ROOT_IDENTITY" ]]
}

refresh_state_physical_from_cwd() {
    state_cwd_matches_pin || return 74
    STATE_ROOT_PHYSICAL=$(run_without_report_fd /bin/pwd -P) || return 74
}

state_physical_matches_pin() {
    local identity
    [[ -d "$STATE_ROOT_PHYSICAL" && ! -L "$STATE_ROOT_PHYSICAL" ]] || return 1
    identity=$(path_identity "$STATE_ROOT_PHYSICAL") || return 1
    [[ "$identity" == "$STATE_ROOT_IDENTITY" ]]
}

state_container_name_matches_pin() {
    local name=$1 expected_physical=$2 expected_identity=$3 identity physical
    state_cwd_matches_pin || return 1
    [[ -d "$name" && ! -L "$name" ]] || return 1
    identity=$(path_identity "$name") || return 1
    [[ "$identity" == "$expected_identity" ]] || return 1
    physical=$(physical_dir "$name") || return 1
    [[ "$physical" == "$expected_physical" ]]
}

pin_state_container() {
    local name=$1 pin identity physical
    state_cwd_matches_pin && state_name_matches_pin || return 74
    if [[ ! -e "$name" && ! -L "$name" ]]; then
        run_without_report_fd mkdir -- "$name" || return 74
    fi
    if [[ ! -d "$name" || -L "$name" ]]; then
        printf '%s: state container is not a real directory: %s\n' "$PROGRAM" "$name" >&2
        return 74
    fi
    pin=$(capture_directory_pin "$name") || return 74
    IFS=$'\t' read -r identity physical <<<"$pin"
    [[ -n "$identity" && "$physical" == "$STATE_ROOT_PHYSICAL/$name" ]] || return 74
    state_container_name_matches_pin "$name" "$physical" "$identity" || return 74
    printf '%s\t%s\n' "$identity" "$physical"
}

create_pinned_state_storage() (
    local container_physical=$1 container_identity=$2 child=$3 nested=$4 mode=$5
    local current_identity current_physical child_identity child_physical
    [[ -n "$container_physical" && -n "$container_identity" && -n "$child" ]] || return 74
    case "$child" in */*|.|..) return 74 ;; esac
    case "$nested" in */*|.|..) return 74 ;; esac
    cd -P -- "$container_physical" || return 74
    current_identity=$(path_identity .) || return 74
    current_physical=$(run_without_report_fd /bin/pwd -P) || return 74
    [[ "$current_identity" == "$container_identity" && "$current_physical" == "$container_physical" ]] || return 74
    [[ ! -e "$child" && ! -L "$child" ]] || return 74
    run_without_report_fd mkdir -- "$child" || return 74
    [[ -z "$mode" ]] || run_without_report_fd chmod "$mode" "$child" || return 74
    cd -P -- "$child" || return 74
    child_identity=$(path_identity .) || return 74
    child_physical=$(run_without_report_fd /bin/pwd -P) || return 74
    [[ "$child_physical" == "$container_physical/$child" ]] || return 74
    if [[ -n "$nested" ]]; then
        [[ ! -e "$nested" && ! -L "$nested" ]] || return 74
        run_without_report_fd mkdir -- "$nested" || return 74
        [[ -d "$nested" && ! -L "$nested" ]] || return 74
    fi
    printf '%s\t%s\n' "$child_identity" "$child_physical"
)

state_storage_name_matches_pin() {
    local container_name=$1 container_physical=$2 container_identity=$3
    local storage_name=$4 storage_physical=$5 storage_identity=$6 identity physical
    state_container_name_matches_pin "$container_name" "$container_physical" "$container_identity" || return 1
    [[ -d "$storage_name" && ! -L "$storage_name" ]] || return 1
    identity=$(path_identity "$storage_name") || return 1
    [[ "$identity" == "$storage_identity" ]] || return 1
    physical=$(physical_dir "$storage_name") || return 1
    [[ "$physical" == "$storage_physical" && "$physical" == "$container_physical"/* ]]
}

preflight_backup_devices() {
    local state_device=${STATE_ROOT_IDENTITY%%:*} target_parent target_device pin_index i found
    [[ -n "$state_device" ]] || return 74
    install_root_name_matches_pin && pinned_install_names_match || return 65
    state_cwd_matches_pin && state_name_matches_pin || return 74
    for ((i=0; i<${#PLAN_ACTION[@]}; i++)); do
        [[ "${PLAN_ACTION[$i]}" == BACKUP ]] || continue
        target_parent=${PLAN_TARGET[$i]%/*}
        found=0
        for ((pin_index=0; pin_index<PINNED_INSTALL_COUNT; pin_index++)); do
            [[ "${PINNED_INSTALL_PATH[$pin_index]}" == "$target_parent" ]] || continue
            target_device=${PINNED_INSTALL_IDENTITY[$pin_index]%%:*}
            found=1
            break
        done
        [[ $found -eq 1 && -n "$target_device" ]] || return 65
        if [[ "$target_device" != "$state_device" ]]; then
            printf '%s: backup target parent is on a different device than the pinned state root: %s; no home or backup files were changed\n' \
                "$PROGRAM" "${PLAN_PATH[$i]}" >&2
            return 74
        fi
    done
}

record_transaction_signal() {
    [[ "$PENDING_SIGNAL" == 0 ]] && PENDING_SIGNAL=$1
}

honor_pending_signal() {
    [[ "$PENDING_SIGNAL" == 0 ]] && return 0
    return "$PENDING_SIGNAL"
}

arm_subshell_signal_forwarding() {
    trap 'kill -INT "$TRANSACTION_OWNER_PID" 2>/dev/null || true' INT
    trap 'kill -TERM "$TRANSACTION_OWNER_PID" 2>/dev/null || true' TERM
}

acquire_lock() {
    state_cwd_matches_pin || return 74
    install_test_hook before_lock_acquire "$STATE_ROOT" || return $?
    honor_pending_signal || return $?
    state_cwd_matches_pin || return 74
    if run_without_report_fd mkdir -- "$LOCK_PATH" 2>/dev/null; then
        LOCK_HELD=1
    else
        printf '%s: another install is active: %s/install.lock\n' "$PROGRAM" "$STATE_ROOT" >&2
        return 75
    fi
    honor_pending_signal || return $?
    install_test_hook after_lock_acquire "$STATE_ROOT" "$STATE_ROOT_PHYSICAL" || return $?
    honor_pending_signal || return $?
    state_cwd_matches_pin && state_name_matches_pin || return 74
}

release_lock() {
    [[ "$LOCK_HELD" == 1 ]] || return 0
    state_cwd_matches_pin || return 74
    if run_without_report_fd rmdir -- "$LOCK_PATH"; then
        LOCK_HELD=0
        return 0
    fi
    printf '%s: failed to release install lock in pinned state root\n' "$PROGRAM" >&2
    return 74
}

begin_transaction_storage() {
    local timestamp container_pin storage_pin child
    state_cwd_matches_pin && state_name_matches_pin || return 74
    timestamp=$(run_without_report_fd date -u +%Y%m%dT%H%M%SZ) || return 74
    container_pin=$(pin_state_container transactions) || return $?
    IFS=$'\t' read -r TRANSACTIONS_ROOT_IDENTITY TRANSACTIONS_ROOT_PHYSICAL <<<"$container_pin"
    child="$timestamp-$$"
    TRANSACTION_ROOT="transactions/$child"
    storage_pin=$(create_pinned_state_storage "$TRANSACTIONS_ROOT_PHYSICAL" \
        "$TRANSACTIONS_ROOT_IDENTITY" "$child" quarantine 700) || return $?
    IFS=$'\t' read -r TRANSACTION_ROOT_IDENTITY TRANSACTION_ROOT_PHYSICAL <<<"$storage_pin"
    state_storage_name_matches_pin transactions "$TRANSACTIONS_ROOT_PHYSICAL" \
        "$TRANSACTIONS_ROOT_IDENTITY" "$TRANSACTION_ROOT" "$TRANSACTION_ROOT_PHYSICAL" \
        "$TRANSACTION_ROOT_IDENTITY" || return 74
    QUARANTINE_ROOT="$TRANSACTION_ROOT/quarantine"
    [[ -d "$QUARANTINE_ROOT" && ! -L "$QUARANTINE_ROOT" ]] || return 74
    honor_pending_signal || return $?
}

begin_backup() {
    local timestamp noclobber_was_set=0 open_status=0 container_pin storage_pin child report_creation_path
    state_cwd_matches_pin && state_name_matches_pin || return 74
    timestamp=$(run_without_report_fd date -u +%Y%m%dT%H%M%SZ) || return 74
    container_pin=$(pin_state_container backups) || return $?
    IFS=$'\t' read -r BACKUPS_ROOT_IDENTITY BACKUPS_ROOT_PHYSICAL <<<"$container_pin"
    child="$timestamp-$$"
    BACKUP_ROOT="backups/$child"
    storage_pin=$(create_pinned_state_storage "$BACKUPS_ROOT_PHYSICAL" \
        "$BACKUPS_ROOT_IDENTITY" "$child" files '') || return $?
    IFS=$'\t' read -r BACKUP_ROOT_IDENTITY BACKUP_ROOT_PHYSICAL <<<"$storage_pin"
    state_storage_name_matches_pin backups "$BACKUPS_ROOT_PHYSICAL" "$BACKUPS_ROOT_IDENTITY" \
        "$BACKUP_ROOT" "$BACKUP_ROOT_PHYSICAL" "$BACKUP_ROOT_IDENTITY" || return 74
    BACKUP_FILES="$BACKUP_ROOT/files"
    [[ -d "$BACKUP_FILES" && ! -L "$BACKUP_FILES" ]] || return 74
    REPORT_PATH="$BACKUP_ROOT/report.tsv"
    report_creation_path="$BACKUP_ROOT_PHYSICAL/report.tsv"
    [[ -o noclobber ]] && noclobber_was_set=1
    set -C
    exec 9>"$report_creation_path" || open_status=$?
    [[ $noclobber_was_set -eq 1 ]] || set +C
    [[ $open_status -eq 0 ]] || return 74
    REPORT_FD_OPEN=1
    [[ -f "$report_creation_path" && ! -L "$report_creation_path" ]] || return 74
    REPORT_IDENTITY=$(path_identity "$report_creation_path") || return 74
    [[ -n "$REPORT_IDENTITY" ]] || return 74
    state_storage_name_matches_pin backups "$BACKUPS_ROOT_PHYSICAL" "$BACKUPS_ROOT_IDENTITY" \
        "$BACKUP_ROOT" "$BACKUP_ROOT_PHYSICAL" "$BACKUP_ROOT_IDENTITY" || return 74
    REPORT_RECOVERY_PARENT_PHYSICAL=$BACKUP_ROOT_PHYSICAL
    REPORT_RECOVERY_PARENT_IDENTITY=$BACKUP_ROOT_IDENTITY
    REPORT_RECOVERY_PATH="$REPORT_RECOVERY_PARENT_PHYSICAL/report-recovery.tsv"
    [[ ! -e "$REPORT_RECOVERY_PATH" && ! -L "$REPORT_RECOVERY_PATH" ]] || return 74
    install_test_hook report_recovery_before_link "$REPORT_RECOVERY_PATH" || return $?
    state_storage_name_matches_pin backups "$BACKUPS_ROOT_PHYSICAL" "$BACKUPS_ROOT_IDENTITY" \
        "$BACKUP_ROOT" "$BACKUP_ROOT_PHYSICAL" "$BACKUP_ROOT_IDENTITY" || return 74
    run_without_report_fd "$TRANSACTION_LINK_COMMAND" "$report_creation_path" "$REPORT_RECOVERY_PATH" || return 74
    [[ -f "$REPORT_RECOVERY_PATH" && ! -L "$REPORT_RECOVERY_PATH" ]] || return 74
    REPORT_RECOVERY_IDENTITY=$(path_identity "$REPORT_RECOVERY_PATH") || return 74
    [[ "$REPORT_RECOVERY_IDENTITY" == "$REPORT_IDENTITY" ]] || return 74
    honor_pending_signal || return $?
}

close_report_handle() {
    [[ "$REPORT_FD_OPEN" == 1 ]] || return 0
    exec 9>&- || return 74
    REPORT_FD_OPEN=0
}

report_path_matches_pin() {
    local identity
    [[ -n "$REPORT_PATH" && -f "$REPORT_PATH" && ! -L "$REPORT_PATH" ]] || return 1
    identity=$(path_identity "$REPORT_PATH") || return 1
    [[ "$identity" == "$REPORT_IDENTITY" ]]
}

report_recovery_path_matches_pin() {
    local identity
    [[ -n "$REPORT_RECOVERY_PATH" && -f "$REPORT_RECOVERY_PATH" && ! -L "$REPORT_RECOVERY_PATH" ]] || return 1
    identity=$(path_identity "$REPORT_RECOVERY_PATH") || return 1
    [[ "$identity" == "$REPORT_RECOVERY_IDENTITY" && "$identity" == "$REPORT_IDENTITY" ]]
}

locate_report_recovery_link() (
    local candidate identity parent_physical parent_identity match='' match_count=0
    [[ -n "$REPORT_RECOVERY_PARENT_PHYSICAL" && -n "$REPORT_RECOVERY_PARENT_IDENTITY" && \
        -n "$REPORT_RECOVERY_IDENTITY" ]] || return 1
    [[ -d "$REPORT_RECOVERY_PARENT_PHYSICAL" && ! -L "$REPORT_RECOVERY_PARENT_PHYSICAL" ]] || return 1
    cd -P -- "$REPORT_RECOVERY_PARENT_PHYSICAL" || return 1
    parent_physical=$(run_without_report_fd /bin/pwd -P) || return 1
    parent_identity=$(path_identity .) || return 1
    [[ "$parent_identity" == "$REPORT_RECOVERY_PARENT_IDENTITY" ]] || return 1
    shopt -s dotglob nullglob
    for candidate in ./*; do
        [[ "${candidate#./}" != "${REPORT_PATH##*/}" ]] || continue
        [[ -f "$candidate" && ! -L "$candidate" ]] || continue
        identity=$(path_identity "$candidate") || continue
        [[ "$identity" == "$REPORT_RECOVERY_IDENTITY" ]] || continue
        match=${candidate#./}
        match_count=$((match_count + 1))
    done
    [[ $match_count -eq 1 ]] || return 1
    printf '%s\t%s\t%s\n' "$parent_physical/$match" "$parent_physical" "$parent_identity"
)

refresh_report_recovery_location() {
    local previous_state_physical=$1 expected_name info actual parent_physical parent_identity
    [[ -n "$REPORT_RECOVERY_IDENTITY" ]] || return 0
    expected_name=${REPORT_RECOVERY_PATH##*/}
    REPORT_RECOVERY_PATH=$(path_with_replaced_prefix "$REPORT_RECOVERY_PATH" \
        "$previous_state_physical" "$STATE_ROOT_PHYSICAL") || return 74
    REPORT_RECOVERY_PARENT_PHYSICAL=$(path_with_replaced_prefix "$REPORT_RECOVERY_PARENT_PHYSICAL" \
        "$previous_state_physical" "$STATE_ROOT_PHYSICAL") || return 74
    report_recovery_path_matches_pin && return 0
    info=$(locate_report_recovery_link) || info=''
    if [[ -z "$info" ]]; then
        REPORT_RECOVERY_PATH=''
        return 74
    fi
    IFS=$'\t' read -r actual parent_physical parent_identity <<<"$info"
    REPORT_RECOVERY_PATH=$actual
    REPORT_RECOVERY_PARENT_PHYSICAL=$parent_physical
    REPORT_RECOVERY_PARENT_IDENTITY=$parent_identity
    [[ "${actual##*/}" == "$expected_name" ]] || return 74
}

diagnose_report_recovery() {
    local info physical parent_physical parent_identity
    [[ -n "$REPORT_RECOVERY_IDENTITY" ]] || return 0
    if ! report_recovery_path_matches_pin; then
        info=$(locate_report_recovery_link) || info=''
        if [[ -n "$info" ]]; then
            IFS=$'\t' read -r REPORT_RECOVERY_PATH parent_physical parent_identity <<<"$info"
            REPORT_RECOVERY_PARENT_PHYSICAL=$parent_physical
            REPORT_RECOVERY_PARENT_IDENTITY=$parent_identity
        fi
    fi
    if report_recovery_path_matches_pin; then
        physical=$REPORT_RECOVERY_PATH
        printf '%s: REPORT_RECOVERY location=%s identity=%s\n' "$PROGRAM" "$physical" \
            "$REPORT_RECOVERY_IDENTITY" >&2
    else
        printf '%s: REPORT_RECOVERY path unavailable identity=%s\n' "$PROGRAM" \
            "$REPORT_RECOVERY_IDENTITY" >&2
    fi
}

append_report() {
    local record_type=$1 row partial_length partial
    [[ -n "$REPORT_PATH" ]] || return 0
    [[ "$REPORT_FD_OPEN" == 1 && "$REPORT_WRITE_FAILED" == 0 ]] || return 74
    state_cwd_matches_pin || return 74
    report_path_matches_pin || return 74
    row=$(printf '%s\t%s\t%s\t%s' "$1" "$2" "$3" "$4") || return 74
    install_test_hook report_after_handle_check "$record_type" "$REPORT_PATH" || return $?
    if [[ ${DOTFILES_TESTING:-0} == 1 && ${DOTFILES_TEST_REPORT_PARTIAL_TYPE:-} == "$record_type" ]]; then
        partial_length=$((${#row} / 2))
        [[ $partial_length -gt 0 ]] || partial_length=1
        partial=${row:0:$partial_length}
        printf '%s' "$partial" >&9 || true
        REPORT_WRITE_FAILED=1
        install_test_hook report_partial_write "$record_type" "$REPORT_PATH" || true
        return 74
    fi
    if ! printf '%s\n' "$row" >&9; then
        REPORT_WRITE_FAILED=1
        return 74
    fi
    REPORT_EXPECTED_ROW[$REPORT_EXPECTED_COUNT]=$row
    REPORT_EXPECTED_COUNT=$((REPORT_EXPECTED_COUNT + 1))
    report_path_matches_pin || return 74
}

expected_report_content() {
    local i
    for ((i=0; i<REPORT_EXPECTED_COUNT; i++)); do
        printf '%s\n' "${REPORT_EXPECTED_ROW[$i]}"
    done
}

verify_report_content_at() {
    local report_path=$1 expected_identity=$2 label=$3 identity expected_checksum actual_checksum line i=0
    [[ -f "$report_path" && ! -L "$report_path" ]] || {
        printf '%s: %s is not the pinned regular file\n' "$PROGRAM" "$label" >&2; return 74;
    }
    identity=$(path_identity "$report_path") || return 74
    [[ "$identity" == "$expected_identity" ]] || {
        printf '%s: %s identity changed\n' "$PROGRAM" "$label" >&2; return 74;
    }
    expected_checksum=$(expected_report_content | run_without_report_fd cksum) || return 74
    actual_checksum=$(run_without_report_fd cksum <"$report_path") || return 74
    [[ "$actual_checksum" == "$expected_checksum" ]] || {
        printf '%s: %s content changed\n' "$PROGRAM" "$label" >&2; return 74;
    }
    while IFS= read -r line; do
        [[ $i -lt $REPORT_EXPECTED_COUNT && "$line" == "${REPORT_EXPECTED_ROW[$i]}" ]] || return 74
        i=$((i + 1))
    done <"$report_path"
    [[ $i -eq $REPORT_EXPECTED_COUNT ]] || return 74
    identity=$(path_identity "$report_path") || return 74
    [[ "$identity" == "$expected_identity" ]]
}

verify_report_postcondition() {
    [[ -n "$REPORT_PATH" ]] || return 0
    [[ "$REPORT_FD_OPEN" == 1 && "$REPORT_WRITE_FAILED" == 0 ]] || return 74
    state_cwd_matches_pin || return 74
    report_path_matches_pin || return 74
    report_recovery_path_matches_pin || {
        printf '%s: backup report recovery link identity changed\n' "$PROGRAM" >&2; return 74;
    }
    verify_report_content_at "$REPORT_PATH" "$REPORT_IDENTITY" 'backup report' || return $?
    verify_report_content_at "$REPORT_RECOVERY_PATH" "$REPORT_RECOVERY_IDENTITY" \
        'backup report recovery link'
}

verify_report_recovery_postcondition() {
    [[ -n "$REPORT_RECOVERY_PATH" ]] || return 0
    [[ "$REPORT_FD_OPEN" == 1 && "$REPORT_WRITE_FAILED" == 0 ]] || return 74
    state_cwd_matches_pin || return 74
    report_recovery_path_matches_pin || return 74
    verify_report_content_at "$REPORT_RECOVERY_PATH" "$REPORT_RECOVERY_IDENTITY" \
        'backup report recovery link'
}

test_unlink_public_report_after_final_verification() {
    [[ ${DOTFILES_TESTING:-0} == 1 && ${DOTFILES_TEST_REPORT_FINAL_UNLINK:-0} == 1 ]] || return 0
    report_path_matches_pin && report_recovery_path_matches_pin || return 74
    run_without_report_fd /bin/unlink "$REPORT_PATH" || return 74
    [[ ! -e "$REPORT_PATH" && ! -L "$REPORT_PATH" ]]
}

journal_move() {
    local plan_index=$1 relative_path=$2 target_path=$3 backup_path=$4 fingerprint=$5 target_identity=$6
    local stage_path=$7 stage_relative=$8 parent_physical=$9 parent_identity=${10} i=$JOURNAL_COUNT
    JOURNAL_TYPE[$i]=MOVE
    JOURNAL_RELATIVE[$i]=$relative_path
    JOURNAL_FIRST[$i]=$target_path
    JOURNAL_SECOND[$i]=$backup_path
    JOURNAL_IDENTITY[$i]=$fingerprint
    JOURNAL_ORIGINAL_IDENTITY[$i]=$target_identity
    JOURNAL_AUX[$i]=$stage_path
    JOURNAL_AUX_RELATIVE[$i]=$stage_relative
    JOURNAL_PARENT_PHYSICAL[$i]=$parent_physical
    JOURNAL_PARENT_IDENTITY[$i]=$parent_identity
    JOURNAL_AUX_PARENT_PHYSICAL[$i]=$parent_physical
    JOURNAL_AUX_PARENT_IDENTITY[$i]=$parent_identity
    JOURNAL_AUX_IDENTITY[$i]=''
    JOURNAL_AUX_FINGERPRINT[$i]=''
    JOURNAL_PUBLICATION[$i]=''
    JOURNAL_PUBLICATION_RELATIVE[$i]=''
    JOURNAL_PUBLICATION_PARENT_PHYSICAL[$i]=''
    JOURNAL_PUBLICATION_PARENT_IDENTITY[$i]=''
    JOURNAL_PUBLICATION_IDENTITY[$i]=''
    JOURNAL_PUBLICATION_FINGERPRINT[$i]=''
    JOURNAL_UNOWNED[$i]=''
    JOURNAL_UNOWNED_PARENT_PHYSICAL[$i]=''
    JOURNAL_UNOWNED_PARENT_IDENTITY[$i]=''
    JOURNAL_UNOWNED_IDENTITY[$i]=''
    JOURNAL_UNOWNED_FINGERPRINT[$i]=''
    JOURNAL_UNOWNED_REPORTED[$i]=''
    JOURNAL_REPORT_SOURCE[$i]=$target_path
    JOURNAL_REPORT_LOCATION[$i]=''
    JOURNAL_PLAN_INDEX[$i]=$plan_index
    JOURNAL_COUNT=$((JOURNAL_COUNT + 1))
    append_report MOVE_INTENT "$relative_path" "$target_path" "$STATE_ROOT_PHYSICAL/$backup_path"
}

cancel_journal_move() {
    local journal_index=$1
    [[ "${JOURNAL_TYPE[$journal_index]}" == MOVE ]] || return 74
    JOURNAL_TYPE[$journal_index]=CANCELLED
    JOURNAL_AUX[$journal_index]=''
    JOURNAL_AUX_RELATIVE[$journal_index]=''
    JOURNAL_AUX_PARENT_PHYSICAL[$journal_index]=''
    JOURNAL_AUX_PARENT_IDENTITY[$journal_index]=''
    JOURNAL_AUX_IDENTITY[$journal_index]=''
    JOURNAL_AUX_FINGERPRINT[$journal_index]=''
}

journal_link() {
    local plan_index=$1 relative_path=$2 source=$3 target_path=$4 temp_path=$5 temp_relative=$6
    local parent_physical=$7 parent_identity=$8 i=$JOURNAL_COUNT
    JOURNAL_TYPE[$i]=LINK
    JOURNAL_RELATIVE[$i]=$relative_path
    JOURNAL_FIRST[$i]=$source
    JOURNAL_SECOND[$i]=$target_path
    JOURNAL_IDENTITY[$i]=''
    JOURNAL_ORIGINAL_IDENTITY[$i]=''
    JOURNAL_AUX[$i]=$temp_path
    JOURNAL_AUX_RELATIVE[$i]=$temp_relative
    JOURNAL_PARENT_PHYSICAL[$i]=$parent_physical
    JOURNAL_PARENT_IDENTITY[$i]=$parent_identity
    JOURNAL_AUX_PARENT_PHYSICAL[$i]=$parent_physical
    JOURNAL_AUX_PARENT_IDENTITY[$i]=$parent_identity
    JOURNAL_AUX_IDENTITY[$i]=''
    JOURNAL_AUX_FINGERPRINT[$i]=''
    JOURNAL_PUBLICATION[$i]=''
    JOURNAL_PUBLICATION_RELATIVE[$i]=''
    JOURNAL_PUBLICATION_PARENT_PHYSICAL[$i]=''
    JOURNAL_PUBLICATION_PARENT_IDENTITY[$i]=''
    JOURNAL_PUBLICATION_IDENTITY[$i]=''
    JOURNAL_PUBLICATION_FINGERPRINT[$i]=''
    JOURNAL_UNOWNED[$i]=''
    JOURNAL_UNOWNED_PARENT_PHYSICAL[$i]=''
    JOURNAL_UNOWNED_PARENT_IDENTITY[$i]=''
    JOURNAL_UNOWNED_IDENTITY[$i]=''
    JOURNAL_UNOWNED_FINGERPRINT[$i]=''
    JOURNAL_UNOWNED_REPORTED[$i]=''
    JOURNAL_REPORT_SOURCE[$i]=$source
    JOURNAL_REPORT_LOCATION[$i]=''
    JOURNAL_PLAN_INDEX[$i]=$plan_index
    JOURNAL_COUNT=$((JOURNAL_COUNT + 1))
    append_report LINK "$relative_path" "$source" "$target_path"
}

finalize_move_report() {
    local journal_index=$1 actual_backup_path=$2
    [[ "${JOURNAL_TYPE[$journal_index]}" == MOVE ]] || return 74
    [[ "${JOURNAL_REPORT_LOCATION[$journal_index]}" == "$actual_backup_path" ]] && return 0
    append_report MOVE_FINAL "${JOURNAL_RELATIVE[$journal_index]}" \
        "${JOURNAL_REPORT_SOURCE[$journal_index]}" "$actual_backup_path" || return $?
    JOURNAL_REPORT_LOCATION[$journal_index]=$actual_backup_path
}

report_unowned_location() {
    local journal_index=$1 location=$2 identity=${JOURNAL_UNOWNED_IDENTITY[$1]}
    [[ "${JOURNAL_UNOWNED_REPORTED[$journal_index]}" == "$location" ]] && return 0
    append_report UNOWNED_DISPLACED "${JOURNAL_RELATIVE[$journal_index]}" "$identity" "$location" || return $?
    JOURNAL_UNOWNED_REPORTED[$journal_index]=$location
}

record_unowned_move() {
    local journal_index=$1 kind=$2 path=$3 parent_physical=$4 parent_identity=$5 identity=$6 fingerprint=$7
    case "$kind" in
        UNOWNED_RESTORED)
            printf '%s: UNOWNED_RESTORED %s identity=%s location=%s\n' "$PROGRAM" \
                "${JOURNAL_RELATIVE[$journal_index]}" "$identity" "$path" >&2
            ;;
        UNOWNED_DISPLACED)
            JOURNAL_UNOWNED_IDENTITY[$journal_index]=$identity
            JOURNAL_UNOWNED_FINGERPRINT[$journal_index]=$fingerprint
            if [[ "$path" == - ]]; then
                JOURNAL_UNOWNED[$journal_index]=''
                JOURNAL_UNOWNED_PARENT_PHYSICAL[$journal_index]=''
                JOURNAL_UNOWNED_PARENT_IDENTITY[$journal_index]=''
                report_unowned_location "$journal_index" "UNAVAILABLE identity=$identity" || return $?
                printf '%s: UNOWNED_DISPLACED %s identity=%s recovery-path-unavailable\n' "$PROGRAM" \
                    "${JOURNAL_RELATIVE[$journal_index]}" "$identity" >&2
            else
                JOURNAL_UNOWNED[$journal_index]=$path
                JOURNAL_UNOWNED_PARENT_PHYSICAL[$journal_index]=$parent_physical
                JOURNAL_UNOWNED_PARENT_IDENTITY[$journal_index]=$parent_identity
                report_unowned_location "$journal_index" "$path" || return $?
                printf '%s: UNOWNED_DISPLACED %s identity=%s location=%s\n' "$PROGRAM" \
                    "${JOURNAL_RELATIVE[$journal_index]}" "$identity" "$path" >&2
            fi
            ;;
        *) return 74 ;;
    esac
}

set_journal_link_identity() {
    JOURNAL_IDENTITY[$1]=$2
}

set_journal_aux_location() {
    JOURNAL_AUX[$1]=$2
    JOURNAL_AUX_RELATIVE[$1]=$3
    JOURNAL_AUX_PARENT_PHYSICAL[$1]=$4
    JOURNAL_AUX_PARENT_IDENTITY[$1]=$5
    JOURNAL_AUX_IDENTITY[$1]=$6
    JOURNAL_AUX_FINGERPRINT[$1]=$7
    if [[ "${JOURNAL_TYPE[$1]}" == MOVE ]]; then
        JOURNAL_FIRST[$1]="$8/${JOURNAL_RELATIVE[$1]##*/}"
        JOURNAL_PARENT_PHYSICAL[$1]=$8
        JOURNAL_PARENT_IDENTITY[$1]=$9
    fi
}

set_journal_publication_location() {
    JOURNAL_PUBLICATION[$1]=$2
    JOURNAL_PUBLICATION_RELATIVE[$1]=$3
    JOURNAL_PUBLICATION_PARENT_PHYSICAL[$1]=$4
    JOURNAL_PUBLICATION_PARENT_IDENTITY[$1]=$5
    JOURNAL_PUBLICATION_IDENTITY[$1]=$6
    JOURNAL_PUBLICATION_FINGERPRINT[$1]=$7
    JOURNAL_AUX[$1]=''
    JOURNAL_AUX_RELATIVE[$1]=''
    JOURNAL_AUX_PARENT_PHYSICAL[$1]=''
    JOURNAL_AUX_PARENT_IDENTITY[$1]=''
    JOURNAL_AUX_IDENTITY[$1]=''
    JOURNAL_AUX_FINGERPRINT[$1]=''
    case "${JOURNAL_TYPE[$1]}" in
        MOVE)
            PLAN_BACKUP_PATH[${JOURNAL_PLAN_INDEX[$1]}]=$2
            PLAN_BACKUP_PARENT_PHYSICAL[${JOURNAL_PLAN_INDEX[$1]}]=$4
            PLAN_BACKUP_PARENT_IDENTITY[${JOURNAL_PLAN_INDEX[$1]}]=$5
            PLAN_BACKUP_IDENTITY[${JOURNAL_PLAN_INDEX[$1]}]=$6
            PLAN_BACKUP_FINGERPRINT[${JOURNAL_PLAN_INDEX[$1]}]=$7
            ;;
        LINK) PLAN_PUBLISHED_IDENTITY[${JOURNAL_PLAN_INDEX[$1]}]=$6 ;;
    esac
}

mark_journal_publication_unavailable() {
    local journal_index=$1 plan_index=${JOURNAL_PLAN_INDEX[$1]}
    JOURNAL_PUBLICATION[$journal_index]=''
    JOURNAL_PUBLICATION_RELATIVE[$journal_index]=''
    JOURNAL_PUBLICATION_PARENT_PHYSICAL[$journal_index]=''
    JOURNAL_PUBLICATION_PARENT_IDENTITY[$journal_index]=''
    if [[ "${JOURNAL_TYPE[$journal_index]}" == MOVE ]]; then
        PLAN_BACKUP_PATH[$plan_index]=''
        PLAN_BACKUP_PARENT_PHYSICAL[$plan_index]=''
        PLAN_BACKUP_PARENT_IDENTITY[$plan_index]=''
        finalize_move_report "$journal_index" "UNAVAILABLE identity=${JOURNAL_PUBLICATION_IDENTITY[$journal_index]}"
    fi
}

mark_journal_aux_unavailable() {
    JOURNAL_AUX[$1]=''
    JOURNAL_AUX_RELATIVE[$1]=''
    JOURNAL_AUX_PARENT_PHYSICAL[$1]=''
    JOURNAL_AUX_PARENT_IDENTITY[$1]=''
}

locate_owned_artifact_from_cwd() {
    local expected_name=$1 expected_parent_identity=$2 expected_identity=$3 expected_fingerprint=$4
    local fingerprint_mode=${5:-owned} current_parent current_parent_identity candidate candidate_name
    local observed_fingerprint match='' match_count=0
    current_parent=$(run_without_report_fd /bin/pwd -P) || return 1
    current_parent_identity=$(path_identity .) || return 1
    [[ "$current_parent_identity" == "$expected_parent_identity" ]] || return 1
    if [[ "$fingerprint_mode" == move ]]; then
        observed_fingerprint=$(move_artifact_fingerprint "$expected_name" 2>/dev/null || true)
    else
        observed_fingerprint=$(path_fingerprint "$expected_name" 2>/dev/null || true)
    fi
    if [[ ( -e "$expected_name" || -L "$expected_name" ) && \
        "$(path_identity "$expected_name" 2>/dev/null || true)" == "$expected_identity" && \
        "$observed_fingerprint" == "$expected_fingerprint" ]]; then
        printf '%s\t%s\t%s\t%s\n' "$current_parent/$expected_name" "$current_parent" \
            "$current_parent_identity" "$expected_name"
        return 0
    fi
    shopt -s dotglob nullglob
    for candidate in ./*; do
        [[ -e "$candidate" || -L "$candidate" ]] || continue
        [[ "$(path_identity "$candidate" 2>/dev/null || true)" == "$expected_identity" ]] || continue
        if [[ "$fingerprint_mode" == move ]]; then
            observed_fingerprint=$(move_artifact_fingerprint "$candidate" 2>/dev/null || true)
        else
            observed_fingerprint=$(path_fingerprint "$candidate" 2>/dev/null || true)
        fi
        [[ "$observed_fingerprint" == "$expected_fingerprint" ]] || continue
        candidate_name=${candidate#./}
        match=$candidate_name
        match_count=$((match_count + 1))
    done
    [[ $match_count -eq 1 ]] || return 1
    printf '%s\t%s\t%s\t%s\n' "$current_parent/$match" "$current_parent" "$current_parent_identity" "$match"
}

locate_recorded_artifact() (
    local path=$1 expected_parent_physical=$2 expected_parent_identity=$3 expected_identity=$4 expected_fingerprint=$5
    local fingerprint_mode=${6:-owned} name
    [[ -n "$path" && -n "$expected_parent_physical" && -n "$expected_parent_identity" && \
        -n "$expected_identity" && -n "$expected_fingerprint" ]] || return 1
    pin_rollback_target_parent "$path" "$path" "$expected_parent_physical" "$expected_parent_identity" 1 || return 1
    name=${path##*/}
    locate_owned_artifact_from_cwd "$name" "$expected_parent_identity" "$expected_identity" \
        "$expected_fingerprint" "$fingerprint_mode"
)

run_artifact_hook_with_refresh() (
    local event=$1 path=$2 expected_parent_physical=$3 expected_parent_identity=$4
    local expected_identity=$5 expected_fingerprint=$6
    shift 6
    local name hook_status=0 location location_status actual actual_parent actual_parent_identity actual_name
    arm_subshell_signal_forwarding
    pin_rollback_target_parent "$path" "$path" "$expected_parent_physical" "$expected_parent_identity" 1 || return 74
    name=${path##*/}
    [[ "$(path_identity "$name" 2>/dev/null || true)" == "$expected_identity" ]] || return 74
    [[ "$(path_fingerprint "$name" 2>/dev/null || true)" == "$expected_fingerprint" ]] || return 74
    install_test_hook "$event" "$@" || hook_status=$?
    location=$(locate_owned_artifact_from_cwd "$name" "$expected_parent_identity" \
        "$expected_identity" "$expected_fingerprint")
    location_status=$?
    if [[ $location_status -eq 0 ]]; then
        IFS=$'\t' read -r actual actual_parent actual_parent_identity actual_name <<<"$location"
        printf 'KNOWN\t%s\t%s\t%s\t%s\t%s\n' "$actual" "$actual_parent" "$actual_parent_identity" \
            "$expected_identity" "$expected_fingerprint"
    else
        printf 'UNAVAILABLE\t-\t-\t-\t%s\t%s\n' "$expected_identity" "$expected_fingerprint"
    fi
    [[ $hook_status -eq 0 ]] || return "$hook_status"
    [[ $location_status -eq 0 && "$actual_name" == "$name" ]] || return 74
)

path_with_replaced_prefix() {
    local path=$1 old_prefix=$2 new_prefix=$3
    case "$path" in
        "$old_prefix") printf '%s\n' "$new_prefix" ;;
        "$old_prefix"/*) printf '%s%s\n' "$new_prefix" "${path#"$old_prefix"}" ;;
        *) printf '%s\n' "$path" ;;
    esac
}

refresh_journal_locations_after_hook() {
    local previous_state_physical=$1 i info actual actual_parent actual_parent_identity actual_name
    local publication_path aux_path unowned_path expected_name status=0
    refresh_state_physical_from_cwd || return 74
    refresh_report_recovery_location "$previous_state_physical" || status=74
    for ((i=0; i<JOURNAL_COUNT; i++)); do
        publication_path=${JOURNAL_PUBLICATION[$i]}
        if [[ -n "$publication_path" ]]; then
            publication_path=$(path_with_replaced_prefix "$publication_path" "$previous_state_physical" "$STATE_ROOT_PHYSICAL") || return 74
            JOURNAL_PUBLICATION[$i]=$publication_path
            JOURNAL_PUBLICATION_PARENT_PHYSICAL[$i]=$(path_with_replaced_prefix \
                "${JOURNAL_PUBLICATION_PARENT_PHYSICAL[$i]}" "$previous_state_physical" "$STATE_ROOT_PHYSICAL") || return 74
        fi
        aux_path=${JOURNAL_AUX[$i]}
        if [[ -n "$aux_path" ]]; then
            aux_path=$(path_with_replaced_prefix "$aux_path" "$previous_state_physical" "$STATE_ROOT_PHYSICAL") || return 74
            JOURNAL_AUX[$i]=$aux_path
            JOURNAL_AUX_PARENT_PHYSICAL[$i]=$(path_with_replaced_prefix "${JOURNAL_AUX_PARENT_PHYSICAL[$i]}" \
                "$previous_state_physical" "$STATE_ROOT_PHYSICAL") || return 74
        fi
        unowned_path=${JOURNAL_UNOWNED[$i]}
        if [[ -n "$unowned_path" ]]; then
            unowned_path=$(path_with_replaced_prefix "$unowned_path" "$previous_state_physical" "$STATE_ROOT_PHYSICAL") || return 74
            JOURNAL_UNOWNED[$i]=$unowned_path
            JOURNAL_UNOWNED_PARENT_PHYSICAL[$i]=$(path_with_replaced_prefix \
                "${JOURNAL_UNOWNED_PARENT_PHYSICAL[$i]}" "$previous_state_physical" "$STATE_ROOT_PHYSICAL") || return 74
        fi

        if [[ -n "${JOURNAL_PUBLICATION_IDENTITY[$i]}" ]]; then
            expected_name=${JOURNAL_PUBLICATION[$i]##*/}
            info=$(locate_recorded_artifact "${JOURNAL_PUBLICATION[$i]}" \
                "${JOURNAL_PUBLICATION_PARENT_PHYSICAL[$i]}" "${JOURNAL_PUBLICATION_PARENT_IDENTITY[$i]}" \
                "${JOURNAL_PUBLICATION_IDENTITY[$i]}" "${JOURNAL_PUBLICATION_FINGERPRINT[$i]}") || info=''
            if [[ -n "$info" ]]; then
                IFS=$'\t' read -r actual actual_parent actual_parent_identity actual_name <<<"$info"
                [[ "$actual_name" == "$expected_name" ]] || status=74
                set_journal_publication_location "$i" "$actual" "${JOURNAL_RELATIVE[$i]}" "$actual_parent" \
                    "$actual_parent_identity" "${JOURNAL_PUBLICATION_IDENTITY[$i]}" \
                    "${JOURNAL_PUBLICATION_FINGERPRINT[$i]}"
                if [[ "${JOURNAL_TYPE[$i]}" == MOVE ]]; then
                    finalize_move_report "$i" "$actual" || return $?
                fi
            else
                mark_journal_publication_unavailable "$i" || return $?
                status=74
            fi
        fi

        if [[ -n "${JOURNAL_AUX_IDENTITY[$i]}" && -n "${JOURNAL_AUX[$i]}" ]]; then
            expected_name=${JOURNAL_AUX[$i]##*/}
            info=$(locate_recorded_artifact "${JOURNAL_AUX[$i]}" "${JOURNAL_AUX_PARENT_PHYSICAL[$i]}" \
                "${JOURNAL_AUX_PARENT_IDENTITY[$i]}" "${JOURNAL_AUX_IDENTITY[$i]}" \
                "${JOURNAL_AUX_FINGERPRINT[$i]}") || info=''
            if [[ -n "$info" ]]; then
                IFS=$'\t' read -r actual actual_parent actual_parent_identity actual_name <<<"$info"
                [[ "$actual_name" == "$expected_name" ]] || status=74
                JOURNAL_AUX[$i]=$actual
                JOURNAL_AUX_PARENT_PHYSICAL[$i]=$actual_parent
                JOURNAL_AUX_PARENT_IDENTITY[$i]=$actual_parent_identity
            else
                mark_journal_aux_unavailable "$i"
                status=74
            fi
        fi

        if [[ -n "${JOURNAL_UNOWNED_IDENTITY[$i]}" && -n "${JOURNAL_UNOWNED[$i]}" ]]; then
            info=$(locate_recorded_artifact "${JOURNAL_UNOWNED[$i]}" \
                "${JOURNAL_UNOWNED_PARENT_PHYSICAL[$i]}" "${JOURNAL_UNOWNED_PARENT_IDENTITY[$i]}" \
                "${JOURNAL_UNOWNED_IDENTITY[$i]}" "${JOURNAL_UNOWNED_FINGERPRINT[$i]}" move) || info=''
            if [[ -n "$info" ]]; then
                IFS=$'\t' read -r actual actual_parent actual_parent_identity actual_name <<<"$info"
                JOURNAL_UNOWNED[$i]=$actual
                JOURNAL_UNOWNED_PARENT_PHYSICAL[$i]=$actual_parent
                JOURNAL_UNOWNED_PARENT_IDENTITY[$i]=$actual_parent_identity
                report_unowned_location "$i" "$actual" || return $?
            else
                JOURNAL_UNOWNED[$i]=''
                JOURNAL_UNOWNED_PARENT_PHYSICAL[$i]=''
                JOURNAL_UNOWNED_PARENT_IDENTITY[$i]=''
                report_unowned_location "$i" "UNAVAILABLE identity=${JOURNAL_UNOWNED_IDENTITY[$i]}" || return $?
                status=74
            fi
        fi
    done
    return "$status"
}

run_journal_aux_hook_boundary() {
    local journal_index=$1 event=$2
    shift 2
    local path=${JOURNAL_AUX[$journal_index]} parent_physical=${JOURNAL_AUX_PARENT_PHYSICAL[$journal_index]}
    local parent_identity=${JOURNAL_AUX_PARENT_IDENTITY[$journal_index]} identity=${JOURNAL_AUX_IDENTITY[$journal_index]}
    local fingerprint=${JOURNAL_AUX_FINGERPRINT[$journal_index]} previous_state_physical=$STATE_ROOT_PHYSICAL
    local info hook_status location actual actual_parent actual_parent_identity actual_identity actual_fingerprint
    local restore_parent_physical=${JOURNAL_PARENT_PHYSICAL[$journal_index]}
    local restore_parent_identity=${JOURNAL_PARENT_IDENTITY[$journal_index]} refresh_status=0
    [[ -n "$path" && -n "$parent_physical" && -n "$parent_identity" && -n "$identity" && -n "$fingerprint" ]] || return 74
    info=$(run_artifact_hook_with_refresh "$event" "$path" "$parent_physical" "$parent_identity" \
        "$identity" "$fingerprint" "$@")
    hook_status=$?
    IFS=$'\t' read -r location actual actual_parent actual_parent_identity actual_identity actual_fingerprint <<<"$info"
    if [[ "$location" == KNOWN ]]; then
        if [[ "${JOURNAL_TYPE[$journal_index]}" == MOVE && "$restore_parent_identity" == "$parent_identity" ]]; then
            restore_parent_physical=$actual_parent
            restore_parent_identity=$actual_parent_identity
        fi
        set_journal_aux_location "$journal_index" "$actual" "${JOURNAL_AUX_RELATIVE[$journal_index]}" \
            "$actual_parent" "$actual_parent_identity" "$actual_identity" "$actual_fingerprint" \
            "$restore_parent_physical" "$restore_parent_identity"
    else
        mark_journal_aux_unavailable "$journal_index"
    fi
    refresh_journal_locations_after_hook "$previous_state_physical" || refresh_status=$?
    honor_pending_signal || return $?
    [[ $hook_status -eq 0 ]] || return "$hook_status"
    [[ $refresh_status -eq 0 ]] || return "$refresh_status"
}

sibling_relative_path() {
    local relative_path=$1 sibling_name=$2 parent
    parent=${relative_path%/*}
    if [[ "$parent" == "$relative_path" ]]; then
        printf '%s\n' "$sibling_name"
    else
        printf '%s/%s\n' "$parent" "$sibling_name"
    fi
}

after_transaction_mutation() {
    MUTATION_COUNT=$((MUTATION_COUNT + 1))
    if [[ ${DOTFILES_TESTING:-0} == 1 && -n "$TEST_FAIL_AFTER" && "$MUTATION_COUNT" -eq "$TEST_FAIL_AFTER" ]]; then
        printf '%s: injected transaction failure after mutation %s\n' "$PROGRAM" "$MUTATION_COUNT" >&2
        return 70
    fi
}

prepare_install_parent() {
    local relative_path=$1 expected_root=$2 component physical parent_physical i
    local components=()

    install_root_name_matches_pin && pinned_install_names_match || return 1
    install_test_hook before_prepare_parent "$EFFECTIVE_HOME" || return 1
    install_root_name_matches_pin && pinned_install_names_match || return 1
    cd -P -- "$EFFECTIVE_HOME" || return 1
    physical=$(pwd -P) || return 1
    [[ "$physical" == "$expected_root" ]] || return 1
    [[ "$(path_identity .)" == "$INSTALL_ROOT_IDENTITY" ]] || return 1
    TARGET_ROOT_PHYSICAL=$expected_root

    IFS=/ read -r -a components <<<"$relative_path"
    for ((i=0; i<${#components[@]}-1; i++)); do
        component=${components[$i]}
        pinned_install_names_match || return 1
        [[ ! -L "$component" ]] || return 1
        if [[ -e "$component" ]]; then
            [[ -d "$component" ]] || return 1
        else
            run_without_report_fd mkdir -- "$component" || return 1
        fi
        [[ -d "$component" && ! -L "$component" ]] || return 1
        parent_physical=$(pwd -P) || return 1
        cd -P -- "$component" || return 1
        physical=$(pwd -P) || return 1
        [[ "$physical" == "$parent_physical/$component" ]] || return 1
        path_within "$physical" "$TARGET_ROOT_PHYSICAL" || return 1
        pinned_install_names_match || return 1
    done
}

pin_existing_install_parent() {
    local relative_path=$1 expected_root=$2 component physical parent_physical i
    local components=()

    install_root_name_matches_pin && pinned_install_names_match || return 1
    cd -P -- "$EFFECTIVE_HOME" || return 1
    physical=$(pwd -P) || return 1
    [[ "$physical" == "$expected_root" ]] || return 1
    [[ "$(path_identity .)" == "$INSTALL_ROOT_IDENTITY" ]] || return 1
    TARGET_ROOT_PHYSICAL=$expected_root

    IFS=/ read -r -a components <<<"$relative_path"
    for ((i=0; i<${#components[@]}-1; i++)); do
        component=${components[$i]}
        [[ -d "$component" && ! -L "$component" ]] || return 1
        parent_physical=$(pwd -P) || return 1
        cd -P -- "$component" || return 1
        physical=$(pwd -P) || return 1
        [[ "$physical" == "$parent_physical/$component" ]] || return 1
        path_within "$physical" "$TARGET_ROOT_PHYSICAL" || return 1
        pinned_install_names_match || return 1
    done
}

publication_parent_matches_pin() {
    local target_path=$1 expected_physical=$2 expected_identity=$3 named_parent physical identity named_physical named_identity
    install_root_name_matches_pin && pinned_install_names_match || return 1
    physical=$(pwd -P) || return 1
    identity=$(path_identity .) || return 1
    if [[ -n "$expected_physical" || -n "$expected_identity" ]]; then
        [[ "$physical" == "$expected_physical" && "$identity" == "$expected_identity" ]] || return 1
    fi
    named_parent=${target_path%/*}
    [[ -d "$named_parent" && ! -L "$named_parent" ]] || return 1
    named_physical=$(physical_dir "$named_parent") || return 1
    named_identity=$(path_identity "$named_parent") || return 1
    [[ "$named_physical" == "$physical" && "$named_identity" == "$identity" ]] || return 1
    path_within "$physical" "$INSTALL_ROOT_PHYSICAL"
}

pin_apply_target_parent() {
    local source=$1 target_path=$2 relative_path=$3 prepare=$4
    local expected_parent_physical=${5:-} expected_parent_identity=${6:-} expected_root
    TARGET_RELATIVE_PATH=$relative_path
    safe_source "$source" || return 65
    TARGET_ROOT_PHYSICAL=''
    safe_target "$target_path" || return 65
    expected_root=$TARGET_ROOT_PHYSICAL
    [[ -n "$expected_root" ]] || return 65
    if [[ "$prepare" == 1 ]]; then
        prepare_install_parent "$relative_path" "$expected_root" || return 65
    else
        pin_existing_install_parent "$relative_path" "$expected_root" || return 65
    fi
    safe_target "$target_path" || return 65
    safe_source "$source" || return 65
    publication_parent_matches_pin "$target_path" "$expected_parent_physical" "$expected_parent_identity" || return 65
}

inspect_install_entry() (
    local action=$1 source=$2 target_path=$3 relative_path=$4 observed target_name fingerprint target_identity physical identity
    pin_apply_target_parent "$source" "$target_path" "$relative_path" 1 || return $?
    observed=$(artifact_status "$source" "$target_path")
    case "$action:$observed" in
        CREATE:MISSING) fingerprint='-'; target_identity='-' ;;
        BACKUP:DRIFT|BACKUP:MATCH|BACKUP:FOREIGN_LINK)
            target_name=${relative_path##*/}
            target_identity=$(path_identity "$target_name") || return 65
            fingerprint=$(path_fingerprint "$target_name") || return 65
            ;;
        *) return 65 ;;
    esac
    publication_parent_matches_pin "$target_path" '' '' || return 65
    physical=$(pwd -P) || return 65
    identity=$(path_identity .) || return 65
    printf '%s\t%s\t%s\t%s\n' "$fingerprint" "$target_identity" "$physical" "$identity"
)

stage_backup_target() (
    local source=$1 target_path=$2 relative_path=$3 stage_path=$4 recovery_path=$5 expected_fingerprint=$6
    local expected_target_identity=$7 expected_parent_physical=$8 expected_parent_identity=$9
    local target_name stage_name recovery_name observed nested recovery_nested actual actual_name stage_status
    local artifact_identity artifact_fingerprint immediate_parent_physical immediate_parent_identity
    local current_parent_physical current_parent_identity restore_parent_physical restore_parent_identity hook_status=0
    local unowned_info
    arm_subshell_signal_forwarding
    pin_apply_target_parent "$source" "$target_path" "$relative_path" 0 "$expected_parent_physical" "$expected_parent_identity" || return $?
    observed=$(artifact_status "$source" "$target_path")
    case "$observed" in DRIFT|MATCH|FOREIGN_LINK) ;; *) return 65 ;; esac
    target_name=${relative_path##*/}
    stage_name=${stage_path##*/}
    recovery_name=${recovery_path##*/}
    [[ ! -e "$stage_name" && ! -L "$stage_name" && ! -e "$recovery_name" && ! -L "$recovery_name" ]] || return 74
    [[ "$(path_identity "$target_name" 2>/dev/null || true)" == "$expected_target_identity" ]] || return 65
    [[ "$(path_fingerprint "$target_name" 2>/dev/null || true)" == "$expected_fingerprint" ]] || return 65
    install_test_hook before_backup_stage "$target_path" "$stage_path" "$recovery_path" || return $?
    publication_parent_matches_pin "$target_path" "$expected_parent_physical" "$expected_parent_identity" || return 65
    [[ "$(path_identity "$target_name" 2>/dev/null || true)" == "$expected_target_identity" ]] || return 65
    [[ "$(path_fingerprint "$target_name" 2>/dev/null || true)" == "$expected_fingerprint" ]] || return 65
    move_no_clobber_exact "$target_name" "$stage_name" backup_target_stage || {
        if [[ "$MOVE_RESULT_AMBIGUOUS" == 1 && \
            "$(path_identity "$target_name" 2>/dev/null || true)" == "$expected_target_identity" && \
            "$(path_fingerprint "$target_name" 2>/dev/null || true)" == "$expected_fingerprint" ]]; then
            printf 'CANCELLED\n'
        fi
        return 74
    }
    if [[ "$MOVE_RESULT_IDENTITY" != "$expected_target_identity" || \
        "$MOVE_RESULT_FINGERPRINT" != "$expected_fingerprint" ]]; then
        unowned_info=$(recover_unowned_displaced "$target_name") || return 74
        printf '%s\n' "$unowned_info"
        return 74
    fi
    actual=''
    stage_status=0
    if [[ "$(path_identity "$stage_name" 2>/dev/null || true)" == "$expected_target_identity" && \
        "$(path_fingerprint "$stage_name" 2>/dev/null || true)" == "$expected_fingerprint" ]]; then
        actual="$(run_without_report_fd /bin/pwd -P)/$stage_name"
    elif [[ -d "$stage_name" && ! -L "$stage_name" ]]; then
        nested="$stage_name/$target_name"
        if [[ "$(path_identity "$nested" 2>/dev/null || true)" == "$expected_target_identity" && \
            "$(path_fingerprint "$nested" 2>/dev/null || true)" == "$expected_fingerprint" ]]; then
            move_no_clobber_exact "$nested" "$recovery_name" || true
            recovery_nested="$recovery_name/$target_name"
            if [[ "$(path_identity "$nested" 2>/dev/null || true)" == "$expected_target_identity" && \
                "$(path_fingerprint "$nested" 2>/dev/null || true)" == "$expected_fingerprint" ]]; then
                actual="$(run_without_report_fd /bin/pwd -P)/$nested"
            elif [[ "$(path_identity "$recovery_nested" 2>/dev/null || true)" == "$expected_target_identity" && \
                "$(path_fingerprint "$recovery_nested" 2>/dev/null || true)" == "$expected_fingerprint" ]]; then
                actual="$(run_without_report_fd /bin/pwd -P)/$recovery_nested"
            elif [[ "$(path_identity "$recovery_name" 2>/dev/null || true)" == "$expected_target_identity" && \
                "$(path_fingerprint "$recovery_name" 2>/dev/null || true)" == "$expected_fingerprint" ]]; then
                actual="$(run_without_report_fd /bin/pwd -P)/$recovery_name"
            fi
        fi
        stage_status=74
    else
        stage_status=74
    fi
    [[ -n "$actual" ]] || return 74
    actual_name=${actual##*/}
    cd -P -- "${actual%/*}" || return 74
    immediate_parent_physical=$(run_without_report_fd /bin/pwd -P) || return 74
    immediate_parent_identity=$(path_identity .) || return 74
    artifact_identity=$(path_identity "$actual_name") || return 74
    artifact_fingerprint=$(path_fingerprint "$actual_name") || return 74
    [[ "$artifact_identity" == "$expected_target_identity" && "$artifact_fingerprint" == "$expected_fingerprint" ]] || return 74
    install_test_hook backup_stage_after_move "$target_path" "$immediate_parent_physical/$actual_name" \
        "$artifact_identity" "$EFFECTIVE_HOME" || hook_status=$?
    current_parent_physical=$(run_without_report_fd /bin/pwd -P 2>/dev/null) || current_parent_physical=$immediate_parent_physical
    current_parent_identity=$(path_identity . 2>/dev/null) || current_parent_identity=$immediate_parent_identity
    actual="$current_parent_physical/$actual_name"
    if [[ $stage_status -eq 0 ]]; then
        restore_parent_physical=$current_parent_physical
        restore_parent_identity=$current_parent_identity
    else
        restore_parent_physical=$expected_parent_physical
        restore_parent_identity=$expected_parent_identity
    fi
    printf 'OWNED\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$actual" "$current_parent_physical" "$current_parent_identity" \
        "$artifact_identity" "$artifact_fingerprint" "$restore_parent_physical" "$restore_parent_identity"
    [[ $hook_status -eq 0 ]] || return "$hook_status"
    [[ "$current_parent_physical" == "$immediate_parent_physical" && \
        "$current_parent_identity" == "$immediate_parent_identity" ]] || return 74
    [[ "$(path_identity "$actual_name" 2>/dev/null || true)" == "$artifact_identity" ]] || return 74
    [[ "$(path_fingerprint "$actual_name" 2>/dev/null || true)" == "$artifact_fingerprint" ]] || return 74
    [[ "$artifact_fingerprint" == "$expected_fingerprint" ]] || return 74
    if [[ $stage_status -eq 0 ]]; then
        publication_parent_matches_pin "$target_path" "$expected_parent_physical" "$expected_parent_identity" || return 74
        [[ ! -e "$target_name" && ! -L "$target_name" ]] || return 74
    fi
    return "$stage_status"
)

move_staged_backup() (
    local target_path=$1 stage_path=$2 backup_path=$3 expected_fingerprint=$4 expected_stage_identity=$5
    local stage_name backup_name container_path root_physical stage_identity actual actual_name
    local artifact_identity artifact_fingerprint immediate_parent_physical immediate_parent_identity
    local current_parent_physical current_parent_identity status=0 hook_status=0 unowned_info
    arm_subshell_signal_forwarding
    stage_name=${stage_path##*/}
    state_cwd_matches_pin || return 74
    refresh_state_physical_from_cwd || return $?
    root_physical=$(run_without_report_fd /bin/pwd -P) || return 74
    stage_identity=$(path_identity "$stage_path") || return 74
    [[ "$stage_identity" == "$expected_stage_identity" ]] || return 74
    [[ "$(path_fingerprint "$stage_path" 2>/dev/null || true)" == "$expected_fingerprint" ]] || return 74
    cd -P -- "${backup_path%/*}" || return 74
    path_within "$(run_without_report_fd /bin/pwd -P)" "$root_physical" || return 74
    backup_name=${backup_path##*/}
    move_no_clobber_exact "$stage_path" "$backup_name" backup_stage_publish || return 74
    if [[ "$MOVE_RESULT_IDENTITY" != "$expected_stage_identity" || \
        "$MOVE_RESULT_FINGERPRINT" != "$expected_fingerprint" ]]; then
        unowned_info=$(recover_unowned_displaced "$stage_path") || return 74
        printf '%s\n' "$unowned_info"
        return 74
    fi
    actual=''
    if [[ ( -f "$backup_name" || -L "$backup_name" ) && \
        "$(path_identity "$backup_name" 2>/dev/null || true)" == "$stage_identity" ]]; then
        actual="$(run_without_report_fd /bin/pwd -P)/$backup_name"
    elif [[ -d "$backup_name" && ! -L "$backup_name" ]]; then
        container_path="$backup_name/$stage_name"
        if [[ ( -f "$container_path" || -L "$container_path" ) && \
            "$(path_identity "$container_path" 2>/dev/null || true)" == "$stage_identity" ]]; then
            actual="$(run_without_report_fd /bin/pwd -P)/$container_path"
        fi
        status=74
    elif [[ ( -f "$stage_path" || -L "$stage_path" ) && \
        "$(path_identity "$stage_path" 2>/dev/null || true)" == "$stage_identity" ]]; then
        return 74
    else
        return 74
    fi
    [[ -n "$actual" ]] || return 74
    actual_name=${actual##*/}
    cd -P -- "${actual%/*}" || return 74
    immediate_parent_physical=$(run_without_report_fd /bin/pwd -P) || return 74
    immediate_parent_identity=$(path_identity .) || return 74
    artifact_identity=$(path_identity "$actual_name") || return 74
    artifact_fingerprint=$(path_fingerprint "$actual_name") || return 74
    install_test_hook backup_publish_after_move "$target_path" "$immediate_parent_physical/$actual_name" \
        "$artifact_identity" "$STATE_ROOT" || hook_status=$?
    current_parent_physical=$(run_without_report_fd /bin/pwd -P 2>/dev/null) || current_parent_physical=$immediate_parent_physical
    current_parent_identity=$(path_identity . 2>/dev/null) || current_parent_identity=$immediate_parent_identity
    actual="$current_parent_physical/$actual_name"
    printf 'OWNED\t%s\t%s\t%s\t%s\t%s\n' "$actual" "$current_parent_physical" "$current_parent_identity" \
        "$artifact_identity" "$artifact_fingerprint"
    [[ $hook_status -eq 0 ]] || return "$hook_status"
    [[ "$current_parent_physical" == "$immediate_parent_physical" && \
        "$current_parent_identity" == "$immediate_parent_identity" ]] || return 74
    [[ "$(path_identity "$actual_name" 2>/dev/null || true)" == "$artifact_identity" ]] || return 74
    [[ "$(path_fingerprint "$actual_name" 2>/dev/null || true)" == "$artifact_fingerprint" ]] || return 74
    [[ "$artifact_fingerprint" == "$expected_fingerprint" ]] || return 74
    [[ $status -eq 0 ]] || return "$status"
)

create_link_temp() (
    local source=$1 target_path=$2 relative_path=$3 temp_path=$4 expected_parent_physical=$5 expected_parent_identity=$6
    local target_name temp_name identity
    arm_subshell_signal_forwarding
    pin_apply_target_parent "$source" "$target_path" "$relative_path" 0 "$expected_parent_physical" "$expected_parent_identity" || return $?
    target_name=${relative_path##*/}
    temp_name=${temp_path##*/}
    [[ ! -e "$target_name" && ! -L "$target_name" && ! -e "$temp_name" && ! -L "$temp_name" ]] || return 65
    install_test_hook before_link_temp "$target_path" "$temp_path" || return $?
    honor_pending_signal || return $?
    publication_parent_matches_pin "$target_path" "$expected_parent_physical" "$expected_parent_identity" || return 65
    [[ ! -e "$target_name" && ! -L "$target_name" && ! -e "$temp_name" && ! -L "$temp_name" ]] || return 65
    safe_source "$source" || return 65
    run_without_report_fd ln -s -- "$source" "$temp_name" || return 74
    publication_parent_matches_pin "$target_path" "$expected_parent_physical" "$expected_parent_identity" || return 74
    [[ -L "$temp_name" && "$(run_without_report_fd readlink "$temp_name")" == "$source" ]] || return 65
    identity=$(path_identity "$temp_name") || return 65
    printf '%s\n' "$identity"
)

publish_link_temp() (
    local source=$1 target_path=$2 relative_path=$3 temp_path=$4 expected_identity=$5 recovery_hint=$6
    local expected_parent_physical=$7 expected_parent_identity=$8
    local target_name temp_name container_path actual actual_name artifact_identity artifact_fingerprint
    local immediate_parent_physical immediate_parent_identity current_parent_physical current_parent_identity
    local status hook_status=0 temp_location temp_actual temp_parent temp_parent_identity temp_actual_name unowned_info
    arm_subshell_signal_forwarding
    pin_apply_target_parent "$source" "$target_path" "$relative_path" 0 "$expected_parent_physical" "$expected_parent_identity" || return $?
    target_name=${relative_path##*/}
    temp_name=${temp_path##*/}
    [[ -L "$temp_name" && "$(run_without_report_fd readlink "$temp_name")" == "$source" ]] || return 65
    [[ "$(path_identity "$temp_name")" == "$expected_identity" ]] || return 65
    [[ ! -e "$target_name" && ! -L "$target_name" ]] || return 65
    publication_parent_matches_pin "$target_path" "$expected_parent_physical" "$expected_parent_identity" || return 65
    [[ -L "$temp_name" && "$(path_identity "$temp_name")" == "$expected_identity" ]] || return 65
    [[ ! -e "$target_name" && ! -L "$target_name" ]] || return 65
    safe_source "$source" || return 65
    install_test_hook link_publish_after_check "$target_path" "$temp_path" "$recovery_hint" || hook_status=$?
    temp_location=$(locate_owned_artifact_from_cwd "$temp_name" "$expected_parent_identity" "$expected_identity" \
        "L:$source") || temp_location=''
    if [[ -n "$temp_location" ]]; then
        IFS=$'\t' read -r temp_actual temp_parent temp_parent_identity temp_actual_name <<<"$temp_location"
    fi
    if [[ $hook_status -ne 0 || -z "$temp_location" || "$temp_actual_name" != "$temp_name" ]]; then
        if [[ -n "$temp_location" ]]; then
            printf 'AUX\t%s\t%s\t%s\t%s\t%s\n' "$temp_actual" "$temp_parent" "$temp_parent_identity" \
                "$expected_identity" "L:$source"
        fi
        [[ $hook_status -eq 0 ]] || return "$hook_status"
        return 74
    fi
    publication_parent_matches_pin "$target_path" "$expected_parent_physical" "$expected_parent_identity" || {
        printf 'AUX\t%s\t%s\t%s\t%s\t%s\n' "$temp_actual" "$temp_parent" "$temp_parent_identity" \
            "$expected_identity" "L:$source"
        return 65
    }
    move_no_clobber_exact "$temp_name" "$target_name" link_publish || return 74
    if [[ "$MOVE_RESULT_IDENTITY" != "$expected_identity" || \
        "$MOVE_RESULT_FINGERPRINT" != "L:$source" ]]; then
        unowned_info=$(recover_unowned_displaced "$temp_name") || return 74
        printf '%s\n' "$unowned_info"
        return 74
    fi
    actual=''
    status=0
    if [[ -d "$target_name" && ! -L "$target_name" ]]; then
        container_path="$target_name/$temp_name"
        if [[ -L "$container_path" && "$(path_identity "$container_path")" == "$expected_identity" ]]; then
            actual="$(pwd -P)/$container_path"
        elif [[ -L "$temp_name" && "$(path_identity "$temp_name")" == "$expected_identity" ]]; then
            actual=$temp_path
        fi
        status=74
    elif [[ -L "$target_name" && "$(path_identity "$target_name")" == "$expected_identity" ]]; then
        actual="$(pwd -P)/$target_name"
    elif [[ -L "$temp_name" && "$(path_identity "$temp_name")" == "$expected_identity" ]]; then
        actual=$temp_path
        status=74
    else
        return 74
    fi
    actual_name=${actual##*/}
    cd -P -- "${actual%/*}" || return 74
    immediate_parent_physical=$(pwd -P) || return 74
    immediate_parent_identity=$(path_identity .) || return 74
    artifact_identity=$(path_identity "$actual_name") || return 74
    artifact_fingerprint=$(path_fingerprint "$actual_name") || return 74
    install_test_hook link_publish_after_move "$target_path" "$immediate_parent_physical/$actual_name" \
        "$artifact_identity" "$EFFECTIVE_HOME" || hook_status=$?
    current_parent_physical=$(run_without_report_fd /bin/pwd -P 2>/dev/null) || current_parent_physical=$immediate_parent_physical
    current_parent_identity=$(path_identity . 2>/dev/null) || current_parent_identity=$immediate_parent_identity
    actual="$current_parent_physical/$actual_name"
    printf 'PUBLICATION\t%s\t%s\t%s\t%s\t%s\n' "$actual" "$current_parent_physical" "$current_parent_identity" \
        "$artifact_identity" "$artifact_fingerprint"
    [[ $hook_status -eq 0 ]] || return "$hook_status"
    [[ "$current_parent_physical" == "$immediate_parent_physical" && \
        "$current_parent_identity" == "$immediate_parent_identity" ]] || return 74
    [[ "$(path_identity "$actual_name" 2>/dev/null || true)" == "$artifact_identity" ]] || return 74
    [[ "$(path_fingerprint "$actual_name" 2>/dev/null || true)" == "$artifact_fingerprint" ]] || return 74
    publication_parent_matches_pin "$target_path" "$expected_parent_physical" "$expected_parent_identity" || return 74
    [[ $status -eq 0 ]] || return "$status"
)

apply_install_entry() {
    local plan_index=$1 action=$2 source=$3 target_path=$4 relative_path=$5
    local fingerprint backup_path='' backup_stage='' backup_recovery='' stage_relative actual_stage stage_status
    local stage_info stage_kind stage_identity stage_fingerprint restore_parent_physical restore_parent_identity
    local backup_info backup_kind backup_status backup_identity backup_fingerprint
    local temp_path temp_relative link_recovery identity journal_index published_path publish_status actual_relative
    local inspection target_identity parent_physical parent_identity actual_parent actual_parent_identity published_info
    local published_kind published_identity published_fingerprint
    local hook_info hook_status hook_location hook_actual hook_parent hook_parent_identity hook_identity hook_fingerprint
    local previous_state_physical refresh_status temp_fingerprint
    local backup_display

    state_cwd_matches_pin || return 74
    inspection=$(inspect_install_entry "$action" "$source" "$target_path" "$relative_path") || return $?
    IFS=$'\t' read -r fingerprint target_identity parent_physical parent_identity <<<"$inspection"
    [[ -n "$fingerprint" && -n "$target_identity" && -n "$parent_physical" && -n "$parent_identity" ]] || return 65
    PLAN_PARENT_PHYSICAL[$plan_index]=$parent_physical
    PLAN_PARENT_IDENTITY[$plan_index]=$parent_identity
    if [[ "$action" == BACKUP ]]; then
        backup_path="$BACKUP_FILES/$relative_path"
        run_without_report_fd mkdir -p -- "$(run_without_report_fd dirname "$backup_path")" || return 74
        [[ ! -e "$backup_path" && ! -L "$backup_path" ]] || return 74
        journal_index=$JOURNAL_COUNT
        backup_stage="${target_path%/*}/.dotfiles-backup-$$-$journal_index"
        backup_recovery="${target_path%/*}/.dotfiles-backup-recovery-$$-$journal_index"
        stage_relative=$(sibling_relative_path "$relative_path" "${backup_stage##*/}") || return 74
        journal_move "$plan_index" "$relative_path" "$target_path" "$backup_path" "$fingerprint" "$target_identity" \
            "$backup_stage" "$stage_relative" \
            "$parent_physical" "$parent_identity" || return $?
        PLAN_BACKUP_PATH[$plan_index]=$backup_path
        PLAN_BACKUP_FINGERPRINT[$plan_index]=$fingerprint
        stage_info=$(stage_backup_target "$source" "$target_path" "$relative_path" "$backup_stage" "$backup_recovery" \
            "$fingerprint" "$target_identity" "$parent_physical" "$parent_identity")
        stage_status=$?
        IFS=$'\t' read -r stage_kind actual_stage actual_parent actual_parent_identity stage_identity stage_fingerprint \
            restore_parent_physical restore_parent_identity <<<"$stage_info"
        if [[ "$stage_kind" == CANCELLED ]]; then
            cancel_journal_move "$journal_index" || return 74
            return "$stage_status"
        fi
        if [[ "$stage_kind" == UNOWNED_RESTORED || "$stage_kind" == UNOWNED_DISPLACED ]]; then
            record_unowned_move "$journal_index" "$stage_kind" "$actual_stage" "$actual_parent" \
                "$actual_parent_identity" "$stage_identity" "$stage_fingerprint" || return $?
            previous_state_physical=$STATE_ROOT_PHYSICAL
            refresh_journal_locations_after_hook "$previous_state_physical" || true
            honor_pending_signal || return $?
            return "$stage_status"
        fi
        [[ "$stage_kind" == OWNED || -z "$stage_kind" ]] || return 74
        if [[ "$stage_kind" == OWNED && -n "$actual_stage" ]]; then
            actual_relative=$relative_path
            set_journal_aux_location "$journal_index" "$actual_stage" "$actual_relative" "$actual_parent" \
                "$actual_parent_identity" "$stage_identity" "$stage_fingerprint" \
                "$restore_parent_physical" "$restore_parent_identity"
        fi
        if [[ "$stage_kind" == OWNED && -n "$actual_stage" ]]; then
            previous_state_physical=$STATE_ROOT_PHYSICAL
            hook_info=$(run_artifact_hook_with_refresh after_backup_stage "$actual_stage" "$actual_parent" \
                "$actual_parent_identity" "$stage_identity" "$stage_fingerprint" "$target_path" "$actual_stage")
            hook_status=$?
            IFS=$'\t' read -r hook_location hook_actual hook_parent hook_parent_identity hook_identity hook_fingerprint <<<"$hook_info"
            if [[ "$hook_location" == KNOWN ]]; then
                if [[ "$restore_parent_identity" == "$actual_parent_identity" ]]; then
                    restore_parent_physical=$hook_parent
                    restore_parent_identity=$hook_parent_identity
                fi
                actual_stage=$hook_actual
                actual_parent=$hook_parent
                actual_parent_identity=$hook_parent_identity
                set_journal_aux_location "$journal_index" "$actual_stage" "$actual_relative" "$actual_parent" \
                    "$actual_parent_identity" "$hook_identity" "$hook_fingerprint" \
                    "$restore_parent_physical" "$restore_parent_identity"
            else
                mark_journal_aux_unavailable "$journal_index"
            fi
            refresh_status=0
            refresh_journal_locations_after_hook "$previous_state_physical" || refresh_status=$?
            honor_pending_signal || return $?
            [[ $hook_status -eq 0 ]] || return "$hook_status"
            [[ $refresh_status -eq 0 ]] || return "$refresh_status"
        fi
        [[ $stage_status -eq 0 ]] || return "$stage_status"
        backup_display="$STATE_ROOT_PHYSICAL/$backup_path"
        run_journal_aux_hook_boundary "$journal_index" before_backup_move "$target_path" "$backup_display" || return $?
        actual_stage=${JOURNAL_AUX[$journal_index]}
        [[ -n "$actual_stage" ]] || return 74
        backup_display="$STATE_ROOT_PHYSICAL/$backup_path"
        run_journal_aux_hook_boundary "$journal_index" backup_move_after_state_check "$STATE_ROOT" "$backup_display" || return $?
        actual_stage=${JOURNAL_AUX[$journal_index]}
        [[ -n "$actual_stage" ]] || return 74
        previous_state_physical=$STATE_ROOT_PHYSICAL
        backup_info=$(move_staged_backup "$target_path" "$actual_stage" "$backup_path" "$fingerprint" "$stage_identity")
        backup_status=$?
        IFS=$'\t' read -r backup_kind published_path actual_parent actual_parent_identity backup_identity backup_fingerprint \
            <<<"$backup_info"
        if [[ "$backup_kind" == UNOWNED_RESTORED || "$backup_kind" == UNOWNED_DISPLACED ]]; then
            record_unowned_move "$journal_index" "$backup_kind" "$published_path" "$actual_parent" \
                "$actual_parent_identity" "$backup_identity" "$backup_fingerprint" || return $?
            refresh_status=0
            refresh_journal_locations_after_hook "$previous_state_physical" || refresh_status=$?
            honor_pending_signal || return $?
            [[ $backup_status -ne 0 ]] && return "$backup_status"
            [[ $refresh_status -eq 0 ]] || return "$refresh_status"
            return 74
        fi
        [[ "$backup_kind" == OWNED || -z "$backup_kind" ]] || return 74
        if [[ "$backup_kind" == OWNED && -n "$published_path" ]]; then
            actual_relative=$relative_path
            set_journal_publication_location "$journal_index" "$published_path" "$actual_relative" "$actual_parent" \
                "$actual_parent_identity" "$backup_identity" "$backup_fingerprint"
            PLAN_BACKUP_PATH[$plan_index]=$published_path
            PLAN_BACKUP_FINGERPRINT[$plan_index]=$backup_fingerprint
            PLAN_BACKUP_IDENTITY[$plan_index]=$backup_identity
            PLAN_BACKUP_PARENT_PHYSICAL[$plan_index]=$actual_parent
            PLAN_BACKUP_PARENT_IDENTITY[$plan_index]=$actual_parent_identity
            finalize_move_report "$journal_index" "$published_path" || return $?
        fi
        if [[ $backup_status -eq 0 ]]; then
            previous_state_physical=$STATE_ROOT_PHYSICAL
            hook_info=$(run_artifact_hook_with_refresh after_backup_move "$published_path" "$actual_parent" \
                "$actual_parent_identity" "$backup_identity" "$backup_fingerprint" "$target_path" "$published_path")
            hook_status=$?
            IFS=$'\t' read -r hook_location hook_actual hook_parent hook_parent_identity hook_identity hook_fingerprint <<<"$hook_info"
            if [[ "$hook_location" == KNOWN ]]; then
                published_path=$hook_actual
                actual_parent=$hook_parent
                actual_parent_identity=$hook_parent_identity
                set_journal_publication_location "$journal_index" "$published_path" "$actual_relative" "$actual_parent" \
                    "$actual_parent_identity" "$hook_identity" "$hook_fingerprint"
                finalize_move_report "$journal_index" "$published_path" || return $?
            else
                mark_journal_publication_unavailable "$journal_index" || return $?
            fi
            refresh_status=0
            refresh_journal_locations_after_hook "$previous_state_physical" || refresh_status=$?
            honor_pending_signal || return $?
            [[ $hook_status -eq 0 ]] || return "$hook_status"
            [[ $refresh_status -eq 0 ]] || return "$refresh_status"
        fi
        [[ $backup_status -eq 0 ]] || return "$backup_status"
        after_transaction_mutation || return $?
    fi

    journal_index=$JOURNAL_COUNT
    temp_path="${target_path%/*}/.dotfiles-link-$$-$journal_index"
    link_recovery="${target_path%/*}/.dotfiles-link-recovery-$$-$journal_index"
    temp_relative=$(sibling_relative_path "$relative_path" "${temp_path##*/}") || return 74
    journal_link "$plan_index" "$relative_path" "$source" "$target_path" "$temp_path" "$temp_relative" \
        "$parent_physical" "$parent_identity" || return $?
    identity=$(create_link_temp "$source" "$target_path" "$relative_path" "$temp_path" "$parent_physical" "$parent_identity") || return $?
    [[ -n "$identity" ]] || return 65
    set_journal_link_identity "$journal_index" "$identity"
    temp_fingerprint=$(path_fingerprint "$temp_path") || return 65
    set_journal_aux_location "$journal_index" "$temp_path" "$temp_relative" "$parent_physical" "$parent_identity" \
        "$identity" "$temp_fingerprint" "$parent_physical" "$parent_identity"
    previous_state_physical=$STATE_ROOT_PHYSICAL
    hook_info=$(run_artifact_hook_with_refresh after_link_temp "$temp_path" "$parent_physical" "$parent_identity" \
        "$identity" "$temp_fingerprint" "$target_path" "$temp_path" "$identity")
    hook_status=$?
    IFS=$'\t' read -r hook_location hook_actual hook_parent hook_parent_identity hook_identity hook_fingerprint <<<"$hook_info"
    if [[ "$hook_location" == KNOWN ]]; then
        temp_path=$hook_actual
        set_journal_aux_location "$journal_index" "$temp_path" "$temp_relative" "$hook_parent" "$hook_parent_identity" \
            "$hook_identity" "$hook_fingerprint" "$parent_physical" "$parent_identity"
    else
        mark_journal_aux_unavailable "$journal_index"
    fi
    refresh_status=0
    refresh_journal_locations_after_hook "$previous_state_physical" || refresh_status=$?
    honor_pending_signal || return $?
    [[ $hook_status -eq 0 ]] || return "$hook_status"
    [[ $refresh_status -eq 0 ]] || return "$refresh_status"
    run_journal_aux_hook_boundary "$journal_index" before_link_publish "$target_path" "$temp_path" || return $?
    temp_path=${JOURNAL_AUX[$journal_index]}
    [[ -n "$temp_path" ]] || return 74
    previous_state_physical=$STATE_ROOT_PHYSICAL
    published_info=$(publish_link_temp "$source" "$target_path" "$relative_path" "$temp_path" "$identity" "$link_recovery" \
        "$parent_physical" "$parent_identity")
    publish_status=$?
    IFS=$'\t' read -r published_kind published_path actual_parent actual_parent_identity published_identity published_fingerprint \
        <<<"$published_info"
    actual_relative=$relative_path
    case "$published_kind" in
        PUBLICATION)
            set_journal_publication_location "$journal_index" "$published_path" "$actual_relative" "$actual_parent" \
                "$actual_parent_identity" "$published_identity" "$published_fingerprint"
            ;;
        AUX)
            temp_path=$published_path
            set_journal_aux_location "$journal_index" "$temp_path" "$temp_relative" "$actual_parent" \
                "$actual_parent_identity" "$published_identity" "$published_fingerprint" \
                "$parent_physical" "$parent_identity"
            ;;
        UNOWNED_RESTORED|UNOWNED_DISPLACED)
            record_unowned_move "$journal_index" "$published_kind" "$published_path" "$actual_parent" \
                "$actual_parent_identity" "$published_identity" "$published_fingerprint" || return $?
            ;;
    esac
    refresh_status=0
    refresh_journal_locations_after_hook "$previous_state_physical" || refresh_status=$?
    honor_pending_signal || return $?
    [[ $refresh_status -eq 0 ]] || return "$refresh_status"
    if [[ $publish_status -eq 0 ]]; then
        previous_state_physical=$STATE_ROOT_PHYSICAL
        hook_info=$(run_artifact_hook_with_refresh after_link_publish "$published_path" "$actual_parent" \
            "$actual_parent_identity" "$published_identity" "$published_fingerprint" "$target_path" "$temp_path")
        hook_status=$?
        IFS=$'\t' read -r hook_location hook_actual hook_parent hook_parent_identity hook_identity hook_fingerprint <<<"$hook_info"
        if [[ "$hook_location" == KNOWN ]]; then
            published_path=$hook_actual
            set_journal_publication_location "$journal_index" "$published_path" "$actual_relative" "$hook_parent" \
                "$hook_parent_identity" "$hook_identity" "$hook_fingerprint"
        else
            mark_journal_publication_unavailable "$journal_index" || return $?
        fi
        refresh_status=0
        refresh_journal_locations_after_hook "$previous_state_physical" || refresh_status=$?
        honor_pending_signal || return $?
        [[ $hook_status -eq 0 ]] || return "$hook_status"
        [[ $refresh_status -eq 0 ]] || return "$refresh_status"
    fi
    [[ $publish_status -eq 0 ]] || return "$publish_status"
    after_transaction_mutation || return $?
}

pin_rollback_target_parent() {
    local target_path=$1 relative_path=$2 expected_parent_physical=${3:-} expected_parent_identity=${4:-}
    local allow_detached=${5:-0} expected_root parent physical identity
    if [[ -n "$expected_parent_physical" && -n "$expected_parent_identity" ]]; then
        if [[ "$allow_detached" != 1 ]]; then
            install_root_name_matches_pin && pinned_install_names_match || return 2
        fi
        parent=${target_path%/*}
        [[ -d "$parent" && ! -L "$parent" ]] || return 2
        cd -P -- "$parent" || return 2
        physical=$(pwd -P) || return 2
        identity=$(path_identity .) || return 2
        [[ "$physical" == "$expected_parent_physical" && "$identity" == "$expected_parent_identity" ]] || return 2
        [[ "$allow_detached" == 1 ]] || path_within "$physical" "$INSTALL_ROOT_PHYSICAL" || return 2
        return 0
    fi
    TARGET_RELATIVE_PATH=$relative_path
    TARGET_ROOT_PHYSICAL=''
    safe_target "$target_path" || return 2
    expected_root=$TARGET_ROOT_PHYSICAL
    [[ -n "$expected_root" ]] || return 2
    pin_existing_install_parent "$relative_path" "$expected_root" || return 2
}

restore_local_stage_exact() {
    local stage_name=$1 destination_name=$2 container_path
    move_no_clobber_exact "$stage_name" "$destination_name" || return 2
    if [[ -d "$destination_name" && ! -L "$destination_name" ]]; then
        container_path="$destination_name/$stage_name"
        if [[ -e "$container_path" || -L "$container_path" ]]; then
            move_no_clobber_exact "$container_path" "$stage_name" || return 2
        fi
        return 2
    fi
    [[ ! -e "$stage_name" && ! -L "$stage_name" ]] || return 2
}

stage_rollback_link_path() (
    local source=$1 path=$2 path_relative=$3 stage_path=$4 expected_identity=$5 hook_event=$6
    local expected_parent_physical=$7 expected_parent_identity=$8
    local allow_detached=${9:-0}
    local name stage_name parent_before observed_identity
    pin_rollback_target_parent "$path" "$path_relative" "$expected_parent_physical" "$expected_parent_identity" \
        "$allow_detached" || return 2
    name=${path##*/}
    [[ -e "$name" || -L "$name" ]] || return 0
    [[ -n "$expected_identity" ]] || return 2
    stage_name=${stage_path##*/}
    [[ ! -e "$stage_name" && ! -L "$stage_name" ]] || return 2
    parent_before=$(pwd -P) || return 2
    if [[ -n "$hook_event" ]]; then
        install_test_hook "$hook_event" "$path" "$stage_path" || return 2
    fi
    [[ "$(pwd -P)" == "$parent_before" ]] || return 2
    [[ -e "$name" || -L "$name" ]] || return 0
    move_no_clobber_exact "$name" "$stage_name" || return 2
    [[ ! -e "$name" && ! -L "$name" ]] || return 2
    [[ -e "$stage_name" || -L "$stage_name" ]] || return 2
    observed_identity=$(path_identity "$stage_name") || observed_identity=''
    if [[ "$observed_identity" != "$expected_identity" ]]; then
        restore_local_stage_exact "$stage_name" "$name" || true
        return 2
    fi
    if [[ ! -L "$stage_name" || "$(run_without_report_fd readlink "$stage_name")" != "$source" ]]; then
        restore_local_stage_exact "$stage_name" "$name" || true
        return 2
    fi
)

move_local_stage_to_quarantine() {
    local stage_path=$1 quarantine_path=$2 stage_name container_path
    [[ -e "$stage_path" || -L "$stage_path" ]] || return 0
    stage_name=${stage_path##*/}
    state_cwd_matches_pin || return 2
    move_no_clobber_exact "$stage_path" "$quarantine_path" || return 2
    if [[ -d "$quarantine_path" && ! -L "$quarantine_path" ]]; then
        container_path="$quarantine_path/$stage_name"
        if [[ -e "$container_path" || -L "$container_path" ]]; then
            move_no_clobber_exact "$container_path" "$stage_path" || return 2
        fi
        return 2
    fi
    [[ ! -e "$stage_path" && ! -L "$stage_path" ]] || return 2
}

rollback_one_link_path() {
    local source=$1 path=$2 path_relative=$3 stage_path=$4 quarantine_path=$5 expected_identity=$6 hook_event=$7
    local expected_parent_physical=$8 expected_parent_identity=$9
    local allow_detached=${10:-0}
    [[ -n "$path" ]] || return 0
    stage_rollback_link_path "$source" "$path" "$path_relative" "$stage_path" "$expected_identity" "$hook_event" \
        "$expected_parent_physical" "$expected_parent_identity" "$allow_detached" || return $?
    move_local_stage_to_quarantine "$stage_path" "$quarantine_path"
}

rollback_link_entry() {
    local journal_index=$1 relative_path=$2 source=$3 target_path=$4 temp_path=$5 temp_relative=$6
    local publication_path=$7 publication_relative=$8 expected_identity=$9 parent_physical=${10} parent_identity=${11}
    local publication_parent_physical=${12} publication_parent_identity=${13} publication_identity=${14}
    local aux_parent_physical=${15} aux_parent_identity=${16} aux_identity=${17}
    local quarantine_dir target_dir temp_dir actual_dir entry_status status=0
    quarantine_dir="$QUARANTINE_ROOT/link-$journal_index"
    run_without_report_fd mkdir -p -- "$quarantine_dir" || return 1
    target_dir=${target_path%/*}
    temp_dir=${temp_path%/*}
    if [[ -n "$publication_identity" && -z "$publication_path" ]]; then
        return 2
    elif [[ -n "$publication_path" ]]; then
        actual_dir=${publication_path%/*}
        rollback_one_link_path "$source" "$publication_path" "$publication_relative" \
            "$actual_dir/.dotfiles-rollback-actual-$$-$journal_index" "$quarantine_dir/actual" "$publication_identity" \
            rollback_link_before_quarantine \
            "$publication_parent_physical" "$publication_parent_identity" 1
        entry_status=$?
        [[ $entry_status -eq 0 ]] || status=$entry_status
    else
        if [[ -n "$aux_identity" && -n "$temp_path" ]] && locate_recorded_artifact "$temp_path" \
            "$aux_parent_physical" "$aux_parent_identity" "$aux_identity" "L:$source" >/dev/null; then
            rollback_one_link_path "$source" "$temp_path" "$temp_relative" \
                "$temp_dir/.dotfiles-rollback-temp-$$-$journal_index" "$quarantine_dir/temp" "$aux_identity" '' \
                "$aux_parent_physical" "$aux_parent_identity" 1
            status=$?
        else
            rollback_one_link_path "$source" "$target_path" "$relative_path" \
                "$target_dir/.dotfiles-rollback-final-$$-$journal_index" "$quarantine_dir/final" "$expected_identity" \
                rollback_link_before_quarantine "$parent_physical" "$parent_identity"
            entry_status=$?
            [[ $entry_status -eq 0 ]] || status=$entry_status
            if [[ -n "$aux_identity" && -z "$temp_path" ]]; then
                entry_status=2
            else
                rollback_one_link_path "$source" "$temp_path" "$temp_relative" \
                    "$temp_dir/.dotfiles-rollback-temp-$$-$journal_index" "$quarantine_dir/temp" \
                    "${aux_identity:-$expected_identity}" '' "${aux_parent_physical:-$parent_physical}" \
                    "${aux_parent_identity:-$parent_identity}" 1
                entry_status=$?
            fi
            [[ $entry_status -eq 0 ]] || status=$entry_status
        fi
    fi
    return "$status"
}

publish_restore_stage() (
    local journal_index=$1 relative_path=$2 target_path=$3 stage_path=$4 expected_fingerprint=$5 backup_display=$6
    local expected_parent_physical=$7 expected_parent_identity=$8 target_name stage_name container_path
    pin_rollback_target_parent "$target_path" "$relative_path" "$expected_parent_physical" "$expected_parent_identity" 1 || return 2
    target_name=${relative_path##*/}
    stage_name=${stage_path##*/}
    [[ "$(path_fingerprint "$stage_name")" == "$expected_fingerprint" ]] || return 2
    install_test_hook rollback_move_before_restore "$target_path" "$backup_display" || return 2
    move_no_clobber_exact "$stage_name" "$target_name" || return 2
    if [[ -d "$target_name" && ! -L "$target_name" ]]; then
        container_path="$target_name/$stage_name"
        if [[ -e "$container_path" || -L "$container_path" ]]; then
            move_no_clobber_exact "$container_path" "$stage_name" || return 2
        fi
        return 2
    fi
    if [[ -e "$stage_name" || -L "$stage_name" ]]; then
        return 2
    fi
    [[ "$(path_fingerprint "$target_name")" == "$expected_fingerprint" ]] || return 2
)

return_restore_stage_to_backup() {
    local stage_path=$1 backup_path=$2 stage_name container_path
    [[ -e "$stage_path" || -L "$stage_path" ]] || return 2
    stage_name=${stage_path##*/}
    state_cwd_matches_pin || return 2
    move_no_clobber_exact "$stage_path" "$backup_path" || return 2
    if [[ -d "$backup_path" && ! -L "$backup_path" ]]; then
        container_path="$backup_path/$stage_name"
        if [[ -e "$container_path" || -L "$container_path" ]]; then
            move_no_clobber_exact "$container_path" "$stage_path" || return 2
        fi
        return 2
    fi
    [[ ! -e "$stage_path" && ! -L "$stage_path" ]] || return 2
}

move_local_backup_to_restore_stage() (
    local source_path=$1 source_relative=$2 restore_stage=$3 expected_fingerprint=$4
    local expected_parent_physical=$5 expected_parent_identity=$6
    local expected_artifact_identity=${7:-} allow_detached=${8:-0}
    local source_name container_path
    pin_rollback_target_parent "$source_path" "$source_relative" "$expected_parent_physical" "$expected_parent_identity" \
        "$allow_detached" || return 2
    source_name=${source_path##*/}
    if [[ -n "$expected_artifact_identity" ]]; then
        [[ "$(path_identity "$source_name" 2>/dev/null || true)" == "$expected_artifact_identity" ]] || return 2
    fi
    [[ "$(path_fingerprint "$source_name")" == "$expected_fingerprint" ]] || return 2
    [[ ! -e "$restore_stage" && ! -L "$restore_stage" ]] || return 2
    move_no_clobber_exact "$source_name" "$restore_stage" || return 2
    if [[ -d "$restore_stage" && ! -L "$restore_stage" ]]; then
        container_path="$restore_stage/$source_name"
        if [[ -e "$container_path" || -L "$container_path" ]]; then
            move_no_clobber_exact "$container_path" "$source_name" || return 2
        fi
        return 2
    fi
    [[ ! -e "$source_name" && ! -L "$source_name" ]] || return 2
    [[ "$(path_fingerprint "$restore_stage")" == "$expected_fingerprint" ]] || return 2
)

return_restore_stage_to_recorded_backup() (
    local stage_path=$1 destination_path=$2 expected_parent_physical=$3 expected_parent_identity=$4
    local expected_artifact_identity=$5 expected_fingerprint=$6 destination_name container_path
    pin_rollback_target_parent "$destination_path" "$destination_path" "$expected_parent_physical" \
        "$expected_parent_identity" 1 || return 2
    destination_name=${destination_path##*/}
    [[ ! -e "$destination_name" && ! -L "$destination_name" ]] || return 2
    [[ "$(path_identity "$stage_path" 2>/dev/null || true)" == "$expected_artifact_identity" ]] || return 2
    [[ "$(path_fingerprint "$stage_path" 2>/dev/null || true)" == "$expected_fingerprint" ]] || return 2
    move_no_clobber_exact "$stage_path" "$destination_name" || return 2
    if [[ -d "$destination_name" && ! -L "$destination_name" ]]; then
        container_path="$destination_name/${stage_path##*/}"
        if [[ -e "$container_path" || -L "$container_path" ]]; then
            move_no_clobber_exact "$container_path" "$stage_path" || return 2
        fi
        return 2
    fi
    [[ ! -e "$stage_path" && ! -L "$stage_path" ]] || return 2
    [[ "$(path_identity "$destination_name" 2>/dev/null || true)" == "$expected_artifact_identity" ]] || return 2
    [[ "$(path_fingerprint "$destination_name" 2>/dev/null || true)" == "$expected_fingerprint" ]] || return 2
)

rollback_move_entry() {
    local journal_index=$1 relative_path=$2 target_path=$3 backup_path=$4 expected_fingerprint=$5 backup_stage=$6 stage_relative=$7
    local parent_physical=$8 parent_identity=$9 aux_parent_physical=${10} aux_parent_identity=${11}
    local aux_identity=${12} aux_fingerprint=${13}
    local publication_path=${14} publication_parent_physical=${15} publication_parent_identity=${16}
    local publication_identity=${17} publication_fingerprint=${18}
    local restore_stage backup_display backup_name container_path using_recorded=0
    backup_display="$STATE_ROOT_PHYSICAL/$backup_path"
    restore_stage="${target_path%/*}/.dotfiles-restore-$$-$journal_index"
    if [[ -n "$publication_identity" && -z "$publication_path" ]]; then
        return 2
    elif [[ -n "$publication_path" ]]; then
        [[ ! -e "$restore_stage" && ! -L "$restore_stage" ]] || return 2
        move_local_backup_to_restore_stage "$publication_path" "$relative_path" "$restore_stage" \
            "$publication_fingerprint" "$publication_parent_physical" "$publication_parent_identity" \
            "$publication_identity" 1 || return 2
        using_recorded=1
    elif [[ ( -f "$backup_path" || -L "$backup_path" ) && "$(path_fingerprint "$backup_path")" == "$expected_fingerprint" ]]; then
        [[ ! -e "$restore_stage" && ! -L "$restore_stage" ]] || return 2
        install_test_hook rollback_move_before_stage "$target_path" "$backup_display" || return 2
        backup_name=${backup_path##*/}
        move_no_clobber_exact "$backup_path" "$restore_stage" || return 2
        if [[ -d "$restore_stage" && ! -L "$restore_stage" ]]; then
            container_path="$restore_stage/$backup_name"
            if [[ -e "$container_path" || -L "$container_path" ]]; then
                move_no_clobber_exact "$container_path" "$backup_path" || return 2
            fi
            return 2
        fi
        [[ "$(path_fingerprint "$restore_stage")" == "$expected_fingerprint" ]] || return 2
    elif [[ -e "$backup_stage" || -L "$backup_stage" ]]; then
        [[ "$(path_identity "$backup_stage" 2>/dev/null || true)" == "$aux_identity" ]] || return 2
        [[ "$(path_fingerprint "$backup_stage")" == "$aux_fingerprint" ]] || return 2
        [[ ! -e "$restore_stage" && ! -L "$restore_stage" ]] || return 2
        move_local_backup_to_restore_stage "$backup_stage" "$stage_relative" "$restore_stage" "$aux_fingerprint" \
            "$aux_parent_physical" "$aux_parent_identity" "$aux_identity" 1 || return 2
    else
        [[ -e "$target_path" || -L "$target_path" ]] && return 0
        return 2
    fi
    publish_restore_stage "$journal_index" "$relative_path" "$target_path" "$restore_stage" "$expected_fingerprint" \
        "$backup_display" "$parent_physical" "$parent_identity"
    if [[ $? -eq 0 ]]; then
        return 0
    fi
    if [[ "$using_recorded" == 1 ]]; then
        return_restore_stage_to_recorded_backup "$restore_stage" "$publication_path" \
            "$publication_parent_physical" "$publication_parent_identity" "$publication_identity" \
            "$publication_fingerprint" || true
    else
        return_restore_stage_to_backup "$restore_stage" "$backup_path" || true
    fi
    return 2
}

rollback_transaction() {
    local i status=0 entry_status relative_path recovery_path recovery_identity
    state_cwd_matches_pin || return 1
    for ((i=JOURNAL_COUNT-1; i>=0; i--)); do
        relative_path=${JOURNAL_RELATIVE[$i]}
        case "${JOURNAL_TYPE[$i]}" in
            LINK)
                rollback_link_entry "$i" "$relative_path" "${JOURNAL_FIRST[$i]}" "${JOURNAL_SECOND[$i]}" \
                    "${JOURNAL_AUX[$i]}" "${JOURNAL_AUX_RELATIVE[$i]}" \
                    "${JOURNAL_PUBLICATION[$i]}" "${JOURNAL_PUBLICATION_RELATIVE[$i]}" "${JOURNAL_IDENTITY[$i]}" \
                    "${JOURNAL_PARENT_PHYSICAL[$i]}" "${JOURNAL_PARENT_IDENTITY[$i]}" \
                    "${JOURNAL_PUBLICATION_PARENT_PHYSICAL[$i]}" "${JOURNAL_PUBLICATION_PARENT_IDENTITY[$i]}" \
                    "${JOURNAL_PUBLICATION_IDENTITY[$i]}" "${JOURNAL_AUX_PARENT_PHYSICAL[$i]}" \
                    "${JOURNAL_AUX_PARENT_IDENTITY[$i]}" "${JOURNAL_AUX_IDENTITY[$i]}"
                entry_status=$?
                ;;
            MOVE)
                rollback_move_entry "$i" "$relative_path" "${JOURNAL_FIRST[$i]}" "${JOURNAL_SECOND[$i]}" \
                    "${JOURNAL_IDENTITY[$i]}" "${JOURNAL_AUX[$i]}" "${JOURNAL_AUX_RELATIVE[$i]}" \
                    "${JOURNAL_PARENT_PHYSICAL[$i]}" "${JOURNAL_PARENT_IDENTITY[$i]}" \
                    "${JOURNAL_AUX_PARENT_PHYSICAL[$i]}" "${JOURNAL_AUX_PARENT_IDENTITY[$i]}" \
                    "${JOURNAL_AUX_IDENTITY[$i]}" "${JOURNAL_AUX_FINGERPRINT[$i]}" \
                    "${JOURNAL_PUBLICATION[$i]}" "${JOURNAL_PUBLICATION_PARENT_PHYSICAL[$i]}" \
                    "${JOURNAL_PUBLICATION_PARENT_IDENTITY[$i]}" "${JOURNAL_PUBLICATION_IDENTITY[$i]}" \
                    "${JOURNAL_PUBLICATION_FINGERPRINT[$i]}"
                entry_status=$?
                ;;
            CANCELLED) entry_status=0 ;;
            *) entry_status=2 ;;
        esac
        if [[ $entry_status -eq 2 ]]; then
            if [[ -n "${JOURNAL_PUBLICATION_IDENTITY[$i]}" ]]; then
                recovery_identity=${JOURNAL_PUBLICATION_IDENTITY[$i]}
                recovery_path=${JOURNAL_PUBLICATION[$i]}
            elif [[ -n "${JOURNAL_AUX_IDENTITY[$i]}" ]]; then
                recovery_identity=${JOURNAL_AUX_IDENTITY[$i]}
                recovery_path=${JOURNAL_AUX[$i]}
            else
                if [[ "${JOURNAL_TYPE[$i]}" == MOVE ]]; then
                    recovery_identity=${JOURNAL_ORIGINAL_IDENTITY[$i]}
                else
                    recovery_identity=${JOURNAL_IDENTITY[$i]}
                fi
                recovery_path=''
            fi
            if [[ -n "$recovery_path" ]]; then
                printf '%s: ROLLBACK_REFUSED %s; recorded recovery location=%s identity=%s; entries remain recoverable in the backup or quarantine\n' \
                    "$PROGRAM" "$relative_path" "$recovery_path" "${recovery_identity:--}" >&2
            else
                printf '%s: ROLLBACK_REFUSED %s; recovery path unavailable identity=%s; owned artifact location could not be revalidated\n' \
                    "$PROGRAM" "$relative_path" "${recovery_identity:--}" >&2
            fi
            status=1
        elif [[ $entry_status -ne 0 ]]; then
            printf '%s: rollback failed for %s\n' "$PROGRAM" "$relative_path" >&2
            status=1
        fi
    done
    return "$status"
}

cleanup_transaction_storage() {
    [[ -n "$QUARANTINE_ROOT" ]] && run_without_report_fd rmdir -- "$QUARANTINE_ROOT" 2>/dev/null || true
    [[ -n "$TRANSACTION_ROOT" ]] && run_without_report_fd rmdir -- "$TRANSACTION_ROOT" 2>/dev/null || true
    run_without_report_fd rmdir -- transactions 2>/dev/null || true
}

cleanup_success_transaction_storage() {
    state_cwd_matches_pin || return 74
    [[ -n "$QUARANTINE_ROOT" ]] || return 74
    run_without_report_fd rmdir -- "$QUARANTINE_ROOT" || return 74
    run_without_report_fd rmdir -- "$TRANSACTION_ROOT" || return 74
    run_without_report_fd rmdir -- transactions 2>/dev/null || true
    TRANSACTION_ROOT=''
    QUARANTINE_ROOT=''
}

transaction_trap() {
    local status=$? previous_state_physical
    trap '' INT TERM
    trap - EXIT
    CLEANUP_ACTIVE=1
    if [[ "$PRECOMMIT_CLEANUP_HOOK_RAN" == 0 ]]; then
        PRECOMMIT_CLEANUP_HOOK_RAN=1
        previous_state_physical=$STATE_ROOT_PHYSICAL
        install_test_hook during_cleanup "$STATE_ROOT" || true
        refresh_journal_locations_after_hook "$previous_state_physical" || true
    fi
    if [[ "$TRANSACTION_ACTIVE" == 1 && "$status" -ne 0 ]]; then
        rollback_transaction || true
    fi
    [[ "$status" -eq 0 ]] || diagnose_report_recovery || true
    TRANSACTION_ACTIVE=0
    close_report_handle || true
    cleanup_transaction_storage
    release_lock || true
    [[ -n "$TRANSACTION_START_DIR" ]] && cd -P -- "$TRANSACTION_START_DIR" 2>/dev/null || true
    exit "$status"
}

start_transaction() {
    reset_transaction_journal || return $?
    TRANSACTION_START_DIR=$(pwd -P) || return 65
    TRANSACTION_ACTIVE=1
    trap transaction_trap EXIT
    trap 'record_transaction_signal 130' INT
    trap 'record_transaction_signal 143' TERM
    pin_planned_install_root || return $?
    pin_state_root || return $?
    [[ "$PLAN_NEEDS_BACKUP" == 0 ]] || preflight_backup_devices || return $?
    honor_pending_signal || return $?
    acquire_lock || return $?
    begin_transaction_storage || return $?
    honor_pending_signal || return $?
}

run_precommit_hook_boundary() {
    local event=$1 honor_after=$2 previous_state_physical hook_status=0 refresh_status=0
    shift 2
    previous_state_physical=$STATE_ROOT_PHYSICAL
    install_test_hook "$event" "$@" || hook_status=$?
    refresh_journal_locations_after_hook "$previous_state_physical" || refresh_status=$?
    if [[ "$honor_after" == 1 ]]; then
        honor_pending_signal || return $?
    fi
    [[ $hook_status -eq 0 ]] || return "$hook_status"
    [[ $refresh_status -eq 0 ]] || return "$refresh_status"
}

run_precommit_boundaries() {
    CLEANUP_ACTIVE=1
    PRECOMMIT_CLEANUP_HOOK_RAN=1
    run_precommit_hook_boundary during_cleanup 1 "$STATE_ROOT" || return $?
    run_precommit_hook_boundary success_cleanup_before_transaction_rmdir 1 "$TRANSACTION_ROOT" || return $?
    run_precommit_hook_boundary last_precommit 1 "$STATE_ROOT" "$TRANSACTION_ROOT" || return $?
    run_precommit_hook_boundary final_verification_started 0 "$STATE_ROOT" "$TRANSACTION_ROOT" || return $?
}

commit_transaction() {
    honor_pending_signal || return $?
    trap '' INT TERM
    honor_pending_signal || return $?
    TRANSACTION_ACTIVE=0
}

finish_transaction() {
    local status=0
    [[ "$TRANSACTION_ACTIVE" == 0 ]] || return 74
    test_unlink_public_report_after_final_verification || status=$?
    if [[ $status -ne 0 ]]; then
        diagnose_report_recovery || true
    fi
    if [[ $status -eq 0 ]]; then
        verify_report_recovery_postcondition || status=$?
    fi
    if [[ $status -ne 0 ]]; then
        diagnose_report_recovery || true
    fi
    close_report_handle || status=$?
    cleanup_success_transaction_storage || status=$?
    release_lock || status=$?
    cd -P -- "$TRANSACTION_START_DIR" || { [[ $status -ne 0 ]] || status=65; }
    trap - EXIT INT TERM
    return "$status"
}

apply_install_plan() {
    local action source target_path relative_path i

    for ((i=0; i<${#PLAN_ACTION[@]}; i++)); do
        action=${PLAN_ACTION[$i]}
        [[ "$action" == CREATE || "$action" == BACKUP ]] || continue
        source=${PLAN_SOURCE[$i]}
        target_path=${PLAN_TARGET[$i]}
        relative_path=${PLAN_PATH[$i]}
        apply_install_entry "$i" "$action" "$source" "$target_path" "$relative_path" || return $?
    done
}

recorded_artifact_matches() (
    local path=$1 expected_parent_physical=$2 expected_parent_identity=$3 expected_identity=$4 expected_fingerprint=$5
    local name
    [[ -n "$path" && -n "$expected_parent_physical" && -n "$expected_parent_identity" && \
        -n "$expected_identity" && -n "$expected_fingerprint" ]] || return 1
    pin_rollback_target_parent "$path" "$path" "$expected_parent_physical" "$expected_parent_identity" 1 || return 1
    name=${path##*/}
    [[ "$(path_identity "$name" 2>/dev/null || true)" == "$expected_identity" ]] || return 1
    [[ "$(path_fingerprint "$name" 2>/dev/null || true)" == "$expected_fingerprint" ]]
)

verify_install_entry_postcondition() (
    local i=$1 action=${PLAN_ACTION[$1]} source=${PLAN_SOURCE[$1]} target_path=${PLAN_TARGET[$1]}
    local relative_path=${PLAN_PATH[$1]} expected_target_identity parent_physical parent_identity target_name
    local backup_path backup_fingerprint backup_identity backup_parent_physical backup_parent_identity
    safe_source "$source" || { printf '%s: source safety proof lost\n' "$PROGRAM" >&2; return 65; }
    [[ "$(path_identity "$source")" == "${PLAN_SOURCE_IDENTITY[$i]}" ]] || {
        printf '%s: source identity changed\n' "$PROGRAM" >&2; return 65;
    }
    [[ "$(path_fingerprint "$source")" == "${PLAN_SOURCE_FINGERPRINT[$i]}" ]] || {
        printf '%s: source fingerprint changed\n' "$PROGRAM" >&2; return 65;
    }

    case "$action" in
        CREATE|BACKUP)
            expected_target_identity=${PLAN_PUBLISHED_IDENTITY[$i]}
            parent_physical=${PLAN_PARENT_PHYSICAL[$i]}
            parent_identity=${PLAN_PARENT_IDENTITY[$i]}
            ;;
        NOOP)
            expected_target_identity=${PLAN_TARGET_IDENTITY[$i]}
            parent_physical=''
            parent_identity=''
            ;;
        *) return 0 ;;
    esac
    [[ -n "$expected_target_identity" ]] || return 65

    if [[ "$action" == BACKUP ]]; then
        state_cwd_matches_pin || { printf '%s: pinned state location is unavailable\n' "$PROGRAM" >&2; return 74; }
        backup_path=${PLAN_BACKUP_PATH[$i]}
        backup_fingerprint=${PLAN_BACKUP_FINGERPRINT[$i]}
        backup_identity=${PLAN_BACKUP_IDENTITY[$i]}
        backup_parent_physical=${PLAN_BACKUP_PARENT_PHYSICAL[$i]}
        backup_parent_identity=${PLAN_BACKUP_PARENT_IDENTITY[$i]}
        recorded_artifact_matches "$backup_path" "$backup_parent_physical" "$backup_parent_identity" \
            "$backup_identity" "$backup_fingerprint" || {
            printf '%s: backup fingerprint changed\n' "$PROGRAM" >&2; return 74;
        }
    fi

    pin_apply_target_parent "$source" "$target_path" "$relative_path" 0 "$parent_physical" "$parent_identity" || {
        printf '%s: publication parent proof lost\n' "$PROGRAM" >&2; return 65;
    }
    target_name=${relative_path##*/}
    [[ -L "$target_name" ]] || { printf '%s: installed target is not a symlink\n' "$PROGRAM" >&2; return 65; }
    [[ "$(run_without_report_fd readlink "$target_name")" == "$source" ]] || {
        printf '%s: installed target points elsewhere\n' "$PROGRAM" >&2; return 65;
    }
    [[ "$(path_identity "$target_name")" == "$expected_target_identity" ]] || {
        printf '%s: installed target identity changed\n' "$PROGRAM" >&2; return 65;
    }
    publication_parent_matches_pin "$target_path" "$parent_physical" "$parent_identity" || return 65
)

verify_install_postconditions() {
    local i action status
    install_root_name_matches_pin && pinned_install_names_match || return 65
    state_cwd_matches_pin || return 74
    for ((i=0; i<${#PLAN_ACTION[@]}; i++)); do
        action=${PLAN_ACTION[$i]}
        case "$action" in CREATE|BACKUP|NOOP) ;; *) continue ;; esac
        verify_install_entry_postcondition "$i"
        status=$?
        if [[ $status -ne 0 ]]; then
            printf '%s: final install postcondition failed for %s\n' "$PROGRAM" "${PLAN_PATH[$i]}" >&2
            return "$status"
        fi
        install_root_name_matches_pin && pinned_install_names_match || return 65
    done
    verify_report_postcondition || return $?
}

command_install() {
    local apply=0 backup=0
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --apply)
                [[ $apply -eq 0 ]] || die 64 'install accepts --apply only once'
                apply=1
                ;;
            --backup)
                [[ $apply -eq 1 && $backup -eq 0 ]] || die 64 'install --backup requires --apply'
                backup=1
                ;;
            --target) die 64 'install does not accept --target' ;;
            --staging-home) die 64 'install does not accept --staging-home' ;;
            *) die 64 "unknown option: $1" ;;
        esac
        shift
    done
    select_transaction_primitives || return $?
    build_install_plan "$backup" || return $?
    [[ $apply -eq 1 ]] || return 0
    start_transaction || return $?
    if [[ "$PLAN_NEEDS_BACKUP" == 1 ]]; then
        begin_backup || return $?
    fi
    apply_install_plan || return $?
    run_precommit_boundaries || return $?
    verify_install_postconditions || return $?
    honor_pending_signal || return $?
    commit_transaction || return $?
    finish_transaction
}

command_check() {
    local host source source_status validator_detail_output validator_status runtime_status
    local i blocked=0 hyprland_runtime_needed=0

    validation_target "$@"
    detect_host >/dev/null
    host=$HOST_PLATFORM
    HYPRLAND_RUNTIME_PROBED=0
    HYPRLAND_RUNTIME_STATUS=125
    HYPRLAND_RUNTIME_DETAIL=''
    VERSION_APP=()
    VERSION_VALUE=()
    parse_manifest "$MANIFEST"

    for ((i=0; i<${#MF_PATH[@]}; i++)); do
        platform_selected "${MF_PLATFORMS[$i]}" "$VALIDATION_TARGET" || continue
        source="$SOURCE_ROOT/${MF_PATH[$i]}"
        observe_installed_version "${MF_APP[$i]}" "$VALIDATION_TARGET" "$host"
        printf 'VERSION %s %s reviewed=%s installed=%s\n' "${MF_APP[$i]}" "${MF_PATH[$i]}" \
            "${MF_TESTED[$i]}" "$OBSERVED_VERSION"
        source_status=$(canonical_source_state "$source")
        case "$source_status:${MF_REQUIRED[$i]}" in
            ABSENT:no)
                printf 'SKIPPED %s %s: optional canonical source is absent; validation unverified\n' "${MF_APP[$i]}" "${MF_PATH[$i]}"
                continue
                ;;
            ABSENT:yes)
                printf 'BLOCKED %s %s: required canonical source is absent\n' "${MF_APP[$i]}" "${MF_PATH[$i]}"
                blocked=1
                continue
                ;;
            UNSAFE:*)
                printf 'BLOCKED %s %s: canonical source is unsafe\n' "${MF_APP[$i]}" "${MF_PATH[$i]}"
                blocked=1
                continue
                ;;
        esac

        validator_detail_output=$(run_validator "${MF_VALIDATOR[$i]}" "$source" "$VALIDATION_TARGET" 2>&1)
        validator_status=$?
        case "$validator_status" in
            0)
                if [[ "$VALIDATION_TARGET" == "$host" ]]; then
                    printf 'PASS %s %s: syntax validated\n' "${MF_APP[$i]}" "${MF_PATH[$i]}"
                else
                    printf 'STATIC PASS %s %s: syntax validated on %s\n' "${MF_APP[$i]}" "${MF_PATH[$i]}" "$host"
                fi
                ;;
            125)
                printf 'RUNTIME UNVERIFIED %s %s: validator unavailable or intentionally unsafe on %s\n' "${MF_APP[$i]}" "${MF_PATH[$i]}" "$host"
                ;;
            *)
                printf 'BLOCKED %s %s: %s\n' "${MF_APP[$i]}" "${MF_PATH[$i]}" "$(validation_detail "$validator_detail_output" "$validator_status")"
                blocked=1
                continue
                ;;
        esac

        if [[ "${MF_VALIDATOR[$i]}" == hyprland-lua ]]; then
            if [[ "$host" != arch || "$VALIDATION_TARGET" != arch ]]; then
                printf 'RUNTIME UNVERIFIED %s %s: requires an Arch Hyprland session\n' "${MF_APP[$i]}" "${MF_PATH[$i]}"
            else
                printf 'RUNTIME UNVERIFIED %s %s: canonical candidate provenance and freshness are unverified\n' "${MF_APP[$i]}" "${MF_PATH[$i]}"
                hyprland_runtime_needed=1
            fi
        fi
    done

    if [[ $hyprland_runtime_needed -eq 1 ]]; then
        run_hyprland_runtime_validation
        runtime_status=$?
        [[ $runtime_status -eq 0 ]] || blocked=1
    fi

    [[ $blocked -eq 0 ]]
}

main() {
    local command=${1:-help}
    [[ $# -eq 0 ]] || shift
    case "$command" in
        help|-h|--help) usage ;;
        detect) detect_host ;;
        check) command_check "$@" ;;
        diff) command_diff "$@" ;;
        install) command_install "$@" ;;
        *) die 64 "unknown command: $command" ;;
    esac
}

main "$@"
